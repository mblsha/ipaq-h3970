#!/bin/sh
set -eu
pidfile=/tmp/doom.pid
mixfile=/tmp/doom-mix

volume() {
    case "$1" in
        [0-9]|[1-9][0-9]|100) return 0 ;;
        *) return 1 ;;
    esac
}

mix_state() {
    if [ -r "$mixfile" ] && read -r music effects <"$mixfile" && volume "$music" && volume "$effects"; then
        printf 'mix=%d,%d\n' "$music" "$effects"
    else
        printf 'mix=100,100\n'
    fi
}

running() {
    [ -r "$pidfile" ] && read -r pid <"$pidfile" || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$(/bin/busybox readlink "/proc/$pid/exe")" = /doom/doom-fb ]
}

case "${1:-}" in
    start)
        if running; then
            echo "Doom is already running as PID $pid"
            exit 0
        fi
        cd /doom
        case "${2:-${doom_audio:-0}}" in
            0) set -- -nosound ;;
            1|--audio) set -- ;;
            effects|--effects) set -- -nomusic ;;
            music|--music) set -- -nosfx ;;
            *) echo 'Usage: doomctl start [--audio|--effects|--music]' >&2; exit 2 ;;
        esac
        /bin/busybox setsid ./doom-fb -iwad doom1.wad -config /tmp/doom.cfg \
            -extraconfig /tmp/doom-extra.cfg "$@" </dev/null >/dev/ttyS0 2>&1 &
        pid=$!
        printf '%s\n' "$pid" >"$pidfile"
        echo "Started Doom as PID $pid"
        ;;
    stop)
        if running; then
            kill -TERM "$pid"
            for tick in 1 2 3 4 5; do
                running || break
                /bin/busybox sleep 1
            done
            if running; then
                echo "Doom did not exit after SIGTERM" >&2
                exit 1
            fi
        fi
        rm -f "$pidfile"
        echo 'Doom stopped'
        ;;
    status)
        if [ "${2:-}" = --machine ]; then
            if ! running; then
                printf 'doom=stopped audio=off\n'
                exit 0
            fi
            audio=on
            for option in nosound nomusic nosfx; do
                if /bin/busybox grep -aqF -- "-$option" "/proc/$pid/cmdline"; then
                    case "$option" in
                        nosound) audio=off ;;
                        nomusic) audio=effects ;;
                        nosfx) audio=music ;;
                    esac
                    break
                fi
            done
            printf 'doom=running audio=%s\n' "$audio"
            exit 0
        fi
        if running; then
            echo "Doom is running as PID $pid"
        else
            echo 'Doom is stopped'
            exit 1
        fi
        ;;
    mix)
        if [ "$#" -eq 3 ] && volume "$2" && volume "$3"; then
            staging=$(/bin/busybox mktemp /tmp/doom-mix.XXXXXX)
            trap '/bin/busybox rm -f "$staging"' EXIT
            printf '%s %s\n' "$2" "$3" >"$staging"
            /bin/busybox mv -f "$staging" "$mixfile"
        elif [ "$#" -ne 1 ]; then
            echo 'Usage: doomctl mix [MUSIC EFFECTS] (0–100)' >&2
            exit 2
        fi
        mix_state
        ;;
    *)
        echo 'Usage: doomctl start [--audio|--effects|--music] | stop | status [--machine] | mix [MUSIC EFFECTS]' >&2
        exit 2
        ;;
esac
