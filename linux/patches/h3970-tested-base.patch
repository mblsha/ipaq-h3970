diff --git a/drivers/mfd/compaq-asic.c b/drivers/mfd/compaq-asic.c
new file mode 100644
index 0000000000000000000000000000000000000000..6f60a820ea714df5bb8b366288011ff89e2504b2
--- /dev/null
+++ b/drivers/mfd/compaq-asic.c
@@ -0,0 +1,258 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Shared register ownership for Compaq ASIC2 and ASIC3 companion chips. */
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/clk/asic2.h>
+#include <linux/clk-provider.h>
+#include <linux/device.h>
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <linux/io.h>
+#include <linux/mfd/compaq-asic.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/sizes.h>
+
+#define ASIC_REGISTER_MAX	0x1ffc
+#define ASIC2_CLOCK_ENABLE	0x1000
+
+struct compaq_asic_data {
+	enum compaq_asic_kind kind;
+	unsigned int val_bits;
+};
+
+struct compaq_asic_priv {
+	struct compaq_asic asic;
+	void __iomem *base;
+};
+
+static const char *compaq_asic_compatible(enum compaq_asic_kind kind)
+{
+	return kind == COMPAQ_ASIC2 ? "compaq,asic2" : "compaq,asic3";
+}
+
+struct compaq_asic *compaq_asic_parent(struct device *dev,
+				       enum compaq_asic_kind kind)
+{
+	struct compaq_asic *asic;
+
+	if (!dev->parent ||
+	    !of_device_is_compatible(dev->parent->of_node,
+				     compaq_asic_compatible(kind)))
+		return ERR_PTR(-ENODEV);
+	asic = dev_get_drvdata(dev->parent);
+	if (!asic)
+		return ERR_PTR(-EPROBE_DEFER);
+	return asic->kind == kind ? asic : ERR_PTR(-EINVAL);
+}
+EXPORT_SYMBOL_GPL(compaq_asic_parent);
+
+struct compaq_asic *devm_compaq_asic_get(struct device *dev,
+					 const char *property,
+					 enum compaq_asic_kind kind)
+{
+	struct platform_device *provider;
+	struct device_node *node;
+	struct compaq_asic *asic;
+
+	node = of_parse_phandle(dev->of_node, property, 0);
+	if (!node)
+		return ERR_PTR(-ENOENT);
+	if (!of_device_is_compatible(node, compaq_asic_compatible(kind))) {
+		of_node_put(node);
+		return ERR_PTR(-EINVAL);
+	}
+	provider = of_find_device_by_node(node);
+	of_node_put(node);
+	if (!provider)
+		return ERR_PTR(-EPROBE_DEFER);
+	if (!device_is_bound(&provider->dev)) {
+		asic = ERR_PTR(-EPROBE_DEFER);
+		goto put;
+	}
+	asic = platform_get_drvdata(provider);
+	if (!asic || asic->kind != kind) {
+		asic = ERR_PTR(-EINVAL);
+		goto put;
+	}
+	if (!device_link_add(dev, &provider->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		asic = ERR_PTR(-EINVAL);
+put:
+	put_device(&provider->dev);
+	return asic;
+}
+EXPORT_SYMBOL_GPL(devm_compaq_asic_get);
+
+static int compaq_asic_read(void *context, unsigned int reg, unsigned int *value)
+{
+	struct compaq_asic_priv *priv = context;
+	void __iomem *address = priv->base + (reg >> priv->asic.reg_shift);
+
+	*value = priv->asic.kind == COMPAQ_ASIC2 ? readl(address) : readw(address);
+	return 0;
+}
+
+static int compaq_asic_write(void *context, unsigned int reg, unsigned int value)
+{
+	struct compaq_asic_priv *priv = context;
+	void __iomem *address = priv->base + (reg >> priv->asic.reg_shift);
+
+	if (priv->asic.kind == COMPAQ_ASIC2)
+		writel(value, address);
+	else
+		writew(value, address);
+	return 0;
+}
+
+static const struct regmap_bus compaq_asic_bus = {
+	.fast_io = true,
+	.reg_read = compaq_asic_read,
+	.reg_write = compaq_asic_write,
+};
+
+#define ASIC2_ADC_MUX		0x0
+#define ASIC2_ADC_CONTROL	0x4
+#define ASIC2_ADC_DATA		0x8
+#define ASIC2_ADC_MUX_CLOCK	BIT(3)
+#define ASIC2_ADC_START		BIT(6)
+#define ASIC2_ADC_ENABLE	BIT(7)
+#define ASIC2_ADC_PRESCALE	4
+
+int compaq_asic2_adc_read_locked(struct compaq_asic2_adc *adc, unsigned int channel)
+{
+	unsigned int control, value;
+	int i, ret;
+
+	lockdep_assert_held(&adc->lock);
+	if (channel > 4)
+		return -EINVAL;
+	ret = regmap_write(adc->map, adc->base + ASIC2_ADC_MUX, channel | ASIC2_ADC_MUX_CLOCK);
+	if (ret)
+		return ret;
+	/* Keep the established settle time and polling sequence unchanged. */
+	udelay(200);
+	/* Preserve the established four conversions, using the final result. */
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(adc->map, adc->base + ASIC2_ADC_CONTROL,
+				   ASIC2_ADC_ENABLE | ASIC2_ADC_PRESCALE);
+		if (ret)
+			return ret;
+		ret = regmap_write(adc->map, adc->base + ASIC2_ADC_CONTROL,
+				   ASIC2_ADC_ENABLE | ASIC2_ADC_PRESCALE | ASIC2_ADC_START);
+		if (ret)
+			return ret;
+		ret = regmap_read_poll_timeout_atomic(adc->map, adc->base + ASIC2_ADC_CONTROL,
+						      control, !(control & ASIC2_ADC_START),
+						      5, 2000);
+		if (ret)
+			return ret;
+	}
+	ret = regmap_read(adc->map, adc->base + ASIC2_ADC_DATA, &value);
+	return ret ?: (value & 0x3ff);
+}
+EXPORT_SYMBOL_GPL(compaq_asic2_adc_read_locked);
+
+int compaq_asic2_adc_stop_locked(struct compaq_asic2_adc *adc)
+{
+	int control_ret, mux_ret;
+
+	lockdep_assert_held(&adc->lock);
+	/* Attempt both even when the first write fails. */
+	control_ret = regmap_write(adc->map, adc->base + ASIC2_ADC_CONTROL, 0);
+	mux_ret = regmap_write(adc->map, adc->base + ASIC2_ADC_MUX, 0);
+	return control_ret ?: mux_ret;
+}
+EXPORT_SYMBOL_GPL(compaq_asic2_adc_stop_locked);
+
+static int compaq_asic_probe(struct platform_device *pdev)
+{
+	const struct compaq_asic_data *data = device_get_match_data(&pdev->dev);
+	const struct regmap_config config = {
+		.reg_bits = 32,
+		.val_bits = data->val_bits,
+		.reg_stride = 4,
+		.max_register = ASIC_REGISTER_MAX,
+	};
+	struct device *dev = &pdev->dev;
+	struct clk_hw_onecell_data *clocks;
+	struct compaq_asic_priv *priv;
+	struct resource *resource;
+	struct clk *osc, *osc32k;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	resource = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!resource)
+		return -EINVAL;
+	if (resource_size(resource) != SZ_8K &&
+	    (data->kind != COMPAQ_ASIC3 || resource_size(resource) != SZ_4K))
+		return dev_err_probe(dev, -EINVAL, "invalid companion register window\n");
+	priv->base = devm_ioremap_resource(dev, resource);
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+	priv->asic.kind = data->kind;
+	/* ASIC3's 16-bit-addressed mapping halves the canonical offsets. */
+	priv->asic.reg_shift = resource_size(resource) == SZ_4K;
+	mutex_init(&priv->asic.adc.lock);
+	priv->asic.map = devm_regmap_init(dev, &compaq_asic_bus, priv, &config);
+	if (IS_ERR(priv->asic.map))
+		return PTR_ERR(priv->asic.map);
+	priv->asic.adc.map = priv->asic.map;
+	priv->asic.adc.base = 0x1200;
+	platform_set_drvdata(pdev, &priv->asic);
+
+	if (data->kind == COMPAQ_ASIC2) {
+		osc = devm_clk_get(dev, "osc");
+		if (IS_ERR(osc))
+			return dev_err_probe(dev, PTR_ERR(osc), "oscillator clock\n");
+		osc32k = devm_clk_get_optional(dev, "osc32k");
+		if (IS_ERR(osc32k))
+			return dev_err_probe(dev, PTR_ERR(osc32k), "32 kHz oscillator clock\n");
+		clocks = devm_asic2_clk_register(dev, priv->asic.map,
+						 ASIC2_CLOCK_ENABLE, __clk_get_hw(osc),
+						 __clk_get_hw(osc32k), NULL);
+		if (IS_ERR(clocks))
+			return PTR_ERR(clocks);
+		ret = devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, clocks);
+		if (ret)
+			return ret;
+	}
+
+	/* Do not reset the ASIC or rewrite inherited GPIO, power or IRQ state. */
+	return devm_of_platform_populate(dev);
+}
+
+static const struct compaq_asic_data asic2_data = {
+	.kind = COMPAQ_ASIC2,
+	.val_bits = 32,
+};
+
+static const struct compaq_asic_data asic3_data = {
+	.kind = COMPAQ_ASIC3,
+	.val_bits = 16,
+};
+
+static const struct of_device_id compaq_asic_match[] = {
+	{ .compatible = "compaq,asic2", .data = &asic2_data },
+	{ .compatible = "compaq,asic3", .data = &asic3_data },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, compaq_asic_match);
+
+static struct platform_driver compaq_asic_driver = {
+	.probe = compaq_asic_probe,
+	.driver = {
+		.name = "compaq-asic",
+		.of_match_table = compaq_asic_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(compaq_asic_driver);
+
+MODULE_DESCRIPTION("Compaq ASIC2 and ASIC3 register ownership");
+MODULE_LICENSE("GPL");
