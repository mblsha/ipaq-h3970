@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/compaq,asic2-touchscreen.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Compaq ASIC2 resistive touchscreen
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  The touchscreen uses ASIC2 GPIO drive lines and ADC channels. New descriptions
+  place the function below the ASIC2 parent, which owns both register regions
+  and arbitrates complete sampling transactions. The legacy standalone form
+  exposes separate GPIO and ADC resources.
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - if:
+      properties:
+        compatible:
+          const: compaq,h3970-asic2-touchscreen
+    then:
+      required:
+        - reg
+        - reg-names
+    else:
+      properties:
+        reg: false
+        reg-names: false
+
+properties:
+  compatible:
+    oneOf:
+      - const: compaq,asic2-touchscreen
+      - const: compaq,h3970-asic2-touchscreen
+        deprecated: true
+
+  reg:
+    items:
+      - description: ASIC2 GPIO registers
+      - description: ASIC2 ADC registers
+
+  reg-names:
+    items:
+      - const: gpio
+      - const: adc
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: adc
+
+  io-channels:
+    items:
+      - description: X-axis input on this companion's ADC
+      - description: Y-axis input on the same ADC
+
+  io-channel-names:
+    items:
+      - const: x
+      - const: y
+
+  pen-gpios:
+    maxItems: 1
+    description: Pen-detect input; active while the panel is pressed.
+
+  interrupts:
+    maxItems: 1
+    description: Pen-detect interrupt from the same input as pen-gpios.
+
+  interrupt-names:
+    const: pen
+
+  touchscreen-min-x: true
+  touchscreen-min-y: true
+  touchscreen-size-x: true
+  touchscreen-size-y: true
+  touchscreen-fuzz-x: true
+  touchscreen-fuzz-y: true
+  touchscreen-inverted-x: true
+  touchscreen-inverted-y: true
+  touchscreen-swapped-x-y: true
+
+dependencies:
+  io-channels: [io-channel-names]
+  io-channel-names: [io-channels]
+  interrupts: [pen-gpios]
+  interrupts-extended: [pen-gpios]
+  interrupt-names:
+    anyOf:
+      - required: [interrupts]
+      - required: [interrupts-extended]
+
+required:
+  - compatible
+  - clocks
+  - clock-names
+
+unevaluatedProperties: false
diff --git a/Documentation/devicetree/bindings/interrupt-controller/marvell,pxa-intc.yaml b/Documentation/devicetree/bindings/interrupt-controller/marvell,pxa-intc.yaml
