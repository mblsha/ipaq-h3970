+
+static void h3970_touch_test_close_handle(void *data)
+{
+	struct input_handle *handle = data;
+
+	if (handle->open)
+		input_close_device(handle);
+	input_unregister_handle(handle);
+}
+
+static void h3970_touch_test_event(struct input_handle *handle,
+				   unsigned int type, unsigned int code, int value)
+{
+}
+
+static struct input_handle *h3970_touch_test_open(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+	struct input_handler *handler = kunit_kzalloc(test, sizeof(*handler), GFP_KERNEL);
+	struct input_handle *handle = kunit_kzalloc(test, sizeof(*handle), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, handle);
+	KUNIT_ASSERT_NOT_NULL(test, handler);
+	INIT_LIST_HEAD(&handler->h_list);
+	handler->event = h3970_touch_test_event;
+	handle->dev = ctx->input;
+	handle->handler = handler;
+	KUNIT_ASSERT_EQ(test, input_register_handle(handle), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+		h3970_touch_test_close_handle, handle), 0);
+	KUNIT_ASSERT_EQ(test, input_open_device(handle), 0);
+	return handle;
+}
+
+static void h3970_touch_irq_open_close(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+	struct input_handle *handle;
+
+	KUNIT_EXPECT_FALSE(test, ctx->touch.irq_enabled);
+	KUNIT_EXPECT_EQ(test, ctx->irq_regs[0x1c / 4] & PEN_UP, 0U);
+	ctx->gpio |= PEN_UP;
+	handle = h3970_touch_test_open(test);
+	KUNIT_EXPECT_TRUE(test, ctx->touch.opened);
+	KUNIT_EXPECT_TRUE(test, ctx->touch.irq_enabled);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 0U);
+	input_close_device(handle);
+	KUNIT_EXPECT_FALSE(test, ctx->touch.opened);
+	KUNIT_EXPECT_FALSE(test, ctx->touch.irq_enabled);
+	KUNIT_EXPECT_EQ(test, ctx->irq_regs[0x1c / 4] & PEN_UP, 0U);
+	ctx->gpio &= ~PEN_UP;
+	h3970_touch_test_raise(ctx, true);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 0U);
+	KUNIT_ASSERT_EQ(test, input_open_device(handle), 0);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 8U);
+	KUNIT_EXPECT_TRUE(test, test_bit(BTN_TOUCH, ctx->input->key));
+}
+
+static void h3970_touch_irq_press_release(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+
+	ctx->gpio |= PEN_UP;
+	h3970_touch_test_open(test);
+	ctx->gpio &= ~PEN_UP;
+	h3970_touch_test_raise(ctx, true);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 8U);
+	KUNIT_EXPECT_TRUE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	KUNIT_EXPECT_FALSE(test, ctx->touch.irq_enabled);
+	h3970_touch_test_raise(ctx, true);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 8U);
+	ctx->gpio |= PEN_UP;
+	h3970_touch_poll(ctx->input);
+	KUNIT_EXPECT_FALSE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	KUNIT_EXPECT_TRUE(test, ctx->touch.irq_enabled);
+	ctx->gpio &= ~PEN_UP;
+	h3970_touch_test_raise(ctx, true);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 16U);
+}
+
+static void h3970_touch_irq_poll_race(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+
+	ctx->gpio |= PEN_UP;
+	h3970_touch_test_open(test);
+	mutex_lock(&ctx->adc.lock);
+	ctx->gpio &= ~PEN_UP;
+	h3970_touch_test_raise(ctx, false);
+	/* Poll wins the lock while the already queued IRQ thread waits. */
+	h3970_touch_sample_locked(ctx->input);
+	mutex_unlock(&ctx->adc.lock);
+	synchronize_irq(ctx->touch.irq);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 8U);
+	KUNIT_EXPECT_TRUE(test, test_bit(BTN_TOUCH, ctx->input->key));
+}
+
+static void h3970_touch_irq_stop_final(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+	struct input_handle *handle;
+	unsigned int count;
+
+	ctx->gpio |= PEN_UP;
+	handle = h3970_touch_test_open(test);
+	h3970_touch_stop(&ctx->touch);
+	KUNIT_EXPECT_TRUE(test, ctx->touch.stopped);
+	KUNIT_EXPECT_FALSE(test, ctx->touch.irq_enabled);
+	count = ctx->count;
+	ctx->gpio &= ~PEN_UP;
+	h3970_touch_test_raise(ctx, true);
+	h3970_touch_poll(ctx->input);
+	KUNIT_EXPECT_EQ(test, ctx->count, count);
+	input_close_device(handle);
+	KUNIT_EXPECT_EQ(test, input_open_device(handle), -ENODEV);
+}
+
+static void h3970_touch_pen_ownership(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+	struct gpio_desc *other;
+
+	other = gpiochip_request_own_desc(ctx->chip, 5, "competitor", GPIO_ACTIVE_HIGH, GPIOD_OUT_LOW);
+	KUNIT_EXPECT_TRUE(test, IS_ERR(other));
+	if (!IS_ERR(other))
+		gpiochip_free_own_desc(other);
+	else
+		KUNIT_EXPECT_EQ(test, PTR_ERR(other), -EBUSY);
+}
+
+static void h3970_touch_pen_read_error(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+
+	ctx->gpio |= PEN_UP;
+	h3970_touch_test_open(test);
+	ctx->fail_gpio = true;
+	h3970_touch_test_raise(ctx, true);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 0U);
+	KUNIT_EXPECT_FALSE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	ctx->fail_gpio = false;
+	ctx->gpio &= ~PEN_UP;
+	h3970_touch_test_raise(ctx, true);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 8U);
+}
+
+static void h3970_touch_poll_disabled(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+
+	ctx->gpio |= PEN_UP;
+	h3970_touch_test_open(test);
+	input_set_poll_interval(ctx->input, 0);
+	ctx->gpio &= ~PEN_UP;
+	h3970_touch_test_raise(ctx, true);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 0U);
+	KUNIT_EXPECT_FALSE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	input_set_poll_interval(ctx->input, 60000);
+	h3970_touch_test_raise(ctx, true);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 8U);
+}
+
+static void h3970_touch_irq_adc_recovery(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+
+	ctx->gpio |= PEN_UP;
+	h3970_touch_test_open(test);
+	ctx->fail_data = true;
+	ctx->gpio &= ~PEN_UP;
+	h3970_touch_test_raise(ctx, true);
+	KUNIT_EXPECT_FALSE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	KUNIT_EXPECT_FALSE(test, ctx->touch.irq_enabled);
+	KUNIT_EXPECT_EQ(test, ctx->gpio & DRIVE_MASK, (unsigned int)DRIVE_PEN);
+	ctx->fail_data = false;
+	h3970_touch_poll(ctx->input);
+	KUNIT_EXPECT_TRUE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	ctx->gpio |= PEN_UP;
+	h3970_touch_poll(ctx->input);
+	KUNIT_EXPECT_FALSE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	KUNIT_EXPECT_TRUE(test, ctx->touch.irq_enabled);
+}
+
+static void h3970_touch_bad_resources(struct kunit *test, bool missing)
+{
+	struct h3970_touch_test *ctx = test->priv;
+	struct h3970_touch other = {};
+	struct resource resource = {
+		.start = ctx->touch.irq, .end = ctx->touch.irq, .flags = IORESOURCE_IRQ,
+	};
+	struct platform_device *pdev;
+	struct gpiod_lookup_table *lookup;
+	unsigned int direction = ctx->irq_regs[0];
+
+	pdev = platform_device_register_simple("touch-resource-test", -1, &resource, 1);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, pdev);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+		h3970_touch_test_consumer_unregister, pdev), 0);
+	lookup = kunit_kzalloc(test, struct_size(lookup, table, 2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, lookup);
+	lookup->dev_id = dev_name(&pdev->dev);
+	lookup->table[0] = (struct gpiod_lookup)GPIO_LOOKUP(
+		missing ? "touch-missing-gpio" : "h3970-touch-test-gpio",
+		6, "pen", GPIO_ACTIVE_LOW);
+	gpiod_add_lookup_table(lookup);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+		h3970_touch_test_remove_lookup, lookup), 0);
+	KUNIT_EXPECT_EQ(test, h3970_touch_get_resources(pdev, &other),
+			missing ? -EPROBE_DEFER : -EINVAL);
+	KUNIT_EXPECT_EQ(test, ctx->irq_regs[0], direction);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 0U);
+}
+
+static void h3970_touch_resource_mismatch(struct kunit *test)
+{
+	h3970_touch_bad_resources(test, false);
+}
+
+static void h3970_touch_resource_defer(struct kunit *test)
+{
+	h3970_touch_bad_resources(test, true);
+}
