+/* Resolve actual IIO consumer references, including cross-companion rejection. */
+static void asic2_touch_channel_device_remove(void *pdev)
+{
+	platform_device_unregister(pdev);
+}
+
+static void asic2_touch_channel_node_remove(void *node)
+{
