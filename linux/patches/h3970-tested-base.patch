new file mode 100644
index 0000000000000000000000000000000000000000..2ee361b85827494a5e0bfe5fbb899a98bda44f9f
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/compaq,asic2-keys.yaml
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/compaq,asic2-keys.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Compaq ASIC2 KPIO keys
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  The ASIC2 key-input block combines independent lines and an encoded five-way
+  input on KPIO bits 1 through 5. Place this function below its ASIC2 parent.
+  Each key matches a mask and value of the raw KPIO data register. The masks
+  may overlap to decode mutually exclusive five-way states. Key codes and
+  identical mask/value pairs must be unique. An optional independent GPIO
+  power button shares the logical input device and reports KEY_POWER.
+
+properties:
+  compatible:
+    const: compaq,asic2-keys
+
+  label: true
+
+  poll-interval:
+    $ref: input.yaml#/properties/poll-interval
+    minimum: 1
+    maximum: 1000
+    default: 10
+    description: Two identical consecutive samples are required before reporting.
+
+  power-button-gpios:
+    maxItems: 1
+    description: Independent power input, with its electrical polarity.
+
+patternProperties:
+  "^button-[a-z0-9-]+$":
+    type: object
+    additionalProperties: false
+    properties:
+      linux,code:
+        $ref: input.yaml#/properties/linux,code
+        minimum: 1
+
+      compaq,kpio-mask:
+        $ref: /schemas/types.yaml#/definitions/uint32
+        minimum: 1
+        maximum: 0xfff
+        description: KPIO data bits participating in this key's match.
+
+      compaq,kpio-value:
+        $ref: /schemas/types.yaml#/definitions/uint32
+        maximum: 0xfff
+        description: Raw pressed-state value; bits outside the mask must be zero.
+
+    required:
+      - linux,code
+      - compaq,kpio-mask
+      - compaq,kpio-value
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/input/input.h>
+    keypad {
+        compatible = "compaq,asic2-keys";
+        poll-interval = <10>;
+
+        button-up {
+            linux,code = <KEY_UP>;
+            compaq,kpio-mask = <0x3e>;
+            compaq,kpio-value = <0x0c>;
+        };
+    };
