diff --git a/drivers/mmc/host/tmio_mmc_core-test.c b/drivers/mmc/host/tmio_mmc_core-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..e681fbff2a5c33b131e4631edbd6478abc88f6b1
--- /dev/null
+++ b/drivers/mmc/host/tmio_mmc_core-test.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <kunit/device.h>
+#include <kunit/test.h>
+#include <linux/property.h>
+
+struct tmio_caps_param {
+	const char *desc;
+	unsigned int width;
+	bool firmware;
+	unsigned long pdata_caps, expected_width;
+	int parse_error;
+};
+
+static const struct tmio_caps_param tmio_caps_params[] = {
+	{ "legacy-default", 0, false, 0, MMC_CAP_4_BIT_DATA },
+	{ "firmware-default", 0, true, 0, MMC_CAP_4_BIT_DATA },
+	{ "one-wire", 1, true, MMC_CAP_4_BIT_DATA | MMC_CAP_8_BIT_DATA, 0 },
+	{ "four-wire", 4, true, MMC_CAP_8_BIT_DATA, MMC_CAP_4_BIT_DATA },
+	{ "eight-wire", 8, true, 0, MMC_CAP_4_BIT_DATA | MMC_CAP_8_BIT_DATA },
+	{ "invalid-width", 2, true, 0, 0, -EINVAL },
+};
+
+KUNIT_ARRAY_PARAM_DESC(tmio_caps, tmio_caps_params, desc);
+
+static void tmio_explicit_bus_width(struct kunit *test)
+{
+	const struct tmio_caps_param *param = test->param_value;
+	const struct property_entry props[] = {
+		PROPERTY_ENTRY_U32("bus-width", param->width),
+		{}
+	};
+	const struct property_entry no_width[] = {
+		PROPERTY_ENTRY_BOOL("non-removable"),
+		{}
+	};
+	struct tmio_mmc_data pdata = {
+		.capabilities = param->pdata_caps | MMC_CAP_SD_HIGHSPEED,
+		.capabilities2 = MMC_CAP2_NO_SDIO,
+	};
+	struct tmio_mmc_host *host;
+	struct mmc_host *mmc;
+	struct device *dev;
+	int ret;
+
+	dev = kunit_device_register(test, "tmio-caps-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	if (param->firmware) {
+		ret = device_create_managed_software_node(dev,
+							  param->width ? props : no_width, NULL);
+		KUNIT_ASSERT_EQ(test, ret, 0);
+	}
+	mmc = devm_mmc_alloc_host(dev, sizeof(*host));
+	KUNIT_ASSERT_NOT_NULL(test, mmc);
+	host = mmc_priv(mmc);
+	host->mmc = mmc;
+	host->pdata = &pdata;
+	ret = mmc_of_parse(mmc);
+	KUNIT_ASSERT_EQ(test, ret, param->parse_error);
+	if (ret)
+		return;
+	tmio_mmc_configure_capabilities(host);
+	KUNIT_EXPECT_EQ(test, mmc->caps & (MMC_CAP_4_BIT_DATA | MMC_CAP_8_BIT_DATA),
+			param->expected_width);
+	KUNIT_EXPECT_TRUE(test, mmc->caps & MMC_CAP_SD_HIGHSPEED);
+	KUNIT_EXPECT_TRUE(test, mmc->caps2 & MMC_CAP2_NO_SDIO);
+}
+
+static struct kunit_case tmio_caps_test_cases[] = {
+	KUNIT_CASE_PARAM(tmio_explicit_bus_width, tmio_caps_gen_params),
+	{}
+};
+
+static struct kunit_suite tmio_caps_test_suite = {
+	.name = "tmio-firmware-capabilities",
+	.test_cases = tmio_caps_test_cases,
+};
+
+kunit_test_suite(tmio_caps_test_suite);
