+static void uda1380_offline_controls_and_shutdown(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+	struct snd_soc_dai dai = { .component = &ctx->component };
+	struct snd_pcm_substream substream = { .stream = SNDRV_PCM_STREAM_PLAYBACK };
+	unsigned int transfers;
+
+	uda_test_start(test);
+	transfers = ctx->transfers;
+	KUNIT_ASSERT_EQ(test, uda1380_write(&ctx->component, UDA1380_AMIX, 0x1212), 0);
+	KUNIT_ASSERT_EQ(test, uda1380_write(&ctx->component, UDA1380_MVOL, 0x1818), 0);
+	KUNIT_EXPECT_EQ(test, ctx->transfers, transfers);
+	KUNIT_EXPECT_TRUE(test, ctx->priv.cache_only);
+	KUNIT_ASSERT_EQ(test, uda1380_set_bias_level(&ctx->component, SND_SOC_BIAS_STANDBY), 0);
+	KUNIT_EXPECT_EQ(test, ctx->registers[UDA1380_AMIX], (u16)0x1212);
+	KUNIT_EXPECT_TRUE(test, test_bit(0, &ctx->priv.cache_dirty));
+	ctx->component.active = 1;
+	uda1380_flush_work(&ctx->priv.work);
+	KUNIT_EXPECT_EQ(test, ctx->registers[UDA1380_MVOL], (u16)0x1818);
+	KUNIT_EXPECT_EQ(test, ctx->priv.cache_dirty, 0UL);
+	KUNIT_ASSERT_EQ(test, uda1380_set_bias_level(&ctx->component, SND_SOC_BIAS_OFF), 0);
+	transfers = ctx->transfers;
+	uda1380_pcm_shutdown(&substream, &dai);
+	KUNIT_EXPECT_EQ(test, ctx->transfers, transfers);
+	KUNIT_EXPECT_EQ(test, ctx->unclocked_io, 0U);
+}
+
+static void uda_test_held_flush(struct work_struct *work)
+{
+	struct uda1380_priv *priv = container_of(work, struct uda1380_priv, work);
+	struct uda1380_test *ctx = container_of(priv, struct uda1380_test, priv);
+
+	complete(&ctx->flush_entered);
+	wait_for_completion(&ctx->flush_release);
+	uda1380_flush_work(work);
+}
+
+static int uda_test_shutdown_thread(void *data)
+{
+	struct uda1380_test *ctx = data;
+	struct snd_soc_dai dai = { .component = &ctx->component };
+	struct snd_pcm_substream stream = { .stream = SNDRV_PCM_STREAM_PLAYBACK };
+
+	complete(&ctx->shutdown_entered);
+	if (ctx->test_dac_power_down) {
+		struct snd_soc_dapm_widget widget = {
+			.dapm = snd_soc_component_get_dapm(&ctx->component),
+		};
+
+		widget.dapm->component = &ctx->component;
+		uda1380_dac_event(&widget, NULL, SND_SOC_DAPM_PRE_PMD);
+		uda1380_write(&ctx->component, UDA1380_PM, 0);
+	} else {
+		uda1380_pcm_shutdown(&stream, &dai);
+	}
+	complete(&ctx->shutdown_done);
+	return 0;
+}
+
+static void uda_test_joins_running_flush(struct kunit *test, bool dac_power_down)
+{
+	struct uda1380_test *ctx = test->priv;
+	struct task_struct *task;
+	unsigned long entered, done;
+
+	uda_test_powered(test);
+	ctx->test_dac_power_down = dac_power_down;
+	ctx->component.active = 1;
+	KUNIT_ASSERT_EQ(test, uda1380_write(&ctx->component, UDA1380_PM,
+					 R02_PON_PLL | R02_PON_DAC), 0);
+	uda1380_write_reg_cache(&ctx->component, UDA1380_MIXER, R14_SILENCE);
+	ctx->watch_wspll = true;
+	init_completion(&ctx->flush_entered);
+	init_completion(&ctx->flush_release);
+	init_completion(&ctx->shutdown_entered);
+	init_completion(&ctx->shutdown_done);
+	INIT_WORK(&ctx->priv.work, uda_test_held_flush);
+	schedule_work(&ctx->priv.work);
+	entered = wait_for_completion_timeout(&ctx->flush_entered, HZ);
+	if (!entered) {
+		complete(&ctx->flush_release);
+		flush_work(&ctx->priv.work);
+		KUNIT_FAIL(test, "mixer worker did not start");
+		return;
+	}
+	task = kthread_create(uda_test_shutdown_thread, ctx, "uda-shutdown-test");
+	if (IS_ERR(task)) {
+		complete(&ctx->flush_release);
+		flush_work(&ctx->priv.work);
+		KUNIT_FAIL(test, "shutdown thread could not start");
+		return;
+	}
+	get_task_struct(task);
+	wake_up_process(task);
+	entered = wait_for_completion_timeout(&ctx->shutdown_entered, HZ);
+	KUNIT_EXPECT_NE(test, entered, 0UL);
+	done = wait_for_completion_timeout(&ctx->shutdown_done, msecs_to_jiffies(20));
+	KUNIT_EXPECT_EQ(test, done, 0UL);
+	KUNIT_EXPECT_TRUE(test, ctx->registers[UDA1380_PM] & R02_PON_PLL);
+	complete(&ctx->flush_release);
+	kthread_stop(task);
+	put_task_struct(task);
+	flush_work(&ctx->priv.work);
+	KUNIT_EXPECT_FALSE(test, work_busy(&ctx->priv.work));
+	KUNIT_EXPECT_TRUE(test, completion_done(&ctx->shutdown_done));
+	KUNIT_EXPECT_EQ(test, ctx->dsp_io_after_wspll_stop, 0U);
+	KUNIT_EXPECT_FALSE(test, ctx->registers[UDA1380_PM] & R02_PON_PLL);
+}
+
+static void uda1380_shutdown_joins_running_flush(struct kunit *test)
+{
+	uda_test_joins_running_flush(test, false);
+}
+
+static void uda1380_dac_power_down_joins_running_flush(struct kunit *test)
+{
+	uda_test_joins_running_flush(test, true);
+}
