@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/marvell,pxa-intc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Marvell PXA internal interrupt controller
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  The PXA internal interrupt controller routes SoC peripheral interrupts to
+  the XScale CPU. Interrupt numbers are hardware indices without the legacy
+  Linux IRQ offset. PXA27x and later controllers support priority registers.
+
+properties:
+  compatible:
+    const: marvell,pxa-intc
+
+  reg:
+    maxItems: 1
+
+  '#interrupt-cells':
+    const: 1
+
+  '#address-cells':
+    const: 0
+
+  interrupt-controller: true
+
+  interrupt-parent: true
+
+  marvell,intc-nr-irqs:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    maximum: 128
+    description: Number of implemented internal interrupt inputs.
+
+  marvell,intc-priority:
+    type: boolean
+    description: The controller implements interrupt priority registers.
+
+required:
+  - compatible
+  - reg
+  - '#interrupt-cells'
+  - interrupt-controller
+  - marvell,intc-nr-irqs
+
+additionalProperties: false
+
+examples:
+  - |
+    interrupt-controller@40d00000 {
+        compatible = "marvell,pxa-intc";
+        reg = <0x40d00000 0xd0>;
+        #interrupt-cells = <1>;
+        #address-cells = <0>;
+        interrupt-controller;
+        marvell,intc-nr-irqs = <32>;
+    };
