diff --git a/drivers/input/touchscreen/h3970-touch-test.c b/drivers/input/touchscreen/h3970-touch-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..e59d5b972c497da8b0c5b334a82cf48b12aa8941
--- /dev/null
+++ b/drivers/input/touchscreen/h3970-touch-test.c
@@ -0,0 +1,781 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exercise the real poll function over parent and legacy fake register maps. */
+#include <kunit/test.h>
+#include <kunit/device.h>
+#include <linux/gpio/driver.h>
+#include <linux/gpio/machine.h>
+#include <linux/gpio/regmap.h>
+#include <linux/irqchip/asic2.h>
+#include <linux/irq_sim.h>
+#include <linux/irq_work.h>
+
+struct h3970_touch_test;
+struct h3970_touch_test_map {
+	struct h3970_touch_test *ctx;
+	bool gpio;
+};
+
+struct h3970_touch_test {
+	struct h3970_touch touch;
+	struct compaq_asic2_adc adc;
+	struct input_dev *input;
+	struct h3970_touch_test_map gpio_map, adc_map;
+	unsigned int gpio, mux, control, conversions, data_reads;
+	struct { bool gpio; unsigned int reg, value; } writes[64];
+	unsigned int count, fail_at;
+	bool fail_data, lift_after_data, fail_gpio;
+	unsigned int irq_regs[0x220 / 4];
+	struct irq_domain *domain;
+	struct gpio_chip *chip;
+	struct platform_device *consumer;
+	struct irq_work raise;
+	unsigned int parent_irq;
+};
+
+static int h3970_touch_test_read(void *data, unsigned int reg, unsigned int *value)
+{
+	struct h3970_touch_test_map *map = data;
+	struct h3970_touch_test *ctx = map->ctx;
+
+	if (map->gpio && reg == GPIO_DATA) {
+		if (ctx->fail_gpio)
+			return -EIO;
+		*value = ctx->gpio;
+		return 0;
+	}
+	if (map->gpio && reg < sizeof(ctx->irq_regs)) {
+		*value = ctx->irq_regs[reg / 4];
+		return 0;
+	}
+	if (reg == ctx->adc.base + 4) {
+		ctx->control &= ~BIT(6);
+		*value = ctx->control;
+		return 0;
+	}
+	if (reg == ctx->adc.base + 8) {
+		ctx->data_reads++;
+		if (ctx->fail_data)
+			return -EIO;
+		*value = ctx->mux == 11 ? 0x8080 : 0x8300;
+		if (ctx->lift_after_data && ctx->data_reads == 2)
+			ctx->gpio |= PEN_UP;
+		return 0;
+	}
+	*value = 0;
+	return 0;
+}
+
+static int h3970_touch_test_write(void *data, unsigned int reg, unsigned int value)
+{
+	struct h3970_touch_test_map *map = data;
+	struct h3970_touch_test *ctx = map->ctx;
+
+	if (ctx->count < ARRAY_SIZE(ctx->writes)) {
+		ctx->writes[ctx->count].gpio = map->gpio && reg == GPIO_DATA;
+		ctx->writes[ctx->count].reg = reg;
+		ctx->writes[ctx->count].value = value;
+	}
+	ctx->count++;
+	if (ctx->fail_at && ctx->count == ctx->fail_at)
+		return -EIO;
+	if (map->gpio && reg == GPIO_DATA) {
+		ctx->gpio = value;
+	} else if (map->gpio && reg < sizeof(ctx->irq_regs)) {
+		if (reg == 0x10 || reg == 0x210)
+			ctx->irq_regs[reg / 4] &= ~value;
+		else
+			ctx->irq_regs[reg / 4] = value;
+	} else if (reg == ctx->adc.base) {
+		ctx->mux = value;
+	} else if (reg == ctx->adc.base + 4) {
+		ctx->control = value;
+		if (value & BIT(6))
+			ctx->conversions++;
+	}
+	return 0;
+}
+
+static const struct regmap_bus h3970_touch_test_bus = {
+	.fast_io = true,
+	.reg_read = h3970_touch_test_read,
+	.reg_write = h3970_touch_test_write,
+};
+
+static void h3970_touch_test_unregister(void *dev)
+{
+	root_device_unregister(dev);
+}
+
+static void h3970_touch_test_unregister_input(void *input)
+{
+	input_unregister_device(input);
+}
+
+struct h3970_touch_test_param {
+	const char *desc;
+	bool legacy;
+	bool descriptor;
+};
+
+static const struct h3970_touch_test_param h3970_touch_test_params[] = {
+	{ "parent", false, false }, { "legacy", true, false },
+	{ "parent-pen-GPIO", false, true },
+};
+
+KUNIT_ARRAY_PARAM_DESC(h3970_touch, h3970_touch_test_params, desc);
+
+static void h3970_touch_test_dispose(void *data)
+{
+	irq_dispose_mapping((unsigned long)data);
+}
+
+static void h3970_touch_test_consumer_unregister(void *data)
+{
+	platform_device_unregister(data);
+}
+
+static void h3970_touch_test_remove_lookup(void *data)
+{
+	gpiod_remove_lookup_table(data);
+}
+
+static void h3970_touch_test_raise_work(struct irq_work *work)
+{
+	struct h3970_touch_test *ctx = container_of(work, struct h3970_touch_test, raise);
+
+	generic_handle_irq(ctx->parent_irq);
+}
+
+static void h3970_touch_test_raise(struct h3970_touch_test *ctx, bool wait)
+{
+	ctx->irq_regs[0x10 / 4] |= PEN_UP;
+	irq_work_queue(&ctx->raise);
+	irq_work_sync(&ctx->raise);
+	if (wait)
+		synchronize_irq(ctx->touch.irq);
+}
+
+static void h3970_touch_test_pen(struct kunit *test, struct h3970_touch_test *ctx,
+				 bool irq)
+{
+	struct gpio_regmap_config config = {
+		.parent = ctx->touch.dev, .regmap = ctx->touch.gpio,
+		.label = "h3970-touch-test-gpio", .ngpio = 16,
+		.reg_dat_base = GPIO_DATA, .reg_set_base = GPIO_DATA,
+		.reg_dir_in_base = GPIO_REGMAP_ADDR(GPIO_DIR),
+	};
+	struct resource resource = { .flags = IORESOURCE_IRQ };
+	struct gpio_device *gdev;
+	struct gpio_regmap *gpio;
+	struct gpiod_lookup_table *lookup;
+	int ret;
+
+	gpio = devm_gpio_regmap_register(ctx->touch.dev, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, gpio);
+	gdev = gpio_device_find_by_label(config.label);
+	KUNIT_ASSERT_NOT_NULL(test, gdev);
+	ctx->chip = gpio_device_get_chip(gdev);
+	gpio_device_put(gdev);
+	if (irq) {
+		ctx->domain = devm_asic2_irq_register(ctx->touch.dev, ctx->touch.gpio,
+						     ctx->chip, ctx->parent_irq, THIS_MODULE);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->domain);
+		resource.start = irq_create_mapping(ctx->domain, 5);
+		resource.end = resource.start;
+		KUNIT_ASSERT_NE(test, resource.start, (resource_size_t)0);
+		KUNIT_ASSERT_EQ(test, irq_set_irq_type(resource.start, IRQ_TYPE_EDGE_FALLING), 0);
+	}
+	ctx->consumer = platform_device_register_simple("h3970-touch-test", -1,
+							irq ? &resource : NULL, irq ? 1 : 0);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->consumer);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+		h3970_touch_test_consumer_unregister, ctx->consumer), 0);
+	lookup = kunit_kzalloc(test, struct_size(lookup, table, 2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, lookup);
+	lookup->dev_id = dev_name(&ctx->consumer->dev);
+	lookup->table[0] = (struct gpiod_lookup)GPIO_LOOKUP(config.label, 5, "pen", GPIO_ACTIVE_LOW);
+	gpiod_add_lookup_table(lookup);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+		h3970_touch_test_remove_lookup, lookup), 0);
+	ret = h3970_touch_get_resources(ctx->consumer, &ctx->touch);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	ctx->touch.dev = &ctx->consumer->dev;
+}
+
+static int h3970_touch_test_init(struct kunit *test)
+{
+	static const struct h3970_touch_test_param default_param = {
+		.desc = "parent-pen-IRQ", .descriptor = true,
+	};
+	const struct h3970_touch_test_param *param = test->param_value ?: &default_param;
+	bool irq = !test->param_value;
+	const struct regmap_config config = {
+		.reg_bits = 32, .val_bits = 32, .reg_stride = 4,
+		.max_register = 0x1ffc,
+	};
+	struct h3970_touch_test *ctx;
+	struct device *dev;
+	int ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	if (irq) {
+		struct device *parent = kunit_device_register(test, "touch-irq-parent");
+		struct irq_domain *domain;
+
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, parent);
+		domain = devm_irq_domain_create_sim(parent, NULL, 1);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, domain);
+		ctx->parent_irq = irq_create_mapping(domain, 0);
+		KUNIT_ASSERT_NE(test, ctx->parent_irq, 0U);
+		KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			h3970_touch_test_dispose, (void *)(unsigned long)ctx->parent_irq), 0);
+		ctx->raise = IRQ_WORK_INIT_HARD(h3970_touch_test_raise_work);
+	}
+	dev = root_device_register("h3970-touch-kunit");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	ret = kunit_add_action_or_reset(test, h3970_touch_test_unregister, dev);
+	if (ret)
+		return ret;
+	ctx->gpio_map.ctx = ctx;
+	ctx->gpio_map.gpio = true;
+	ctx->adc_map.ctx = ctx;
+	ctx->adc.base = param->legacy ? 0 : 0x1200;
+	ctx->touch.gpio = devm_regmap_init(dev, &h3970_touch_test_bus, &ctx->gpio_map, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->touch.gpio);
+	ctx->adc.map = param->legacy ?
+		devm_regmap_init(dev, &h3970_touch_test_bus, &ctx->adc_map, &config) :
+		ctx->touch.gpio;
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->adc.map);
+	mutex_init(&ctx->adc.lock);
+	ctx->touch.adc = &ctx->adc;
+	ctx->touch.x_channel = 3;
+	ctx->touch.y_channel = 4;
+	ctx->touch.dev = dev;
+	ctx->touch.reported_timing = true;
+	ctx->gpio = BIT(12) | DRIVE_PEN;
+	ctx->touch.opened = !irq;
+	if (param->descriptor)
+		h3970_touch_test_pen(test, ctx, irq);
+	ctx->input = input_allocate_device();
+	KUNIT_ASSERT_NOT_NULL(test, ctx->input);
+	ctx->input->dev.parent = ctx->touch.dev;
+	ctx->touch.input = ctx->input;
+	ctx->input->open = h3970_touch_open;
+	ctx->input->close = h3970_touch_close;
+	ctx->input->name = "H3970 touchscreen KUnit";
+	input_set_capability(ctx->input, EV_KEY, BTN_TOUCH);
+	input_set_abs_params(ctx->input, ABS_X, 0, 1023, 2, 0);
+	input_set_abs_params(ctx->input, ABS_Y, 0, 1023, 2, 0);
+	input_set_drvdata(ctx->input, &ctx->touch);
+	touchscreen_parse_properties(ctx->input, false, &ctx->touch.prop);
+	if (irq) {
+		KUNIT_ASSERT_EQ(test, h3970_touch_request_irq(&ctx->touch), 0);
+		KUNIT_ASSERT_EQ(test, input_setup_polling(ctx->input, h3970_touch_poll), 0);
+		input_set_poll_interval(ctx->input, 60000);
+	}
+	ret = input_register_device(ctx->input);
+	if (ret) {
+		input_free_device(ctx->input);
+		return ret;
+	}
+	ret = kunit_add_action_or_reset(test, h3970_touch_test_unregister_input, ctx->input);
+	if (ret)
+		return ret;
+	ret = kunit_add_action_or_reset(test, h3970_touch_stop, &ctx->touch);
+	if (ret)
+		return ret;
+	ctx->count = 0;
+	test->priv = ctx;
+	return 0;
+}
+
+static void h3970_touch_poll_position(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+
+	h3970_touch_poll(ctx->input);
+	KUNIT_EXPECT_TRUE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	KUNIT_EXPECT_EQ(test, input_abs_get_val(ctx->input, ABS_X), 128);
+	KUNIT_EXPECT_EQ(test, input_abs_get_val(ctx->input, ABS_Y), 768);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 8U);
+	KUNIT_EXPECT_EQ(test, ctx->data_reads, 2U);
+	KUNIT_EXPECT_EQ(test, ctx->gpio, BIT(12) | DRIVE_PEN);
+	KUNIT_ASSERT_EQ(test, ctx->count, 23U);
+	KUNIT_EXPECT_TRUE(test, ctx->writes[0].gpio);
+	KUNIT_EXPECT_EQ(test, ctx->writes[0].value, BIT(12) | DRIVE_X);
+	KUNIT_EXPECT_EQ(test, ctx->writes[1].value, 11U);
+	KUNIT_EXPECT_TRUE(test, ctx->writes[10].gpio);
+	KUNIT_EXPECT_EQ(test, ctx->writes[10].value, BIT(12) | DRIVE_Y);
+	KUNIT_EXPECT_EQ(test, ctx->writes[11].value, 12U);
+	KUNIT_EXPECT_EQ(test, ctx->writes[20].reg, ctx->adc.base + 4);
+	KUNIT_EXPECT_EQ(test, ctx->writes[20].value, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->writes[21].reg, ctx->adc.base);
+	KUNIT_EXPECT_EQ(test, ctx->writes[21].value, 0U);
+	KUNIT_EXPECT_TRUE(test, ctx->writes[22].gpio);
+	KUNIT_EXPECT_EQ(test, ctx->writes[22].value, BIT(12) | DRIVE_PEN);
+}
+
+static void h3970_touch_pen_up(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+
+	input_report_key(ctx->input, BTN_TOUCH, 1);
+	input_sync(ctx->input);
+	ctx->gpio |= PEN_UP;
+	h3970_touch_poll(ctx->input);
+	KUNIT_EXPECT_FALSE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	KUNIT_EXPECT_EQ(test, ctx->count, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 0U);
+}
+
+static void h3970_touch_lift_during_sample(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+
+	ctx->lift_after_data = true;
+	h3970_touch_poll(ctx->input);
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 8U);
+	KUNIT_EXPECT_FALSE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	KUNIT_EXPECT_EQ(test, ctx->gpio, BIT(12) | PEN_UP | DRIVE_PEN);
+}
+
+static void h3970_touch_conversion_error(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+
+	input_report_key(ctx->input, BTN_TOUCH, 1);
+	input_sync(ctx->input);
+	ctx->fail_data = true;
+	h3970_touch_poll(ctx->input);
+	KUNIT_EXPECT_FALSE(test, test_bit(BTN_TOUCH, ctx->input->key));
+	KUNIT_EXPECT_EQ(test, ctx->conversions, 4U);
+	KUNIT_EXPECT_EQ(test, ctx->data_reads, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->gpio, BIT(12) | DRIVE_PEN);
+	KUNIT_EXPECT_EQ(test, ctx->control, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->mux, 0U);
+}
+
+static void h3970_touch_cleanup_errors(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+	unsigned int failure;
+
+	/* Failed control stop, mux stop or GPIO restore must not report a point. */
+	for (failure = 21; failure <= 23; failure++) {
+		ctx->count = 0;
+		ctx->fail_at = failure;
+		input_report_key(ctx->input, BTN_TOUCH, 1);
+		input_sync(ctx->input);
+		h3970_touch_poll(ctx->input);
+		KUNIT_EXPECT_FALSE(test, test_bit(BTN_TOUCH, ctx->input->key));
+		KUNIT_ASSERT_EQ(test, ctx->count, 23U);
+		KUNIT_EXPECT_EQ(test, ctx->writes[21].value, 0U);
+		KUNIT_EXPECT_TRUE(test, ctx->writes[22].gpio);
+		KUNIT_EXPECT_EQ(test, ctx->writes[22].value, BIT(12) | DRIVE_PEN);
+	}
+}
+
+static void h3970_touch_stop_is_final(struct kunit *test)
+{
+	struct h3970_touch_test *ctx = test->priv;
+	unsigned int count;
+
+	h3970_touch_stop(&ctx->touch);
+	KUNIT_EXPECT_TRUE(test, ctx->touch.stopped);
+	KUNIT_EXPECT_EQ(test, ctx->control, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->mux, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->gpio, BIT(12) | DRIVE_PEN);
+	count = ctx->count;
+	h3970_touch_poll(ctx->input);
+	h3970_touch_stop(&ctx->touch);
+	KUNIT_EXPECT_EQ(test, ctx->count, count);
