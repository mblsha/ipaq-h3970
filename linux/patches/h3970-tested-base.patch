diff --git a/drivers/input/keyboard/asic2-keys.c b/drivers/input/keyboard/asic2-keys.c
new file mode 100644
index 0000000000000000000000000000000000000000..7ab821a018585e7a1c6cfde378fb527dfbe6bba5
--- /dev/null
+++ b/drivers/input/keyboard/asic2-keys.c
@@ -0,0 +1,393 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* ASIC2 KPIO key patterns, including its encoded five-way input mode. */
+#include <linux/bitmap.h>
+#include <linux/gpio/consumer.h>
+#include <linux/input.h>
+#include <linux/mfd/compaq-asic.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+
+#define ASIC2_KPIO_DIR	0x200
+#define ASIC2_KPIO_DATA	0x214
+#define ASIC2_KPIO_ALT	0x23c
+#define ASIC2_KEY_LINES	GENMASK(11, 0)
+#define ASIC2_FIVE_WAY	GENMASK(5, 1)
+
+struct asic2_key {
+	u32 mask;
+	u32 value;
+};
+
+struct asic2_keys {
+	struct regmap *map;
+	struct gpio_desc *power_button;
+	unsigned short *keycodes;
+	unsigned int button_count;
+	unsigned int key_count;
+	u32 pending;
+	u32 saved_dir;
+	u32 saved_alt;
+	struct asic2_key buttons[];
+};
+
+static void asic2_keys_sample(struct asic2_keys *keys, struct input_dev *input,
+			      unsigned int raw, int power)
+{
+	DECLARE_BITMAP(down, KEY_CNT);
+	u32 state = ~raw & ASIC2_KEY_LINES;
+	unsigned int i;
+
+	if (power > 0)
+		state |= BIT(12);
+	/* Two stable samples reject transitions through other five-way codes. */
+	if (state != keys->pending) {
+		keys->pending = state;
+		return;
+	}
+	bitmap_zero(down, KEY_CNT);
+	for (i = 0; i < keys->button_count; i++) {
+		if ((raw & keys->buttons[i].mask) == keys->buttons[i].value)
+			__set_bit(keys->keycodes[i], down);
+	}
+	if (keys->key_count > keys->button_count && power > 0)
+		__set_bit(keys->keycodes[keys->button_count], down);
+	/* Users may remap several physical controls to the same key code. */
+	for (i = 0; i < keys->key_count; i++)
+		input_report_key(input, keys->keycodes[i], test_bit(keys->keycodes[i], down));
+	input_sync(input);
+}
+
+static void asic2_keys_poll(struct input_dev *input)
+{
+	struct asic2_keys *keys = input_get_drvdata(input);
+	unsigned int raw;
+	int power = 0;
+
+	if (regmap_read(keys->map, ASIC2_KPIO_DATA, &raw))
+		return;
+	if (keys->power_button)
+		power = gpiod_get_value_cansleep(keys->power_button);
+	asic2_keys_sample(keys, input, raw, power);
+}
+
+static void asic2_keys_restore(void *data)
+{
+	struct asic2_keys *keys = data;
+
+	regmap_write(keys->map, ASIC2_KPIO_ALT, keys->saved_alt);
+	regmap_write(keys->map, ASIC2_KPIO_DIR, keys->saved_dir);
+}
+
+static int asic2_keys_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct compaq_asic *asic;
+	struct asic2_keys *keys;
+	struct input_dev *input;
+	unsigned int count, i = 0, j;
+	u32 code, interval = 10;
+	int ret;
+
+	asic = compaq_asic_parent(dev, COMPAQ_ASIC2);
+	if (IS_ERR(asic))
+		return PTR_ERR(asic);
+	count = of_get_available_child_count(dev->of_node);
+	if (!count)
+		return -EINVAL;
+	keys = devm_kzalloc(dev, struct_size(keys, buttons, count), GFP_KERNEL);
+	if (!keys)
+		return -ENOMEM;
+	keys->map = asic->map;
+	keys->button_count = count;
+	keys->power_button = devm_gpiod_get_optional(dev, "power-button", GPIOD_IN);
+	if (IS_ERR(keys->power_button))
+		return dev_err_probe(dev, PTR_ERR(keys->power_button), "power button\n");
+	keys->key_count = count + !!keys->power_button;
+	keys->keycodes = devm_kcalloc(dev, keys->key_count, sizeof(*keys->keycodes), GFP_KERNEL);
+	if (!keys->keycodes)
+		return -ENOMEM;
+	for_each_available_child_of_node_scoped(dev->of_node, child) {
+		struct asic2_key *button = &keys->buttons[i];
+
+		ret = of_property_read_u32(child, "linux,code", &code);
+		if (ret || !code || code > KEY_MAX)
+			return -EINVAL;
+		ret = of_property_read_u32(child, "compaq,kpio-mask", &button->mask);
+		if (ret || !button->mask || (button->mask & ~ASIC2_KEY_LINES))
+			return -EINVAL;
+		ret = of_property_read_u32(child, "compaq,kpio-value", &button->value);
+		if (ret || (button->value & ~button->mask))
+			return -EINVAL;
+		for (j = 0; j < i; j++) {
+			if (keys->keycodes[j] == code ||
+			    (keys->buttons[j].mask == button->mask &&
+			     keys->buttons[j].value == button->value))
+				return -EINVAL;
+		}
+		keys->keycodes[i++] = code;
+	}
+	if (keys->power_button) {
+		for (i = 0; i < count; i++) {
+			if (keys->keycodes[i] == KEY_POWER)
+				return -EINVAL;
+		}
+		keys->keycodes[count] = KEY_POWER;
+	}
+	device_property_read_u32(dev, "poll-interval", &interval);
+	if (!interval || interval > 1000)
+		return -EINVAL;
+
+	ret = regmap_read(keys->map, ASIC2_KPIO_DIR, &keys->saved_dir);
+	if (ret)
+		return ret;
+	ret = regmap_read(keys->map, ASIC2_KPIO_ALT, &keys->saved_alt);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, asic2_keys_restore, keys);
+	if (ret)
+		return ret;
+	ret = regmap_write(keys->map, ASIC2_KPIO_DIR, keys->saved_dir | ASIC2_KEY_LINES);
+	if (ret)
+		return ret;
+	ret = regmap_write(keys->map, ASIC2_KPIO_ALT, ASIC2_FIVE_WAY);
+	if (ret)
+		return ret;
+
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return -ENOMEM;
+	input->name = "ASIC2 keys";
+	device_property_read_string(dev, "label", &input->name);
+	input->id.bustype = BUS_HOST;
+	input->keycode = keys->keycodes;
+	input->keycodesize = sizeof(*keys->keycodes);
+	input->keycodemax = keys->key_count;
+	input_set_drvdata(input, keys);
+	for (i = 0; i < keys->key_count; i++)
+		input_set_capability(input, EV_KEY, keys->keycodes[i]);
+	ret = input_setup_polling(input, asic2_keys_poll);
+	if (ret)
+		return ret;
+	input_set_poll_interval(input, interval);
+	return input_register_device(input);
+}
+
+static const struct of_device_id asic2_keys_match[] = {
+	{ .compatible = "compaq,asic2-keys" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, asic2_keys_match);
+
+static struct platform_driver asic2_keys_driver = {
+	.probe = asic2_keys_probe,
+	.driver = {
+		.name = "asic2-keys",
+		.of_match_table = asic2_keys_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(asic2_keys_driver);
+
+MODULE_DESCRIPTION("Compaq ASIC2 KPIO keys");
+MODULE_LICENSE("GPL");
+
+#if IS_ENABLED(CONFIG_KEYBOARD_ASIC2_KUNIT_TEST)
+#include <kunit/test.h>
+
+struct asic2_keys_test {
+	struct asic2_keys *keys;
+	struct input_dev *input;
+};
+
+static void asic2_keys_test_unregister(void *data)
+{
+	input_unregister_device(data);
+}
+
+static int asic2_keys_test_init(struct kunit *test)
+{
+	static const struct asic2_key buttons[] = {
+		{ 0x3e, 0x0c }, { 0x3e, 0x12 }, { 0x3e, 0x1e },
+		{ BIT(0), 0 }, { BIT(6), 0 },
+	};
+	static const unsigned short codes[] = {
+		KEY_UP, KEY_DOWN, KEY_ENTER, KEY_RECORD, KEY_CALENDAR, KEY_POWER,
+	};
+	struct asic2_keys_test *ctx;
+	unsigned int i;
+	int ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	ctx->keys = kunit_kzalloc(test, struct_size(ctx->keys, buttons, ARRAY_SIZE(buttons)),
+				  GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->keys);
+	ctx->keys->keycodes = kunit_kmalloc(test, sizeof(codes), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->keys->keycodes);
+	memcpy(ctx->keys->keycodes, codes, sizeof(codes));
+	memcpy(ctx->keys->buttons, buttons, sizeof(buttons));
+	ctx->keys->button_count = ARRAY_SIZE(buttons);
+	ctx->keys->key_count = ARRAY_SIZE(codes);
+	ctx->input = input_allocate_device();
+	KUNIT_ASSERT_NOT_NULL(test, ctx->input);
+	ctx->input->name = "ASIC2 KUnit keys";
+	ctx->input->keycode = ctx->keys->keycodes;
+	ctx->input->keycodesize = sizeof(*codes);
+	ctx->input->keycodemax = ARRAY_SIZE(codes);
+	for (i = 0; i < ARRAY_SIZE(codes); i++)
+		input_set_capability(ctx->input, EV_KEY, codes[i]);
+	ret = input_register_device(ctx->input);
+	if (ret) {
+		input_free_device(ctx->input);
+		return ret;
+	}
+	ret = kunit_add_action_or_reset(test, asic2_keys_test_unregister, ctx->input);
+	if (ret)
+		return ret;
+	test->priv = ctx;
+	return 0;
+}
+
+static bool asic2_keys_test_pressed(struct asic2_keys_test *ctx, unsigned int code)
+{
+	return test_bit(code, ctx->input->key);
+}
+
+static void asic2_keys_test_sample(struct asic2_keys_test *ctx, u32 pressed, int power)
+{
+	asic2_keys_sample(ctx->keys, ctx->input, ASIC2_KEY_LINES & ~pressed, power);
+}
+
+static void asic2_keys_stable_samples(struct kunit *test)
+{
+	struct asic2_keys_test *ctx = test->priv;
+
+	asic2_keys_test_sample(ctx, BIT(0), 0);
+	KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+	asic2_keys_test_sample(ctx, BIT(0), 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+	asic2_keys_test_sample(ctx, 0, 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+	asic2_keys_test_sample(ctx, BIT(0), 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+	asic2_keys_test_sample(ctx, 0, 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+	asic2_keys_test_sample(ctx, 0, 0);
+	KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+}
+
+static void asic2_keys_five_way_codebook(struct kunit *test)
+{
+	struct asic2_keys_test *ctx = test->priv;
+	unsigned int pattern;
+
+	/* Exercise all five-bit codes, including invalid/transitional patterns. */
+	for (pattern = 0; pattern < 32; pattern++) {
+		asic2_keys_test_sample(ctx, pattern << 1, 0);
+		asic2_keys_test_sample(ctx, pattern << 1, 0);
+		KUNIT_EXPECT_EQ(test, asic2_keys_test_pressed(ctx, KEY_UP), pattern == 0x19);
+		KUNIT_EXPECT_EQ(test, asic2_keys_test_pressed(ctx, KEY_DOWN), pattern == 0x16);
+		KUNIT_EXPECT_EQ(test, asic2_keys_test_pressed(ctx, KEY_ENTER), pattern == 0x10);
+		KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+		KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_POWER));
+	}
+}
+
+static void asic2_keys_independent_and_power(struct kunit *test)
+{
+	struct asic2_keys_test *ctx = test->priv;
+	u32 pressed = BIT(0) | BIT(6) | 0x32;
+
+	asic2_keys_test_sample(ctx, pressed, 1);
+	asic2_keys_test_sample(ctx, pressed, 1);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_UP));
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_CALENDAR));
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_POWER));
+	asic2_keys_test_sample(ctx, pressed, 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_POWER));
+	asic2_keys_test_sample(ctx, pressed, 0);
+	KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_POWER));
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_UP));
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+}
+
+static void asic2_keys_reject_transient_five_way(struct kunit *test)
+{
+	struct asic2_keys_test *ctx = test->priv;
+
+	asic2_keys_test_sample(ctx, 0x32, 0);
+	asic2_keys_test_sample(ctx, 0x32, 0);
+	asic2_keys_test_sample(ctx, 0x20, 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_UP));
+	KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_ENTER));
+	asic2_keys_test_sample(ctx, 0x2c, 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_UP));
+	KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_ENTER));
+	asic2_keys_test_sample(ctx, 0x2c, 0);
+	KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_UP));
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_DOWN));
+	KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_ENTER));
+}
+
+static void asic2_keys_remapping(struct kunit *test)
+{
+	struct asic2_keys_test *ctx = test->priv;
+	struct input_keymap_entry entry = {
+		.flags = INPUT_KEYMAP_BY_INDEX,
+		.index = 3,
+		.keycode = KEY_F1,
+	};
+
+	KUNIT_EXPECT_EQ(test, ctx->keys->keycodes[3], (unsigned short)KEY_RECORD);
+	KUNIT_ASSERT_EQ(test, input_set_keycode(ctx->input, &entry), 0);
+	asic2_keys_test_sample(ctx, BIT(0), 0);
+	asic2_keys_test_sample(ctx, BIT(0), 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_F1));
+	KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_RECORD));
+}
+
+static void asic2_keys_shared_mapping(struct kunit *test)
+{
+	struct asic2_keys_test *ctx = test->priv;
+	struct input_keymap_entry entry = {
+		.flags = INPUT_KEYMAP_BY_INDEX,
+		.index = 3,
+		.keycode = KEY_F1,
+	};
+
+	KUNIT_ASSERT_EQ(test, input_set_keycode(ctx->input, &entry), 0);
+	entry.index = 4;
+	KUNIT_ASSERT_EQ(test, input_set_keycode(ctx->input, &entry), 0);
+	asic2_keys_test_sample(ctx, BIT(0), 0);
+	asic2_keys_test_sample(ctx, BIT(0), 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_F1));
+	asic2_keys_test_sample(ctx, BIT(6), 0);
+	asic2_keys_test_sample(ctx, BIT(6), 0);
+	KUNIT_EXPECT_TRUE(test, asic2_keys_test_pressed(ctx, KEY_F1));
+	asic2_keys_test_sample(ctx, 0, 0);
+	asic2_keys_test_sample(ctx, 0, 0);
+	KUNIT_EXPECT_FALSE(test, asic2_keys_test_pressed(ctx, KEY_F1));
+}
+
+static struct kunit_case asic2_keys_test_cases[] = {
+	KUNIT_CASE(asic2_keys_stable_samples),
+	KUNIT_CASE(asic2_keys_five_way_codebook),
+	KUNIT_CASE(asic2_keys_independent_and_power),
+	KUNIT_CASE(asic2_keys_reject_transient_five_way),
+	KUNIT_CASE(asic2_keys_remapping),
+	KUNIT_CASE(asic2_keys_shared_mapping),
+	{}
+};
+
+static struct kunit_suite asic2_keys_test_suite = {
+	.name = "asic2-keys",
+	.init = asic2_keys_test_init,
+	.test_cases = asic2_keys_test_cases,
+};
+
+kunit_test_suite(asic2_keys_test_suite);
+#endif
diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
