+
+	pxa_test_apply(test, false, false, false);
+	pxa_test_clocks(test, false);
+	KUNIT_ASSERT_EQ(test, pxa_cpufreq_load_opps(&ctx->data), 0);
+	KUNIT_EXPECT_FALSE(test, ctx->data.has_opps);
+	KUNIT_ASSERT_EQ(test, pxa_cpufreq_build_table(&ctx->data), 0);
+	for (i = 0; i < ctx->data.num_freqs; i++)
+		KUNIT_EXPECT_EQ(test, ctx->table[i].frequency, ctx->data.freqs[i].khz);
+	KUNIT_EXPECT_EQ(test, ctx->table[i].frequency, CPUFREQ_TABLE_END);
+}
