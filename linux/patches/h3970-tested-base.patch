+static void uda1380_reserved_and_status_are_not_restored(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+	static const unsigned int invalid[] = { 0x05, 0x0f, 0x15, 0x18, 0x1f, 0x24, 0x28 };
+	unsigned int transfers, i;
+
+	uda_test_powered(test);
+	ctx->component.active = 1;
+	transfers = ctx->transfers;
+	for (i = 0; i < ARRAY_SIZE(invalid); i++)
+		KUNIT_EXPECT_EQ(test, uda1380_write(&ctx->component, invalid[i], 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ctx->transfers, transfers);
+	KUNIT_ASSERT_EQ(test, uda1380_set_bias_level(&ctx->component, SND_SOC_BIAS_OFF), 0);
+	snd_soc_dapm_init_bias_level(snd_soc_component_get_dapm(&ctx->component),
+				     SND_SOC_BIAS_OFF);
+	KUNIT_ASSERT_EQ(test, uda1380_set_bias_level(&ctx->component, SND_SOC_BIAS_STANDBY), 0);
+	uda1380_flush_work(&ctx->priv.work);
+	KUNIT_EXPECT_EQ(test, ctx->priv.cache_dirty, 0UL);
+	KUNIT_EXPECT_EQ(test, ctx->invalid_reg_writes, 0U);
+}
+
+static void uda1380_gpio_supplier_defers(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+
+	ctx->lookup->table[0].key = "uda1380-missing-gpio-provider";
+	KUNIT_EXPECT_EQ(test, uda1380_get_resources(ctx->component.dev, &ctx->priv),
+			-EPROBE_DEFER);
+	KUNIT_EXPECT_EQ(test, ctx->nevents, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->transfers, 0U);
+	ctx->lookup->table[0].key = "uda1380-kunit-gpio";
+	uda_test_start(test);
+	KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+	KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 0);
+}
+
+static void uda1380_legacy_component_policy(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+	struct uda1380_platform_data pdata = {
+		.gpio_reset = -1,
+		.gpio_power = -1,
+		.dac_clk = UDA1380_DAC_CLK_SYSCLK,
+	};
+	struct snd_soc_component *component;
+	struct uda1380_priv *priv;
+	int ret;
+
+	ctx->component.dev->platform_data = &pdata;
+	ret = uda1380_i2c_probe(ctx->priv.i2c);
+	ctx->component.dev->platform_data = NULL;
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	component = snd_soc_lookup_component(ctx->component.dev, NULL);
+	KUNIT_ASSERT_NOT_NULL(test, component);
+	KUNIT_EXPECT_PTR_EQ(test, component->driver, &soc_component_dev_uda1380);
+	KUNIT_EXPECT_TRUE(test, component->driver->idle_bias_on);
+	KUNIT_EXPECT_TRUE(test, component->driver->use_pmdown_time);
+	priv = i2c_get_clientdata(ctx->priv.i2c);
+	KUNIT_EXPECT_FALSE(test, priv->firmware);
+	KUNIT_EXPECT_FALSE(test, priv->cache_only);
+}
+
+static struct kunit_case uda1380_test_cases[] = {
+	KUNIT_CASE(uda1380_cache_is_per_device),
