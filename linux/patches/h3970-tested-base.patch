+// SPDX-License-Identifier: GPL-2.0-only
+/* SL-C860 wiring. Boot roles and per-unit panel adjustments are supplied separately. */
+
+#include "dt-bindings/gpio/gpio.h"
+#include "dt-bindings/input/input.h"
+#include "dt-bindings/interrupt-controller/irq.h"
+#include "pxa25x.dtsi"
+
+/ {
+	model = "Sharp Zaurus SL-C860";
+	compatible = "sharp,sl-c860", "marvell,pxa250";
+
+	aliases {
+		/delete-property/ i2c0;
+		mmc0 = &mmc0;
+		serial0 = &ffuart;
+		spi0 = &ssp1;
+	};
+
+	chosen {
+		stdout-path = "serial0:9600n8";
+	};
+
+	memory@a0000000 {
+		device_type = "memory";
+		reg = <0xa0000000 0x04000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Factory NOR resumes through this mapped, reserved SDRAM page. */
+		deep-resume@a0000000 {
+			reg = <0xa0000000 0x00001000>;
+		};
+	};
+
+	touch_vcc: regulator-touchscreen-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "sl-c860-touchscreen-vcc";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+		status = "okay";
+	};
+
+	audio_vcc: regulator-audio-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "sl-c860-audio-vcc";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+		status = "okay";
+	};
+
+	sound: sound {
+		compatible = "sharp,sl-c860-audio";
+		i2s-controller = <&i2s>;
+		audio-codec = <&wm8731>;
+		mute-l-gpios = <&scoop 3 GPIO_ACTIVE_HIGH>;
+		mute-r-gpios = <&scoop 4 GPIO_ACTIVE_HIGH>;
+		apm-on-gpios = <&scoop 6 GPIO_ACTIVE_HIGH>;
+		mic-bias-gpios = <&scoop 8 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+
+	w100: display-controller@8000000 {
+		compatible = "sharp,sl-c860-w100", "ati,w100";
+		reg = <0x08000000 0x01000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&c860_w100_pins>;
+		status = "okay";
+	};
+
+	scoop: system-controller@10800000 {
+		compatible = "sharp,sl-c860-scoop", "sharp,scoop";
+		reg = <0x10800000 0x1000>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-line-names = "mail-led", "hinge-a", "hinge-b",
+				  "audio-mute-left", "audio-mute-right",
+				  "accessory-pullup", "audio-amplifier",
+				  "backlight", "microphone-bias", "", "", "";
+		sharp,io-direction-mask = <0x03f2>;
+		sharp,io-output-mask = <0x0030>;
+		sharp,suspend-clear-mask = <0xffff>;
+		sharp,suspend-set-mask = <0x0000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&c860_scoop_pins>;
+		status = "okay";
+	};
+
+	nand: nand-controller@c000000 {
+		compatible = "sharp,sl-c860-nand";
+		reg = <0x0c000000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "disabled";
+	};
+
+	mmc_vcc: regulator-mmc-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "sl-c860-sd-slot";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio 33 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		status = "okay";
+	};
+
+	keyboard: matrix-keypad {
+		compatible = "gpio-matrix-keypad";
+		row-gpios = <&gpio 58 GPIO_ACTIVE_HIGH>,
+			    <&gpio 59 GPIO_ACTIVE_HIGH>,
+			    <&gpio 60 GPIO_ACTIVE_HIGH>,
+			    <&gpio 61 GPIO_ACTIVE_HIGH>,
+			    <&gpio 62 GPIO_ACTIVE_HIGH>,
+			    <&gpio 63 GPIO_ACTIVE_HIGH>,
+			    <&gpio 64 GPIO_ACTIVE_HIGH>,
+			    <&gpio 65 GPIO_ACTIVE_HIGH>;
+		col-gpios = <&gpio 66 GPIO_ACTIVE_HIGH>,
+			    <&gpio 67 GPIO_ACTIVE_HIGH>,
+			    <&gpio 68 GPIO_ACTIVE_HIGH>,
+			    <&gpio 69 GPIO_ACTIVE_HIGH>,
+			    <&gpio 70 GPIO_ACTIVE_HIGH>,
+			    <&gpio 71 GPIO_ACTIVE_HIGH>,
+			    <&gpio 72 GPIO_ACTIVE_HIGH>,
+			    <&gpio 73 GPIO_ACTIVE_HIGH>,
+			    <&gpio 74 GPIO_ACTIVE_HIGH>,
+			    <&gpio 75 GPIO_ACTIVE_HIGH>,
+			    <&gpio 76 GPIO_ACTIVE_HIGH>,
+			    <&gpio 77 GPIO_ACTIVE_HIGH>;
+		debounce-delay-ms = <10>;
+		col-scan-delay-us = <10>;
+		wakeup-source;
+		pinctrl-names = "default";
+		pinctrl-0 = <&c860_matrix_keypad_rows_pins
+			     &c860_matrix_keypad_cols_pins>;
+
+		linux,keymap =
+			<MATRIX_KEY(0, 1, KEY_1)
+			 MATRIX_KEY(0, 2, KEY_3)
+			 MATRIX_KEY(0, 3, KEY_5)
+			 MATRIX_KEY(0, 4, KEY_6)
+			 MATRIX_KEY(0, 5, KEY_7)
+			 MATRIX_KEY(0, 6, KEY_9)
+			 MATRIX_KEY(0, 7, KEY_0)
+			 MATRIX_KEY(0, 8, KEY_BACKSPACE)
+			 MATRIX_KEY(1, 1, KEY_2)
+			 MATRIX_KEY(1, 2, KEY_4)
+			 MATRIX_KEY(1, 3, KEY_R)
+			 MATRIX_KEY(1, 4, KEY_Y)
+			 MATRIX_KEY(1, 5, KEY_8)
+			 MATRIX_KEY(1, 6, KEY_I)
+			 MATRIX_KEY(1, 7, KEY_O)
+			 MATRIX_KEY(1, 8, KEY_P)
+			 MATRIX_KEY(2, 0, KEY_TAB)
+			 MATRIX_KEY(2, 1, KEY_Q)
+			 MATRIX_KEY(2, 2, KEY_E)
+			 MATRIX_KEY(2, 3, KEY_T)
+			 MATRIX_KEY(2, 4, KEY_G)
+			 MATRIX_KEY(2, 5, KEY_U)
+			 MATRIX_KEY(2, 6, KEY_J)
+			 MATRIX_KEY(2, 7, KEY_K)
+			 MATRIX_KEY(3, 0, KEY_F1)
+			 MATRIX_KEY(3, 1, KEY_W)
+			 MATRIX_KEY(3, 2, KEY_S)
+			 MATRIX_KEY(3, 3, KEY_F)
+			 MATRIX_KEY(3, 4, KEY_V)
+			 MATRIX_KEY(3, 5, KEY_H)
+			 MATRIX_KEY(3, 6, KEY_M)
+			 MATRIX_KEY(3, 7, KEY_L)
+			 MATRIX_KEY(3, 9, KEY_RIGHTSHIFT)
+			 MATRIX_KEY(4, 0, KEY_F2)
+			 MATRIX_KEY(4, 1, KEY_A)
+			 MATRIX_KEY(4, 2, KEY_D)
+			 MATRIX_KEY(4, 3, KEY_C)
+			 MATRIX_KEY(4, 4, KEY_B)
+			 MATRIX_KEY(4, 5, KEY_N)
+			 MATRIX_KEY(4, 6, KEY_DOT)
+			 MATRIX_KEY(4, 8, KEY_ENTER)
+			 MATRIX_KEY(4, 10, KEY_LEFTSHIFT)
+			 MATRIX_KEY(5, 0, KEY_F10)
+			 MATRIX_KEY(5, 1, KEY_Z)
+			 MATRIX_KEY(5, 2, KEY_X)
