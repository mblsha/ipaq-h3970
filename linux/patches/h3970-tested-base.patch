diff --git a/Documentation/devicetree/bindings/sound/nxp,uda1380.yaml b/Documentation/devicetree/bindings/sound/nxp,uda1380.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..a65b2abb643e9ce8fadbdbe53d10c99776b15052
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/nxp,uda1380.yaml
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/nxp,uda1380.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: NXP UDA1380 stereo audio codec
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  The UDA1380 has a SYSCLK input and a PLL driven by the serial word select
+  signal (WSPLL). SYSCLK must run during reset even when the DAC uses WSPLL.
+  Boards with a controllable SYSCLK must describe that clock.
+
+allOf:
+  - $ref: dai-common.yaml#
+  - not:
+      required: [power-gpios, power-gpio]
+  - not:
+      required: [reset-gpios, reset-gpio]
+
+properties:
+  compatible:
+    const: nxp,uda1380
+
+  reg:
+    maxItems: 1
+
+  '#sound-dai-cells':
+    enum: [0, 1]
+    description: |
+      Zero cells selects the combined playback/capture interface. With one
+      cell, 0 selects that interface, 1 the playback-only interface, and 2
+      the capture-only interface.
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: sysclk
+
+  power-gpios:
+    maxItems: 1
+    description: Board-level codec power enable.
+
+  reset-gpios:
+    maxItems: 1
+    description: Codec RESET input, active high.
+
+  power-gpio:
+    maxItems: 1
+    deprecated: true
+    description: Deprecated spelling of power-gpios.
+
+  reset-gpio:
+    maxItems: 1
+    deprecated: true
+    description: Deprecated spelling of reset-gpios.
+
+  dac-clk:
+    $ref: /schemas/types.yaml#/definitions/string
+    enum: [sysclk, wspll]
+    default: sysclk
+    description: Clock source for the DAC and interpolator.
+
+required:
+  - compatible
+  - reg
+
+dependentRequired:
+  clocks: [clock-names]
+  clock-names: [clocks]
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        codec@18 {
+            compatible = "nxp,uda1380";
+            reg = <0x18>;
+            #sound-dai-cells = <0>;
+            clocks = <&codec_clk>;
+            clock-names = "sysclk";
+            power-gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
+            reset-gpios = <&gpio 10 GPIO_ACTIVE_HIGH>;
+            dac-clk = "wspll";
+        };
+    };
