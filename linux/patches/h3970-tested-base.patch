+			       flags, "asic2-test-event", event);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	return event;
+}
+
+static void asic2_irq_test_preserved(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+
+	KUNIT_EXPECT_EQ(test, ctx->unsafe_reads, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->regs[0], 0xffffU);
+	KUNIT_EXPECT_EQ(test, ctx->regs[ASIC2_IRQ_ENABLE / 4] & ~ASIC2_GPIO_IRQ_MASK, BIT(31));
+	KUNIT_EXPECT_EQ(test, ctx->regs[0x14 / 4], 0xa5a5U);
+	KUNIT_EXPECT_EQ(test, ctx->regs[0x3c / 4], 0x140U);
+	KUNIT_EXPECT_EQ(test, ctx->regs[0x200 / 4], 0xfffU);
+	KUNIT_EXPECT_EQ(test, ctx->regs[0x214 / 4], 0x5a5aU);
+	KUNIT_EXPECT_EQ(test, ctx->regs[0x23c / 4], 0x3eU);
+	KUNIT_EXPECT_EQ(test, ctx->regs[0x1000 / 4], 0x5030U);
+	KUNIT_EXPECT_EQ(test, ctx->regs[0x1600 / 4], 0x76U);
+	KUNIT_EXPECT_EQ(test, ctx->regs[0x1604 / 4], 0x1eU);
+	KUNIT_EXPECT_EQ(test, ctx->regs[0x1608 / 4], 7U);
+}
+
+static void asic2_irq_start_masked(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+
+	asic2_irq_test_register(test);
+	KUNIT_ASSERT_EQ(test, ctx->write_count, 4U);
+	KUNIT_EXPECT_EQ(test, ctx->writes[0].reg, ASIC2_IRQ_ENABLE);
+	KUNIT_EXPECT_EQ(test, ctx->writes[0].value, BIT(31));
+	KUNIT_EXPECT_EQ(test, ctx->writes[1].reg, ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE);
+	KUNIT_EXPECT_EQ(test, ctx->writes[1].value, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->writes[2].value, ASIC2_GPIO_IRQ_MASK);
+	KUNIT_EXPECT_EQ(test, ctx->writes[3].value, ASIC2_KPIO_IRQ_MASK);
+	KUNIT_EXPECT_EQ(test, ctx->regs[ASIC2_IRQ_PENDING / 4], 0U);
+	KUNIT_EXPECT_EQ(test, ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING) / 4], 0U);
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_test_free_gpio(void *data)
+{
+	gpiochip_free_own_desc(data);
+}
+
+static void asic2_irq_gpio_edge_and_ownership(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct asic2_irq_test_event *event;
+	struct gpio_desc *desc;
+	int ret;
+
+	asic2_irq_test_register(test);
+	desc = gpiochip_request_own_desc(ctx->gpio, 5, "asic2-test-input",
+					 GPIO_ACTIVE_HIGH, GPIOD_IN);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, desc);
+	ret = devm_add_action_or_reset(ctx->provider, asic2_irq_test_free_gpio, desc);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	event = asic2_irq_test_request(test, 5, IRQF_TRIGGER_FALLING);
+	KUNIT_EXPECT_EQ(test, gpiod_to_irq(desc), (int)event->virq);
+	KUNIT_EXPECT_TRUE(test, gpiochip_line_is_irq(ctx->gpio, 5));
+	KUNIT_EXPECT_EQ(test, gpiod_direction_output(desc, 1), -EIO);
+	ctx->regs[ASIC2_IRQ_PENDING / 4] = BIT(5);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->regs[ASIC2_IRQ_PENDING / 4], 0U);
+	disable_irq(event->virq);
+	ctx->regs[ASIC2_IRQ_PENDING / 4] = BIT(5);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 1U);
+	enable_irq(event->virq);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 2U);
+	devm_free_irq(ctx->provider, event->virq, event);
+	KUNIT_EXPECT_FALSE(test, gpiochip_line_is_irq(ctx->gpio, 5));
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_kpio_shadow(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct asic2_irq_test_event *key, *adc;
+
+	asic2_irq_test_register(test);
+	key = asic2_irq_test_request(test, 34, IRQF_TRIGGER_RISING);
+	adc = asic2_irq_test_request(test, 50, IRQF_TRIGGER_HIGH);
+	KUNIT_EXPECT_EQ(test, ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE) / 4],
+			BIT(2) | BIT(18));
+	disable_irq(key->virq);
+	ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING) / 4] = BIT(2) | BIT(18);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, key->count, 0U);
+	KUNIT_EXPECT_EQ(test, adc->count, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING) / 4], BIT(2));
+	enable_irq(key->virq);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, key->count, 1U);
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_type_and_bounds(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	unsigned int gpio, adc, writes;
+
+	asic2_irq_test_register(test);
+	gpio = irq_create_mapping(ctx->domain, 5);
+	adc = irq_create_mapping(ctx->domain, 50);
+	KUNIT_ASSERT_NE(test, gpio, 0U);
+	KUNIT_ASSERT_NE(test, adc, 0U);
+	writes = ctx->write_count;
+	KUNIT_EXPECT_EQ(test, irq_set_irq_type(gpio, IRQ_TYPE_EDGE_BOTH), -EINVAL);
+	KUNIT_EXPECT_EQ(test, irq_set_irq_type(adc, IRQ_TYPE_LEVEL_LOW), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ctx->write_count, writes);
+	KUNIT_EXPECT_EQ(test, irq_create_mapping(ctx->domain, 12), 0U);
+	KUNIT_EXPECT_EQ(test, irq_create_mapping(ctx->domain, 44), 0U);
+	KUNIT_EXPECT_EQ(test, irq_set_irq_type(gpio, IRQ_TYPE_LEVEL_LOW), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[ASIC2_IRQ_TYPE / 4] & BIT(5), 0U);
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_shared_parent_drain(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct asic2_irq_test_event *first, *second, *adc, *owm;
+
+	asic2_irq_test_register(test);
+	first = asic2_irq_test_request(test, 6, IRQF_TRIGGER_RISING);
+	second = asic2_irq_test_request(test, 7, IRQF_TRIGGER_FALLING);
+	adc = asic2_irq_test_request(test, 50, IRQF_TRIGGER_HIGH);
+	owm = asic2_irq_test_request(test, 49, IRQF_TRIGGER_HIGH);
+	first->inject_gpio = BIT(7);
+	first->inject_kpio = BIT(17);
+	ctx->regs[ASIC2_IRQ_PENDING / 4] = BIT(6);
+	ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING) / 4] = BIT(18);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, first->count, 1U);
+	KUNIT_EXPECT_EQ(test, second->count, 1U);
+	KUNIT_EXPECT_EQ(test, adc->count, 1U);
+	KUNIT_EXPECT_EQ(test, owm->count, 1U);
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_bounded_storm(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct asic2_irq_test_event *event;
+
+	asic2_irq_test_register(test);
+	event = asic2_irq_test_request(test, 6, IRQF_TRIGGER_RISING);
+	ctx->stuck_gpio = BIT(6);
+	ctx->regs[ASIC2_IRQ_PENDING / 4] = BIT(6);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, ASIC2_IRQ_DRAIN_LIMIT);
+	KUNIT_EXPECT_EQ(test, ctx->regs[ASIC2_IRQ_ENABLE / 4] & BIT(6), 0U);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, ASIC2_IRQ_DRAIN_LIMIT);
+	ctx->stuck_gpio = 0;
+	ctx->regs[ASIC2_IRQ_PENDING / 4] = 0;
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_io_errors(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct asic2_irq_test_event *event;
+
+	asic2_irq_test_register(test);
+	event = asic2_irq_test_request(test, 5, IRQF_TRIGGER_RISING);
+	ctx->fail_read = ASIC2_IRQ_PENDING;
+	ctx->regs[ASIC2_IRQ_PENDING / 4] = BIT(5);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 0U);
+	ctx->fail_read = ~0U;
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 1U);
+	ctx->fail_write = ASIC2_IRQ_EDGE;
+	KUNIT_EXPECT_EQ(test, irq_set_irq_type(event->virq, IRQ_TYPE_EDGE_FALLING), -EIO);
+	ctx->fail_write = ~0U;
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_mask_error_suppresses_dispatch(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct asic2_irq_test_event *event;
+
+	asic2_irq_test_register(test);
+	event = asic2_irq_test_request(test, 5, IRQF_TRIGGER_RISING);
+	ctx->fail_write = ASIC2_IRQ_ENABLE;
+	disable_irq(event->virq);
+	ctx->regs[ASIC2_IRQ_PENDING / 4] = BIT(5);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 0U);
+	ctx->fail_write = ~0U;
+	enable_irq(event->virq);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 1U);
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_unmask_error_suppresses_dispatch(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct asic2_irq_test_event *event;
+
+	asic2_irq_test_register(test);
+	event = asic2_irq_test_request(test, 50, IRQF_TRIGGER_HIGH | IRQF_NO_AUTOEN);
+	ctx->fail_write = ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE;
+	enable_irq(event->virq);
+	ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING) / 4] = BIT(18);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE) / 4], 0U);
+	ctx->fail_write = ~0U;
+	disable_irq(event->virq);
+	enable_irq(event->virq);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 1U);
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_provider_not_ready(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct asic2_irq_test_event *event;
+	struct asic2_irq *provider;
+	unsigned int virq;
+	int ret;
+
+	asic2_irq_test_register(test);
+	provider = ctx->domain->host_data;
+	virq = irq_create_mapping(ctx->domain, 50);
+	KUNIT_ASSERT_NE(test, virq, 0U);
+	smp_store_release(&provider->ready, false);
+	ret = devm_request_irq(ctx->provider, virq, asic2_irq_test_event,
+			       IRQF_TRIGGER_HIGH, "asic2-not-ready", ctx->events);
+	KUNIT_EXPECT_EQ(test, ret, -EPROBE_DEFER);
+	KUNIT_EXPECT_EQ(test, ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE) / 4], 0U);
+	smp_store_release(&provider->ready, true);
+	event = asic2_irq_test_request(test, 50, IRQF_TRIGGER_HIGH);
+	ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING) / 4] = BIT(18);
+	asic2_irq_test_raise(ctx);
+	KUNIT_EXPECT_EQ(test, event->count, 1U);
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_setup_failure(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct irq_domain *domain;
+
+	ctx->fail_write = ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE;
+	domain = devm_asic2_irq_register(ctx->provider, ctx->map, ctx->gpio,
+					 ctx->parent_irq, THIS_MODULE);
+	KUNIT_EXPECT_TRUE(test, IS_ERR(domain));
+	KUNIT_EXPECT_EQ(test, PTR_ERR(domain), -EIO);
+	KUNIT_EXPECT_PTR_EQ(test, irq_get_handler_data(ctx->parent_irq), NULL);
+	ctx->fail_write = ~0U;
+	asic2_irq_test_preserved(test);
+}
+
+static void asic2_irq_teardown(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+
+	asic2_irq_test_register(test);
+	asic2_irq_test_request(test, 5, IRQF_TRIGGER_FALLING);
+	asic2_irq_test_request(test, 50, IRQF_TRIGGER_HIGH);
+	kunit_release_action(test, asic2_irq_test_unregister, ctx->provider);
+	ctx->provider = NULL;
+	KUNIT_EXPECT_PTR_EQ(test, irq_get_handler_data(ctx->parent_irq), NULL);
+	KUNIT_EXPECT_EQ(test, ctx->regs[ASIC2_IRQ_ENABLE / 4], BIT(31));
+	KUNIT_EXPECT_EQ(test, ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE) / 4], 0U);
+	asic2_irq_test_preserved(test);
+}
+
+static struct kunit_case asic2_irq_test_cases[] = {
+	KUNIT_CASE(asic2_irq_start_masked),
+	KUNIT_CASE(asic2_irq_gpio_edge_and_ownership),
+	KUNIT_CASE(asic2_irq_kpio_shadow),
+	KUNIT_CASE(asic2_irq_type_and_bounds),
+	KUNIT_CASE(asic2_irq_shared_parent_drain),
+	KUNIT_CASE(asic2_irq_bounded_storm),
+	KUNIT_CASE(asic2_irq_io_errors),
+	KUNIT_CASE(asic2_irq_mask_error_suppresses_dispatch),
+	KUNIT_CASE(asic2_irq_unmask_error_suppresses_dispatch),
+	KUNIT_CASE(asic2_irq_provider_not_ready),
+	KUNIT_CASE(asic2_irq_setup_failure),
+	KUNIT_CASE(asic2_irq_teardown),
+	{}
+};
+
+static struct kunit_suite asic2_irq_test_suite = {
+	.name = "asic2-irq-domain",
+	.init = asic2_irq_test_init,
+	.test_cases = asic2_irq_test_cases,
+};
+
+kunit_test_suite(asic2_irq_test_suite);
diff --git a/drivers/irqchip/irq-asic2.c b/drivers/irqchip/irq-asic2.c
new file mode 100644
index 0000000000000000000000000000000000000000..332adc8e1e9947965ada99f37533d66e745e2cf7
--- /dev/null
+++ b/drivers/irqchip/irq-asic2.c
@@ -0,0 +1,378 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* ASIC2 GPIO/KPIO interrupt ownership over the companion's shared regmap. */
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/gpio/driver.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqchip/asic2.h>
+#include <linux/irqchip/chained_irq.h>
+#include <linux/irqdomain.h>
+#include <linux/module.h>
+#include <linux/rcupdate.h>
+#include <linux/regmap.h>
+#include <linux/spinlock.h>
+
+#define ASIC2_IRQ_TYPE		0x04
+#define ASIC2_IRQ_EDGE		0x08
+#define ASIC2_IRQ_LEVEL		0x0c
+#define ASIC2_IRQ_PENDING	0x10
+#define ASIC2_IRQ_ENABLE	0x1c
+#define ASIC2_KPIO_BASE		0x200
+#define ASIC2_GPIO_IRQ_MASK	GENMASK(11, 0)
+#define ASIC2_KPIO_IRQ_MASK	(GENMASK(11, 0) | GENMASK(23, 16))
+#define ASIC2_IRQ_COUNT		56
+#define ASIC2_IRQ_DRAIN_LIMIT	20
+
+struct asic2_irq {
+	struct device *dev;
+	struct regmap *map;
+	struct gpio_chip *gpio;
+	struct module *owner;
+	struct irq_domain *domain;
+	raw_spinlock_t lock;
+	u32 enabled[2];
+	int parent_irq;
+	bool chained;
+	bool ready;
+};
+
+static bool asic2_irq_valid(irq_hw_number_t hwirq)
+{
+	return hwirq < 12 || (hwirq >= 32 && hwirq < 44) ||
+	       (hwirq >= 48 && hwirq < ASIC2_IRQ_COUNT);
+}
+
+static unsigned int asic2_irq_bank(struct irq_data *data)
+{
+	return data->hwirq / 32;
+}
+
+static u32 asic2_irq_bit(struct irq_data *data)
+{
+	return BIT(data->hwirq % 32);
+}
+
+static int asic2_irq_write_enable(struct asic2_irq *irq, unsigned int bank, u32 enabled)
+{
+	if (bank)
+		return regmap_write(irq->map, ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE, enabled);
+	return regmap_update_bits(irq->map, ASIC2_IRQ_ENABLE, ASIC2_GPIO_IRQ_MASK, enabled);
+}
+
+static void asic2_irq_mask(struct irq_data *data)
+{
+	struct asic2_irq *irq = irq_data_get_irq_chip_data(data);
+	unsigned int bank = asic2_irq_bank(data);
+	unsigned long flags;
+	int ret;
+
+	raw_spin_lock_irqsave(&irq->lock, flags);
+	irq->enabled[bank] &= ~asic2_irq_bit(data);
+	/* KPIO enable must never be read, including for read/modify/write. */
+	ret = asic2_irq_write_enable(irq, bank, irq->enabled[bank]);
+	raw_spin_unlock_irqrestore(&irq->lock, flags);
+	if (ret)
+		dev_err_ratelimited(irq->dev, "IRQ mask write failed: %d\n", ret);
+}
+
+static void asic2_irq_unmask(struct irq_data *data)
+{
+	struct asic2_irq *irq = irq_data_get_irq_chip_data(data);
+	unsigned int bank = asic2_irq_bank(data);
+	unsigned long flags;
+	u32 enabled;
+	int ret;
+
+	raw_spin_lock_irqsave(&irq->lock, flags);
+	enabled = irq->enabled[bank] | asic2_irq_bit(data);
+	ret = asic2_irq_write_enable(irq, bank, enabled);
+	if (!ret)
+		irq->enabled[bank] = enabled;
+	raw_spin_unlock_irqrestore(&irq->lock, flags);
+	if (ret)
+		dev_err_ratelimited(irq->dev, "IRQ unmask write failed: %d\n", ret);
+}
+
+static void asic2_irq_ack(struct irq_data *data)
+{
+	struct asic2_irq *irq = irq_data_get_irq_chip_data(data);
+	int ret;
+
+	/* Read-status/write-clear share the address; never RMW an acknowledge. */
+	ret = regmap_write(irq->map, asic2_irq_bank(data) * ASIC2_KPIO_BASE +
+			   ASIC2_IRQ_PENDING, asic2_irq_bit(data));
+	if (ret)
+		dev_err_ratelimited(irq->dev, "IRQ acknowledge failed: %d\n", ret);
+}
+
+static void asic2_irq_enable(struct irq_data *data)
+{
+	struct asic2_irq *irq = irq_data_get_irq_chip_data(data);
+
+	if (data->hwirq < 12)
+		gpiochip_enable_irq(irq->gpio, data->hwirq);
+	asic2_irq_unmask(data);
+}
+
+static void asic2_irq_disable(struct irq_data *data)
+{
+	struct asic2_irq *irq = irq_data_get_irq_chip_data(data);
+
+	asic2_irq_mask(data);
+	if (data->hwirq < 12)
+		gpiochip_disable_irq(irq->gpio, data->hwirq);
+}
+
+static int asic2_irq_request_resources(struct irq_data *data)
+{
+	struct asic2_irq *irq = irq_data_get_irq_chip_data(data);
+	int ret = 0;
+
+	if (!smp_load_acquire(&irq->ready))
+		return -EPROBE_DEFER;
+	/* KPIO consumers must also pin the GPIO frontend that owns this domain. */
+	if (!try_module_get(irq->owner))
+		return -ENODEV;
+	if (data->hwirq < 12)
+		ret = gpiochip_lock_as_irq(irq->gpio, data->hwirq);
+	if (ret)
+		module_put(irq->owner);
+	return ret;
+}
+
+static void asic2_irq_release_resources(struct irq_data *data)
+{
+	struct asic2_irq *irq = irq_data_get_irq_chip_data(data);
+
+	if (data->hwirq < 12)
+		gpiochip_unlock_as_irq(irq->gpio, data->hwirq);
+	module_put(irq->owner);
+}
+
+static int asic2_irq_set_type(struct irq_data *data, unsigned int type)
+{
+	struct asic2_irq *irq = irq_data_get_irq_chip_data(data);
+	unsigned int base = asic2_irq_bank(data) * ASIC2_KPIO_BASE;
+	u32 bit = asic2_irq_bit(data);
+	unsigned long flags;
+	bool edge, high;
+	int ret;
+
+	if (data->hwirq >= 48) {
+		if (type != IRQ_TYPE_LEVEL_HIGH)
+			return -EINVAL;
+		irq_set_handler_locked(data, handle_level_irq);
+		return IRQ_SET_MASK_OK;
+	}
+	switch (type) {
+	case IRQ_TYPE_EDGE_RISING:
+	case IRQ_TYPE_EDGE_FALLING:
+		edge = true;
+		high = type == IRQ_TYPE_EDGE_RISING;
+		break;
+	case IRQ_TYPE_LEVEL_HIGH:
+	case IRQ_TYPE_LEVEL_LOW:
+		edge = false;
+		high = type == IRQ_TYPE_LEVEL_HIGH;
+		break;
+	default:
+		/* Both-edge polarity emulation needs separate hardware validation. */
+		return -EINVAL;
+	}
+	raw_spin_lock_irqsave(&irq->lock, flags);
+	ret = regmap_update_bits(irq->map, base + (edge ? ASIC2_IRQ_EDGE : ASIC2_IRQ_LEVEL),
+				 bit, high ? bit : 0);
+	if (!ret)
+		ret = regmap_update_bits(irq->map, base + ASIC2_IRQ_TYPE, bit, edge ? bit : 0);
+	raw_spin_unlock_irqrestore(&irq->lock, flags);
+	if (ret)
+		return ret;
+	irq_set_handler_locked(data, edge ? handle_edge_irq : handle_level_irq);
+	return IRQ_SET_MASK_OK;
+}
+
+static const struct irq_chip asic2_irq_chip = {
+	.name = "ASIC2",
+	.irq_mask = asic2_irq_mask,
+	.irq_unmask = asic2_irq_unmask,
+	.irq_ack = asic2_irq_ack,
+	.irq_enable = asic2_irq_enable,
+	.irq_disable = asic2_irq_disable,
+	.irq_set_type = asic2_irq_set_type,
+	.irq_request_resources = asic2_irq_request_resources,
+	.irq_release_resources = asic2_irq_release_resources,
+	.flags = IRQCHIP_SET_TYPE_MASKED | IRQCHIP_MASK_ON_SUSPEND,
+};
+
+static int asic2_irq_map(struct irq_domain *domain, unsigned int virq,
+			 irq_hw_number_t hwirq)
+{
+	struct asic2_irq *irq = domain->host_data;
+	unsigned int base = hwirq / 32 * ASIC2_KPIO_BASE;
+	unsigned int type = IRQ_TYPE_LEVEL_HIGH, value;
+	u32 bit = BIT(hwirq % 32);
+	bool edge;
+	int ret;
+
+	if (!asic2_irq_valid(hwirq))
+		return -EINVAL;
+	if (hwirq < 48) {
+		ret = regmap_read(irq->map, base + ASIC2_IRQ_TYPE, &value);
+		if (ret)
+			return ret;
+		edge = value & bit;
+		ret = regmap_read(irq->map, base + (edge ? ASIC2_IRQ_EDGE : ASIC2_IRQ_LEVEL),
+				  &value);
+		if (ret)
+			return ret;
+		type = edge ? (value & bit ? IRQ_TYPE_EDGE_RISING : IRQ_TYPE_EDGE_FALLING) :
+			      (value & bit ? IRQ_TYPE_LEVEL_HIGH : IRQ_TYPE_LEVEL_LOW);
+	}
+	irq_set_chip_data(virq, irq);
+	irq_set_chip_and_handler(virq, &asic2_irq_chip, handle_level_irq);
+	/* Set matching flow/type bookkeeping without changing inherited selectors. */
+	return irq_set_irq_type(virq, type);
+}
+
+static const struct irq_domain_ops asic2_irq_domain_ops = {
+	.map = asic2_irq_map,
+	.xlate = irq_domain_xlate_twocell,
+};
+
+static void asic2_irq_dispatch(struct asic2_irq *irq)
+{
+	unsigned int gpio = 0, kpio = 0, bank, loop;
+	unsigned long flags, pending;
+	int ret, kpio_ret;
+
+	for (loop = 0; loop < ASIC2_IRQ_DRAIN_LIMIT; loop++) {
+		raw_spin_lock_irqsave(&irq->lock, flags);
+		ret = regmap_read(irq->map, ASIC2_IRQ_PENDING, &gpio);
+		if (!ret)
+			ret = regmap_read(irq->map, ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING, &kpio);
+		gpio &= irq->enabled[0];
+		kpio &= irq->enabled[1];
+		raw_spin_unlock_irqrestore(&irq->lock, flags);
+		if (ret) {
+			dev_err_ratelimited(irq->dev, "IRQ status read failed: %d\n", ret);
+			return;
+		}
+		if (!(gpio | kpio))
+			return;
+		for (bank = 0; bank < 2; bank++) {
+			pending = bank ? kpio : gpio;
+			while (pending) {
+				unsigned int bit = __ffs(pending);
+
+				generic_handle_domain_irq(irq->domain, bank * 32 + bit);
+				pending &= ~BIT(bit);
+			}
+		}
+	}
+	/* Quiesce the final repeatedly active sources; leave other users enabled. */
+	raw_spin_lock_irqsave(&irq->lock, flags);
+	irq->enabled[0] &= ~gpio;
+	irq->enabled[1] &= ~kpio;
+	ret = asic2_irq_write_enable(irq, 0, irq->enabled[0]);
+	kpio_ret = asic2_irq_write_enable(irq, 1, irq->enabled[1]);
+	if (!ret)
+		ret = kpio_ret;
+	raw_spin_unlock_irqrestore(&irq->lock, flags);
+	dev_warn_ratelimited(irq->dev, "IRQ processing exceeded %u passes; masked %08x/%08x\n",
+			     loop, gpio, kpio);
+	if (ret)
+		dev_err_ratelimited(irq->dev, "IRQ storm mask write failed: %d\n", ret);
+}
+
+static void asic2_irq_chained(struct irq_desc *desc)
+{
+	struct asic2_irq *irq = irq_desc_get_handler_data(desc);
+	struct irq_chip *chip = irq_desc_get_chip(desc);
+
+	chained_irq_enter(chip, desc);
+	asic2_irq_dispatch(irq);
+	chained_irq_exit(chip, desc);
+}
+
+static void asic2_irq_remove(void *data)
+{
+	struct asic2_irq *irq = data;
+	unsigned int hwirq, virq;
+
+	smp_store_release(&irq->ready, false);
+	if (irq->chained) {
+		irq_set_chained_handler_and_data(irq->parent_irq, NULL, NULL);
+		synchronize_irq(irq->parent_irq);
+		/* Chained handlers do not set the normal action in-progress flag. */
+		synchronize_rcu();
+	}
+	if (irq->gpio->irq.domain == irq->domain) {
+		irq->gpio->irq.initialized = false;
+		irq->gpio->irq.domain = NULL;
+	}
+	regmap_update_bits(irq->map, ASIC2_IRQ_ENABLE, ASIC2_GPIO_IRQ_MASK, 0);
+	regmap_write(irq->map, ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE, 0);
+	for (hwirq = 0; hwirq < ASIC2_IRQ_COUNT; hwirq++) {
+		virq = irq_find_mapping(irq->domain, hwirq);
+		if (virq)
+			irq_dispose_mapping(virq);
+	}
+	irq_domain_remove(irq->domain);
+}
+
+struct irq_domain *devm_asic2_irq_register(struct device *dev, struct regmap *map,
+					   struct gpio_chip *gpio, int parent_irq,
+					   struct module *owner)
+{
+	struct asic2_irq *irq;
+	int ret;
+
+	if (parent_irq <= 0 || !gpio || gpio->ngpio != 16 ||
+	    regmap_get_val_bytes(map) != 4 || regmap_might_sleep(map))
+		return ERR_PTR(-EINVAL);
+	irq = devm_kzalloc(dev, sizeof(*irq), GFP_KERNEL);
+	if (!irq)
+		return ERR_PTR(-ENOMEM);
+	irq->dev = dev;
+	irq->map = map;
+	irq->gpio = gpio;
+	irq->owner = owner;
+	irq->parent_irq = parent_irq;
+	raw_spin_lock_init(&irq->lock);
+	irq->domain = irq_domain_create_linear(dev_fwnode(dev), ASIC2_IRQ_COUNT,
+					       &asic2_irq_domain_ops, irq);
+	if (!irq->domain)
+		return ERR_PTR(-ENOMEM);
+	ret = devm_add_action_or_reset(dev, asic2_irq_remove, irq);
+	if (ret)
+		return ERR_PTR(ret);
+
+	/* Explicit controller ownership: start masked, then discard stale pending. */
+	ret = regmap_update_bits(map, ASIC2_IRQ_ENABLE, ASIC2_GPIO_IRQ_MASK, 0);
+	if (!ret)
+		ret = regmap_write(map, ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE, 0);
+	if (!ret)
+		ret = regmap_write(map, ASIC2_IRQ_PENDING, ASIC2_GPIO_IRQ_MASK);
+	if (!ret)
+		ret = regmap_write(map, ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING, ASIC2_KPIO_IRQ_MASK);
+	if (ret)
+		return ERR_PTR(ret);
+	ret = gpiochip_irqchip_add_domain(gpio, irq->domain);
+	if (ret)
+		return ERR_PTR(ret);
+
+	/* Do not reset GPIO/data, the global mask/reset flags or firmware timebase. */
+	irq_set_chained_handler_and_data(parent_irq, asic2_irq_chained, irq);
+	irq->chained = true;
+	smp_store_release(&irq->ready, true);
+	return irq->domain;
+}
+EXPORT_SYMBOL_GPL(devm_asic2_irq_register);
+
+MODULE_DESCRIPTION("Compaq ASIC2 GPIO and KPIO interrupt controller");
+MODULE_LICENSE("GPL");
+
+#if IS_ENABLED(CONFIG_COMPAQ_ASIC2_IRQ_KUNIT_TEST)
+#include "irq-asic2-test.c"
+#endif
