+}
+
+static void asic2_touch_channels_check(struct kunit *test, unsigned int x,
+				      unsigned int y, bool foreign, bool ready,
+				      int expected)
+{
+	static const struct iio_info info;
+	static const struct iio_chan_spec channels[] = {
+		{ .type = IIO_VOLTAGE, .indexed = 1, .channel = 0 },
+		{ .type = IIO_VOLTAGE, .indexed = 1, .channel = 1 },
+		{ .type = IIO_VOLTAGE, .indexed = 1, .channel = 2 },
+		{ .type = IIO_VOLTAGE, .indexed = 1, .channel = 3 },
+		{ .type = IIO_VOLTAGE, .indexed = 1, .channel = 4 },
+	};
+	static const struct property_entry adc_props[] = {
+		PROPERTY_ENTRY_U32("#io-channel-cells", 1), {}
+	};
+	static const char * const names[] = { "x", "y" };
+	struct device *parent = kunit_device_register(test, "asic2-channel-parent");
+	struct device *other = kunit_device_register(test, "asic2-channel-other");
+	struct platform_device *adc, *consumer;
+	struct software_node *adc_node;
+	struct h3970_touch touch = {};
+	struct iio_dev *indio;
+	int ret;
+
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, parent);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, other);
+	/* IIO and its parent share this node. Managed software nodes are removed
+	 * by each device notification, so retain an explicit nonmanaged lifetime.
+	 */
+	adc_node = kunit_kzalloc(test, sizeof(*adc_node), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, adc_node);
+	adc_node->properties = adc_props;
+	KUNIT_ASSERT_EQ(test, software_node_register(adc_node), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+		asic2_touch_channel_node_remove, adc_node), 0);
+	adc = asic2_touch_channel_device(test, parent, "asic2-channel-adc");
+	KUNIT_ASSERT_EQ(test, device_add_software_node(&adc->dev, adc_node), 0);
+	KUNIT_ASSERT_EQ(test, devm_add_action_or_reset(&adc->dev,
+		asic2_touch_channel_node_detach, &adc->dev), 0);
+	consumer = asic2_touch_channel_device(test, foreign ? other : parent,
+					     "asic2-channel-touch");
+	if (ready) {
+		indio = devm_iio_device_alloc(&adc->dev, 0);
+		KUNIT_ASSERT_NOT_NULL(test, indio);
+		indio->name = "asic2-channel-fixture";
+		indio->info = &info;
+		indio->modes = INDIO_DIRECT_MODE;
+		indio->channels = channels;
+		indio->num_channels = ARRAY_SIZE(channels);
+		KUNIT_ASSERT_EQ(test, devm_iio_device_register(&adc->dev, indio), 0);
+	}
+	{
+		const struct software_node *node = to_software_node(dev_fwnode(&adc->dev));
+		const struct software_node_ref_args refs[] = {
+			{ .node = node, .nargs = 1, .args = { x } },
+			{ .node = node, .nargs = 1, .args = { y } },
+		};
+		const struct property_entry props[] = {
+			PROPERTY_ENTRY_REF_ARRAY("io-channels", refs),
+			PROPERTY_ENTRY_STRING_ARRAY("io-channel-names", names), {}
+		};
+
+		KUNIT_ASSERT_EQ(test, device_create_managed_software_node(&consumer->dev,
+								props, NULL), 0);
+	}
+	ret = asic2_touch_get_channels(&consumer->dev, &touch);
+	KUNIT_EXPECT_EQ(test, ret, expected);
+	if (!ret) {
+		KUNIT_EXPECT_EQ(test, touch.x_channel, x);
+		KUNIT_EXPECT_EQ(test, touch.y_channel, y);
+	}
+}
+
+static void asic2_touch_channels_mapping(struct kunit *test)
+{
+	asic2_touch_channels_check(test, 4, 3, false, true, 0);
+}
+
+static void asic2_touch_channels_foreign(struct kunit *test)
+{
+	asic2_touch_channels_check(test, 3, 4, true, true, -EINVAL);
+}
+
+static void asic2_touch_channels_duplicate(struct kunit *test)
+{
+	asic2_touch_channels_check(test, 3, 3, false, true, -EINVAL);
+}
+
+static void asic2_touch_channels_defer(struct kunit *test)
+{
+	asic2_touch_channels_check(test, 3, 4, false, false, -EPROBE_DEFER);
+}
+
+static void asic2_touch_channels_compat(struct kunit *test)
+{
