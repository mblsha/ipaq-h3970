diff --git a/drivers/regulator/core-test.c b/drivers/regulator/core-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..2fb01a3b0a8bbf63de8b0397230ec0a6438634b5
--- /dev/null
+++ b/drivers/regulator/core-test.c
@@ -0,0 +1,352 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Consumer lifetime contracts using real regulator/workqueue accounting. */
+#include <kunit/device.h>
+#include <kunit/test.h>
+#include <linux/completion.h>
+#include <linux/jiffies.h>
+#include <linux/kthread.h>
+#include <linux/regulator/consumer.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/machine.h>
+
+struct regulator_lifetime_test {
+	struct regulator_dev *rdev;
+	struct device *consumer;
+	struct device *other_consumer;
+	bool enabled;
+	unsigned int enables;
+	unsigned int disables;
+	unsigned int fail_disables;
+	struct completion disable_attempted;
+	struct completion disabled;
+	unsigned long disabled_at;
+};
+
+struct regulator_put_thread {
+	struct regulator *regulator;
+	struct completion entered;
+	struct completion done;
+};
+
+static int lifetime_enable(struct regulator_dev *rdev)
+{
+	struct regulator_lifetime_test *ctx = rdev_get_drvdata(rdev);
+
+	ctx->enabled = true;
+	ctx->enables++;
+	return 0;
+}
+
+static int lifetime_disable(struct regulator_dev *rdev)
+{
+	struct regulator_lifetime_test *ctx = rdev_get_drvdata(rdev);
+
+	if (ctx->fail_disables) {
+		ctx->fail_disables--;
+		complete(&ctx->disable_attempted);
+		return -EIO;
+	}
+	ctx->enabled = false;
+	ctx->disables++;
+	ctx->disabled_at = jiffies;
+	complete(&ctx->disabled);
+	return 0;
+}
+
+static int lifetime_is_enabled(struct regulator_dev *rdev)
+{
+	struct regulator_lifetime_test *ctx = rdev_get_drvdata(rdev);
+
+	return ctx->enabled;
+}
+
+static const struct regulator_ops lifetime_ops = {
+	.enable = lifetime_enable,
+	.disable = lifetime_disable,
+	.is_enabled = lifetime_is_enabled,
+};
+
+static int lifetime_test_init(struct kunit *test)
+{
+	static const struct regulator_desc desc = {
+		.name = "regulator-lifetime-test",
+		.type = REGULATOR_VOLTAGE,
+		.owner = THIS_MODULE,
+		.ops = &lifetime_ops,
+	};
+	struct regulator_consumer_supply supplies[] = {
+		{ .supply = "VCC" }, { .supply = "VCC" },
+	};
+	struct regulator_init_data init = {
+		.constraints.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+		.num_consumer_supplies = ARRAY_SIZE(supplies),
+		.consumer_supplies = supplies,
+	};
+	struct regulator_config config = { .init_data = &init };
+	struct regulator_lifetime_test *ctx;
+	struct device *dev;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	test->priv = ctx;
+	init_completion(&ctx->disable_attempted);
+	init_completion(&ctx->disabled);
+	dev = kunit_device_register(test, "reg-life-provider");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	ctx->consumer = kunit_device_register(test, "reg-life-a");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->consumer);
+	ctx->other_consumer = kunit_device_register(test, "reg-life-b");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->other_consumer);
+	supplies[0].dev_name = dev_name(ctx->consumer);
+	supplies[1].dev_name = dev_name(ctx->other_consumer);
+	config.dev = dev;
+	config.driver_data = ctx;
+	ctx->rdev = devm_regulator_register(dev, &desc, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->rdev);
+	return 0;
+}
+
+static int lifetime_put_thread(void *data)
+{
+	struct regulator_put_thread *put = data;
+
+	complete(&put->entered);
+	regulator_put(put->regulator);
+	complete(&put->done);
+	for (;;) {
+		set_current_state(TASK_INTERRUPTIBLE);
+		if (kthread_should_stop())
+			break;
+		schedule();
+	}
+	__set_current_state(TASK_RUNNING);
+	return 0;
+}
+
+static void lifetime_stop_thread(void *data)
+{
+	kthread_stop(data);
+}
+
+static struct regulator_put_thread *lifetime_start_put(struct kunit *test,
+						      struct regulator *regulator)
+{
+	struct regulator_put_thread *put;
+	struct task_struct *task;
+
+	put = kunit_kzalloc(test, sizeof(*put), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, put);
+	put->regulator = regulator;
+	init_completion(&put->entered);
+	init_completion(&put->done);
+	task = kthread_run(lifetime_put_thread, put, "regulator-put-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, task);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, lifetime_stop_thread, task), 0);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&put->entered, HZ), 0UL);
+	return put;
+}
+
+static void lifetime_put_waits_for_deferred_disable(struct kunit *test)
+{
+	struct regulator_lifetime_test *ctx = test->priv;
+	struct regulator_put_thread *put;
+	struct regulator *regulator;
+	unsigned long requested;
+
+	regulator = regulator_get(ctx->consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, regulator);
+	KUNIT_ASSERT_EQ(test, regulator_enable(regulator), 0);
+	requested = jiffies;
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(regulator, 200), 0);
+	put = lifetime_start_put(test, regulator);
+	KUNIT_EXPECT_EQ(test, wait_for_completion_timeout(&put->done, msecs_to_jiffies(20)), 0UL);
+	KUNIT_EXPECT_TRUE(test, READ_ONCE(ctx->enabled));
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&put->done, 2 * HZ), 0UL);
+	KUNIT_EXPECT_FALSE(test, ctx->enabled);
+	KUNIT_EXPECT_EQ(test, ctx->enables, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->disables, 1U);
+	KUNIT_EXPECT_FALSE(test, time_before(ctx->disabled_at, requested + msecs_to_jiffies(200)));
+	KUNIT_EXPECT_EQ(test, ctx->rdev->use_count, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 0U);
+}
+
+static void lifetime_multiple_pending_disables_are_balanced(struct kunit *test)
+{
+	struct regulator_lifetime_test *ctx = test->priv;
+	struct regulator_put_thread *put;
+	struct regulator *regulator;
+
+	regulator = regulator_get(ctx->consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, regulator);
+	for (int i = 0; i < 3; i++)
+		KUNIT_ASSERT_EQ(test, regulator_enable(regulator), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(regulator, 200), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(regulator, 200), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable(regulator), 0);
+	put = lifetime_start_put(test, regulator);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&put->done, 2 * HZ), 0UL);
+	KUNIT_EXPECT_FALSE(test, ctx->enabled);
+	KUNIT_EXPECT_EQ(test, ctx->disables, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->use_count, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 0U);
+}
+
+static void lifetime_other_consumer_keeps_supply_enabled(struct kunit *test)
+{
+	struct regulator_lifetime_test *ctx = test->priv;
+	struct regulator_put_thread *put;
+	struct regulator *first, *second;
+
+	first = regulator_get(ctx->consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, first);
+	second = regulator_get(ctx->other_consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, second);
+	KUNIT_ASSERT_EQ(test, regulator_enable(first), 0);
+	KUNIT_ASSERT_EQ(test, regulator_enable(second), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(first, 200), 0);
+	put = lifetime_start_put(test, first);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&put->done, 2 * HZ), 0UL);
+	KUNIT_EXPECT_TRUE(test, ctx->enabled);
+	KUNIT_EXPECT_EQ(test, ctx->disables, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->use_count, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 1U);
+	KUNIT_ASSERT_EQ(test, regulator_disable(second), 0);
+	regulator_put(second);
+	KUNIT_EXPECT_FALSE(test, ctx->enabled);
+	KUNIT_EXPECT_EQ(test, ctx->disables, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 0U);
+}
+
+static void lifetime_completed_disable_does_not_leave_a_wait(struct kunit *test)
+{
+	struct regulator_lifetime_test *ctx = test->priv;
+	struct regulator *regulator;
+
+	regulator = regulator_get(ctx->consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, regulator);
+	KUNIT_ASSERT_EQ(test, regulator_enable(regulator), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(regulator, 1), 0);
+	/* Observe completion through the real provider, without a timing sleep. */
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&ctx->disabled, HZ), 0UL);
+	KUNIT_ASSERT_FALSE(test, READ_ONCE(ctx->enabled));
+	regulator_put(regulator);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 0U);
+}
+
+static void lifetime_two_pending_consumers_release_together(struct kunit *test)
+{
+	struct regulator_lifetime_test *ctx = test->priv;
+	struct regulator_put_thread *first_put, *second_put;
+	struct regulator *first, *second;
+
+	first = regulator_get(ctx->consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, first);
+	second = regulator_get(ctx->other_consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, second);
+	KUNIT_ASSERT_EQ(test, regulator_enable(first), 0);
+	KUNIT_ASSERT_EQ(test, regulator_enable(second), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(first, 200), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(second, 200), 0);
+	first_put = lifetime_start_put(test, first);
+	second_put = lifetime_start_put(test, second);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&first_put->done, 2 * HZ), 0UL);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&second_put->done, 2 * HZ), 0UL);
+	KUNIT_EXPECT_FALSE(test, ctx->enabled);
+	KUNIT_EXPECT_EQ(test, ctx->disables, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->use_count, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 0U);
+}
+
+static void lifetime_completed_cycle_can_defer_again(struct kunit *test)
+{
+	struct regulator_lifetime_test *ctx = test->priv;
+	struct regulator_put_thread *put;
+	struct regulator *regulator;
+
+	regulator = regulator_get(ctx->consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, regulator);
+	KUNIT_ASSERT_EQ(test, regulator_enable(regulator), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(regulator, 1), 0);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&ctx->disabled, HZ), 0UL);
+	KUNIT_ASSERT_FALSE(test, READ_ONCE(ctx->enabled));
+	KUNIT_ASSERT_EQ(test, regulator_enable(regulator), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(regulator, 200), 0);
+	put = lifetime_start_put(test, regulator);
+	KUNIT_EXPECT_EQ(test, wait_for_completion_timeout(&put->done, msecs_to_jiffies(20)), 0UL);
+	KUNIT_EXPECT_TRUE(test, READ_ONCE(ctx->enabled));
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&put->done, 2 * HZ), 0UL);
+	KUNIT_EXPECT_FALSE(test, ctx->enabled);
+	KUNIT_EXPECT_EQ(test, ctx->disables, 2U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 0U);
+}
+
+static void lifetime_synchronous_disable_stays_balanced(struct kunit *test)
+{
+	struct regulator_lifetime_test *ctx = test->priv;
+	struct regulator *regulator;
+
+	regulator = regulator_get(ctx->consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, regulator);
+	KUNIT_ASSERT_EQ(test, regulator_enable(regulator), 0);
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(regulator, 0), 0);
+	KUNIT_EXPECT_FALSE(test, ctx->enabled);
+	regulator_put(regulator);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 0U);
+}
+
+static void lifetime_failed_deferred_disable_can_be_retried(struct kunit *test)
+{
+	struct regulator_lifetime_test *ctx = test->priv;
+	struct regulator *regulator;
+
+	regulator = regulator_get(ctx->consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, regulator);
+	KUNIT_ASSERT_EQ(test, regulator_enable(regulator), 0);
+	ctx->fail_disables = 1;
+	KUNIT_ASSERT_EQ(test, regulator_disable_deferred(regulator, 1), 0);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&ctx->disable_attempted, HZ), 0UL);
+	KUNIT_EXPECT_TRUE(test, ctx->enabled);
+	/* A failed disable remains enabled and must be retried before release. */
+	KUNIT_ASSERT_EQ(test, regulator_disable(regulator), 0);
+	regulator_put(regulator);
+	KUNIT_EXPECT_FALSE(test, ctx->enabled);
+	KUNIT_EXPECT_EQ(test, ctx->disables, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 0U);
+}
+
+static void lifetime_unused_handle_releases_immediately(struct kunit *test)
+{
+	struct regulator_lifetime_test *ctx = test->priv;
+	struct regulator *regulator;
+
+	regulator = regulator_get(ctx->consumer, "VCC");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, regulator);
+	regulator_put(regulator);
+	regulator_put(NULL);
+	regulator_put(ERR_PTR(-ENODEV));
+	KUNIT_EXPECT_EQ(test, ctx->enables, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->rdev->open_count, 0U);
+}
+
+static struct kunit_case lifetime_test_cases[] = {
+	KUNIT_CASE(lifetime_put_waits_for_deferred_disable),
+	KUNIT_CASE(lifetime_multiple_pending_disables_are_balanced),
+	KUNIT_CASE(lifetime_other_consumer_keeps_supply_enabled),
+	KUNIT_CASE(lifetime_two_pending_consumers_release_together),
+	KUNIT_CASE(lifetime_completed_disable_does_not_leave_a_wait),
+	KUNIT_CASE(lifetime_completed_cycle_can_defer_again),
+	KUNIT_CASE(lifetime_synchronous_disable_stays_balanced),
+	KUNIT_CASE(lifetime_failed_deferred_disable_can_be_retried),
+	KUNIT_CASE(lifetime_unused_handle_releases_immediately),
+	{}
+};
+
+static struct kunit_suite lifetime_test_suite = {
+	.name = "regulator-consumer-lifetime",
+	.init = lifetime_test_init,
+	.test_cases = lifetime_test_cases,
+};
+kunit_test_suite(lifetime_test_suite);
+
+MODULE_DESCRIPTION("Regulator consumer lifetime tests");
+MODULE_LICENSE("GPL");
