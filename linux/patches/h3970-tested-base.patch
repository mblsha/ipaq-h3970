diff --git a/drivers/iio/adc/compaq-asic2-adc-test.c b/drivers/iio/adc/compaq-asic2-adc-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..f3acedbb179928be668d9486cfaa5d2ccf6416ed
--- /dev/null
+++ b/drivers/iio/adc/compaq-asic2-adc-test.c
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fake registers check software contracts, not electrical ADC behavior. */
+#include <kunit/test.h>
+#include <linux/completion.h>
+#include <linux/iio/consumer.h>
+#include <linux/kthread.h>
+#include <linux/regmap.h>
+
+struct compaq_adc_test {
+	struct compaq_asic2_adc adc;
+	struct iio_dev *indio;
+	unsigned int regs[0x2000 / 4];
+	struct { unsigned int reg, value; } writes[128];
+	unsigned int count, conversions, data_reads, busy_reads, sample;
+	unsigned int fail_reg, fail_value;
+	bool fail_read, fail_write, timeout;
+};
+
+static int compaq_adc_test_read(void *data, unsigned int reg, unsigned int *value)
+{
+	struct compaq_adc_test *ctx = data;
+
+	if (ctx->fail_read && reg == ctx->fail_reg)
+		return -EIO;
+	if (reg == ctx->adc.base + 4 && (ctx->regs[reg / 4] & BIT(6))) {
+		if (!ctx->timeout && ctx->busy_reads++) {
+			ctx->regs[reg / 4] &= ~BIT(6);
+			ctx->conversions++;
+			ctx->regs[(ctx->adc.base + 8) / 4] = ctx->sample + ctx->conversions;
+		}
+	}
+	if (reg == ctx->adc.base + 8)
+		ctx->data_reads++;
+	*value = ctx->regs[reg / 4];
+	return 0;
+}
+
+static int compaq_adc_test_write(void *data, unsigned int reg, unsigned int value)
+{
+	struct compaq_adc_test *ctx = data;
+
+	if (ctx->count < ARRAY_SIZE(ctx->writes)) {
+		ctx->writes[ctx->count].reg = reg;
+		ctx->writes[ctx->count].value = value;
+	}
+	ctx->count++;
+	if (ctx->fail_write && reg == ctx->fail_reg && value == ctx->fail_value)
+		return -EIO;
+	ctx->regs[reg / 4] = value;
+	if (reg == ctx->adc.base + 4 && (value & BIT(6)))
+		ctx->busy_reads = 0;
+	return 0;
+}
+
+static const struct regmap_bus compaq_adc_test_bus = {
+	.fast_io = true,
+	.reg_read = compaq_adc_test_read,
+	.reg_write = compaq_adc_test_write,
+};
+
+static void compaq_adc_test_unregister(void *dev)
+{
+	root_device_unregister(dev);
+}
+
+static int compaq_adc_test_init(struct kunit *test)
+{
+	static const struct regmap_config config = {
+		.reg_bits = 32, .val_bits = 32, .reg_stride = 4,
+		.max_register = 0x1ffc,
+	};
+	struct compaq_adc_test *ctx;
+	struct device *dev;
+	int ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	dev = root_device_register("compaq-adc-kunit");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	ret = kunit_add_action_or_reset(test, compaq_adc_test_unregister, dev);
+	if (ret)
+		return ret;
+	ctx->adc.base = 0x1200;
+	mutex_init(&ctx->adc.lock);
+	ctx->adc.map = devm_regmap_init(dev, &compaq_adc_test_bus, ctx, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->adc.map);
+	ctx->indio = compaq_adc_register(dev, &ctx->adc);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->indio);
+	test->priv = ctx;
+	return 0;
+}
+
+static int compaq_adc_test_raw(struct compaq_adc_test *ctx, unsigned int index, int *value)
+{
+	struct iio_channel channel = {
+		.indio_dev = ctx->indio,
+		.channel = &compaq_adc_channels[index],
+	};
+
+	return iio_read_channel_raw(&channel, value);
+}
+
+static void compaq_adc_registration_and_channels(struct kunit *test)
+{
+	struct compaq_adc_test *ctx = test->priv;
+	unsigned int i;
+	int value;
+
+	KUNIT_EXPECT_EQ(test, ctx->count, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->indio->num_channels, 5);
+	for (i = 0; i < 5; i++) {
+		ctx->count = 0;
+		ctx->conversions = 0;
+		ctx->data_reads = 0;
+		ctx->sample = 0x8000 | (i * 255);
+		KUNIT_ASSERT_EQ(test, compaq_adc_test_raw(ctx, i, &value), IIO_VAL_INT);
+		KUNIT_EXPECT_EQ(test, value, (int)((i * 255 + 4) & 0x3ff));
+		KUNIT_EXPECT_EQ(test, ctx->conversions, 4U);
+		KUNIT_EXPECT_EQ(test, ctx->data_reads, 1U);
+		KUNIT_ASSERT_EQ(test, ctx->count, 11U);
+		KUNIT_EXPECT_EQ(test, ctx->writes[0].reg, ctx->adc.base);
+		KUNIT_EXPECT_EQ(test, ctx->writes[0].value, i | 8);
+		KUNIT_EXPECT_EQ(test, ctx->writes[9].reg, ctx->adc.base + 4);
+		KUNIT_EXPECT_EQ(test, ctx->writes[9].value, 0U);
+		KUNIT_EXPECT_EQ(test, ctx->writes[10].reg, ctx->adc.base);
+		KUNIT_EXPECT_EQ(test, ctx->writes[10].value, 0U);
+	}
+}
+
+static void compaq_adc_conversion_order_and_legacy_offset(struct kunit *test)
+{
+	struct compaq_adc_test *ctx = test->priv;
+	unsigned int offset, i;
+	int value;
+
+	/* The legacy touchscreen adapter uses the same service at offset zero. */
+	for (offset = 0; offset <= 0x1200; offset += 0x1200) {
+		ctx->adc.base = offset;
+		ctx->count = 0;
+		ctx->conversions = 0;
+		ctx->data_reads = 0;
+		ctx->sample = offset ? 1019 : 1020;
+		KUNIT_ASSERT_EQ(test, compaq_adc_test_raw(ctx, 3, &value), IIO_VAL_INT);
+		KUNIT_EXPECT_EQ(test, value, offset ? 1023 : 0);
+		for (i = 0; i < 4; i++) {
+			KUNIT_EXPECT_EQ(test, ctx->writes[1 + 2 * i].reg, offset + 4);
+			KUNIT_EXPECT_EQ(test, ctx->writes[1 + 2 * i].value, 0x84U);
+			KUNIT_EXPECT_EQ(test, ctx->writes[2 + 2 * i].reg, offset + 4);
+			KUNIT_EXPECT_EQ(test, ctx->writes[2 + 2 * i].value, 0xc4U);
+		}
+	}
+}
+
+static void compaq_adc_invalid_requests(struct kunit *test)
+{
+	struct compaq_adc_test *ctx = test->priv;
+	int value, value2, ret;
+
+	mutex_lock(&ctx->adc.lock);
+	ret = compaq_asic2_adc_read_locked(&ctx->adc, 5);
+	mutex_unlock(&ctx->adc.lock);
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	KUNIT_EXPECT_EQ(test, compaq_adc_read_raw(ctx->indio, compaq_adc_channels,
+						  &value, &value2, IIO_CHAN_INFO_SCALE), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ctx->count, 0U);
+}
+
+static void compaq_adc_timeout_cleans_up(struct kunit *test)
+{
+	struct compaq_adc_test *ctx = test->priv;
+	int value = -1;
+
+	ctx->timeout = true;
+	KUNIT_EXPECT_EQ(test, compaq_adc_test_raw(ctx, 0, &value), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, value, -1);
+	KUNIT_EXPECT_EQ(test, ctx->data_reads, 0U);
+	KUNIT_ASSERT_EQ(test, ctx->count, 5U);
+	KUNIT_EXPECT_EQ(test, ctx->writes[3].value, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->writes[4].value, 0U);
+}
+
+static void compaq_adc_bus_errors_and_cleanup(struct kunit *test)
+{
+	struct compaq_adc_test *ctx = test->priv;
+	static const struct {
+		unsigned int offset, value;
+		bool write;
+	} failures[] = {
+		{ 0, 8, true }, { 4, 0x84, true }, { 4, 0xc4, true },
+		{ 4, 0, false }, { 8, 0, false }, { 4, 0, true }, { 0, 0, true },
+	};
+	unsigned int i;
+	int value;
+
+	for (i = 0; i < ARRAY_SIZE(failures); i++) {
+		ctx->count = 0;
+		ctx->fail_reg = ctx->adc.base + failures[i].offset;
+		ctx->fail_value = failures[i].value;
+		ctx->fail_read = !failures[i].write;
+		ctx->fail_write = failures[i].write;
+		KUNIT_EXPECT_EQ(test, compaq_adc_test_raw(ctx, 0, &value), -EIO);
+		KUNIT_ASSERT_GE(test, ctx->count, 3U);
+		KUNIT_EXPECT_EQ(test, ctx->writes[ctx->count - 2].reg, ctx->adc.base + 4);
+		KUNIT_EXPECT_EQ(test, ctx->writes[ctx->count - 2].value, 0U);
+		KUNIT_EXPECT_EQ(test, ctx->writes[ctx->count - 1].reg, ctx->adc.base);
+		KUNIT_EXPECT_EQ(test, ctx->writes[ctx->count - 1].value, 0U);
+	}
+}
+
+struct compaq_adc_reader {
+	struct compaq_adc_test *ctx;
+	struct completion ready, done;
+	int ret, value;
+};
+
+static int compaq_adc_test_reader(void *data)
+{
+	struct compaq_adc_reader *reader = data;
+
+	complete(&reader->ready);
+	reader->ret = compaq_adc_test_raw(reader->ctx, 0, &reader->value);
+	complete(&reader->done);
+	set_current_state(TASK_INTERRUPTIBLE);
+	while (!kthread_should_stop()) {
+		schedule();
+		set_current_state(TASK_INTERRUPTIBLE);
+	}
+	__set_current_state(TASK_RUNNING);
+	return 0;
+}
+
+static void compaq_adc_transaction_arbitration(struct kunit *test)
+{
+	struct compaq_adc_test *ctx = test->priv;
+	struct compaq_adc_reader reader = { .ctx = ctx };
+	struct task_struct *task;
+	unsigned long ready, done;
+	unsigned int boundary;
+	int x, y;
+
+	init_completion(&reader.ready);
+	init_completion(&reader.done);
+	mutex_lock(&ctx->adc.lock);
+	task = kthread_run(compaq_adc_test_reader, &reader, "compaq-adc-reader");
+	if (IS_ERR(task)) {
+		mutex_unlock(&ctx->adc.lock);
+		KUNIT_FAIL(test, "could not start ADC reader");
+		return;
+	}
+	ready = wait_for_completion_timeout(&reader.ready, HZ);
+	/* Model the external panel-drive writes inside the same transaction. */
+	regmap_write(ctx->adc.map, 0x14, 0xc);
+	x = compaq_asic2_adc_read_locked(&ctx->adc, 3);
+	regmap_write(ctx->adc.map, 0x14, 3);
+	y = compaq_asic2_adc_read_locked(&ctx->adc, 4);
+	compaq_asic2_adc_stop_locked(&ctx->adc);
+	regmap_write(ctx->adc.map, 0x14, 0xb);
+	boundary = ctx->count;
+	KUNIT_EXPECT_FALSE(test, completion_done(&reader.done));
+	mutex_unlock(&ctx->adc.lock);
+	done = wait_for_completion_timeout(&reader.done, HZ);
+	kthread_stop(task);
+	KUNIT_EXPECT_NE(test, ready, 0UL);
+	KUNIT_ASSERT_NE(test, done, 0UL);
+	KUNIT_EXPECT_GE(test, x, 0);
+	KUNIT_EXPECT_GE(test, y, 0);
+	KUNIT_EXPECT_EQ(test, reader.ret, IIO_VAL_INT);
+	KUNIT_ASSERT_EQ(test, boundary, 23U);
+	KUNIT_ASSERT_EQ(test, ctx->count, 34U);
+	KUNIT_EXPECT_EQ(test, ctx->writes[22].reg, 0x14U);
+	KUNIT_EXPECT_EQ(test, ctx->writes[22].value, 0xbU);
+	KUNIT_EXPECT_EQ(test, ctx->writes[23].reg, ctx->adc.base);
+	KUNIT_EXPECT_EQ(test, ctx->writes[23].value, 8U);
+}
+
+static struct kunit_case compaq_adc_test_cases[] = {
+	KUNIT_CASE(compaq_adc_registration_and_channels),
+	KUNIT_CASE(compaq_adc_conversion_order_and_legacy_offset),
+	KUNIT_CASE(compaq_adc_invalid_requests),
+	KUNIT_CASE(compaq_adc_timeout_cleans_up),
+	KUNIT_CASE(compaq_adc_bus_errors_and_cleanup),
+	KUNIT_CASE(compaq_adc_transaction_arbitration),
+	{}
+};
+
+static struct kunit_suite compaq_adc_test_suite = {
+	.name = "compaq-asic2-adc",
+	.init = compaq_adc_test_init,
+	.test_cases = compaq_adc_test_cases,
+};
+
+kunit_test_suite(compaq_adc_test_suite);
diff --git a/drivers/iio/adc/compaq-asic2-adc.c b/drivers/iio/adc/compaq-asic2-adc.c
new file mode 100644
index 0000000000000000000000000000000000000000..adbf3d2985ba2b434ecd23ac180e893fb85feda4
--- /dev/null
+++ b/drivers/iio/adc/compaq-asic2-adc.c
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Raw ADC inputs of the Compaq ASIC2 companion chip. */
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/iio/iio.h>
+#include <linux/mfd/compaq-asic.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+struct compaq_adc {
+	struct compaq_asic2_adc *adc;
+};
+
+static int compaq_adc_read_raw(struct iio_dev *indio_dev,
+			       const struct iio_chan_spec *channel,
+			       int *value, int *value2, long mask)
+{
+	struct compaq_adc *info = iio_priv(indio_dev);
+	struct compaq_asic2_adc *adc = info->adc;
+	int result, ret;
+
+	if (mask != IIO_CHAN_INFO_RAW)
+		return -EINVAL;
+	mutex_lock(&adc->lock);
+	result = compaq_asic2_adc_read_locked(adc, channel->channel);
+	ret = compaq_asic2_adc_stop_locked(adc);
+	mutex_unlock(&adc->lock);
+	if (result < 0)
+		return result;
+	if (ret)
+		return ret;
+	*value = result;
+	return IIO_VAL_INT;
+}
+
+static const struct iio_info compaq_adc_info = {
+	.read_raw = compaq_adc_read_raw,
+};
+
+#define COMPAQ_ADC_CHANNEL(index) { \
+	.type = IIO_VOLTAGE, \
+	.indexed = 1, \
+	.channel = (index), \
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW), \
+}
+
+static const struct iio_chan_spec compaq_adc_channels[] = {
+	COMPAQ_ADC_CHANNEL(0),
+	COMPAQ_ADC_CHANNEL(1),
+	COMPAQ_ADC_CHANNEL(2),
+	COMPAQ_ADC_CHANNEL(3),
+	COMPAQ_ADC_CHANNEL(4),
+};
+
+static struct iio_dev *compaq_adc_register(struct device *dev, struct compaq_asic2_adc *adc)
+{
+	struct iio_dev *indio_dev;
+	struct compaq_adc *info;
+	int ret;
+
+	indio_dev = devm_iio_device_alloc(dev, sizeof(*info));
+	if (!indio_dev)
+		return ERR_PTR(-ENOMEM);
+	info = iio_priv(indio_dev);
+	info->adc = adc;
+	indio_dev->name = "compaq-asic2-adc";
+	indio_dev->info = &compaq_adc_info;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	indio_dev->channels = compaq_adc_channels;
+	indio_dev->num_channels = ARRAY_SIZE(compaq_adc_channels);
+	ret = devm_iio_device_register(dev, indio_dev);
+	return ret ? ERR_PTR(ret) : indio_dev;
+}
+
+static int compaq_adc_probe(struct platform_device *pdev)
+{
+	struct compaq_asic *asic = compaq_asic_parent(&pdev->dev, COMPAQ_ASIC2);
+	struct clk *clock;
+
+	if (IS_ERR(asic))
+		return PTR_ERR(asic);
+	clock = devm_clk_get_enabled(&pdev->dev, "adc");
+	if (IS_ERR(clock))
+		return dev_err_probe(&pdev->dev, PTR_ERR(clock), "ADC clock\n");
+	/* Each client holds its own CCF reference; neither can stop the other. */
+	return PTR_ERR_OR_ZERO(compaq_adc_register(&pdev->dev, &asic->adc));
+}
+
+static const struct of_device_id compaq_adc_match[] = {
+	{ .compatible = "compaq,asic2-adc" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, compaq_adc_match);
+
+static struct platform_driver compaq_adc_driver = {
+	.probe = compaq_adc_probe,
+	.driver = {
+		.name = "compaq-asic2-adc",
+		.of_match_table = compaq_adc_match,
+	},
+};
+module_platform_driver(compaq_adc_driver);
+
+#if IS_ENABLED(CONFIG_COMPAQ_ASIC2_ADC_KUNIT_TEST)
+#include "compaq-asic2-adc-test.c"
+#endif
+
+MODULE_DESCRIPTION("Compaq ASIC2 shared raw ADC inputs");
+MODULE_LICENSE("GPL");
