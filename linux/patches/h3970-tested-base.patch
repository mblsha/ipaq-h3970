+	ctx->component.dev->platform_data = &pdata;
+	KUNIT_ASSERT_EQ(test, uda1380_get_resources(ctx->component.dev, &ctx->priv), 0);
+	ctx->component.dev->platform_data = NULL;
+	KUNIT_EXPECT_PTR_EQ(test, ctx->priv.sysclk, NULL);
+	KUNIT_EXPECT_EQ(test, desc_to_gpio(ctx->priv.reset), pdata.gpio_reset);
+	KUNIT_EXPECT_EQ(test, desc_to_gpio(ctx->priv.power), pdata.gpio_power);
+	KUNIT_EXPECT_EQ(test, ctx->gpio_values[0], 0);
+	KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 0);
+	KUNIT_ASSERT_EQ(test, uda1380_probe(&ctx->component), 0);
+	ctx->probed = true;
+	KUNIT_EXPECT_EQ(test, ctx->priv.reg_cache[UDA1380_CLK], (u16)R00_DAC_CLK);
