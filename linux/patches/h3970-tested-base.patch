+static void uda1380_legacy_platform_resources(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+	struct uda1380_platform_data pdata = {
+		.gpio_reset = ctx->gpio.base,
+		.gpio_power = ctx->gpio.base + 1,
+		.dac_clk = UDA1380_DAC_CLK_WSPLL,
+	};
