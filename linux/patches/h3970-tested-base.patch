+	KUNIT_CASE(uda1380_legacy_platform_resources),
+	KUNIT_CASE(uda1380_default_and_invalid_resources),
+	KUNIT_CASE(uda1380_software_reset_clock_order),
+	KUNIT_CASE(uda1380_gpio_polarity),
+	KUNIT_CASE(uda1380_i2c_component_registration),
+	KUNIT_CASE(uda1380_asoc_playback_routes),
+	KUNIT_CASE(uda1380_asoc_detach_pending_disable),
+	KUNIT_CASE(uda1380_asoc_detach_active_playback),
+	KUNIT_CASE(uda1380_asoc_card_rebind),
+	KUNIT_CASE(uda1380_offline_controls_and_shutdown),
+	KUNIT_CASE(uda1380_shutdown_joins_running_flush),
+	KUNIT_CASE(uda1380_dac_power_down_joins_running_flush),
+	KUNIT_CASE(uda1380_reserved_and_status_are_not_restored),
+	KUNIT_CASE(uda1380_gpio_supplier_defers),
+	KUNIT_CASE(uda1380_legacy_component_policy),
+	{}
+};
+
+static struct kunit_suite uda1380_test_suite = {
+	.name = "uda1380-resources",
+	.init = uda1380_test_init,
+	.test_cases = uda1380_test_cases,
+};
+
+kunit_test_suite(uda1380_test_suite);
