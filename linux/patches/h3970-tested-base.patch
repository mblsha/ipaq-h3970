@@ -0,0 +1,500 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Real IRQ/gpiolib machinery over fake bank semantics; no electrical model. */
+#include <kunit/device.h>
+#include <kunit/test.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio/machine.h>
+#include <linux/gpio/regmap.h>
+#include <linux/interrupt.h>
+#include <linux/irq_sim.h>
+#include <linux/irq_work.h>
+
+struct asic2_irq_test;
+struct asic2_irq_test_event {
+	struct asic2_irq_test *ctx;
+	unsigned int virq, count;
+	u32 inject_gpio, inject_kpio;
+};
+
+struct asic2_irq_test {
+	struct kunit *test;
+	struct device *provider;
+	struct gpio_chip *gpio;
+	struct regmap *map;
+	struct irq_domain *domain;
+	struct irq_work raise_work;
+	struct asic2_irq_test_event events[8];
+	unsigned int event_count, parent_irq;
+	u32 regs[0x2000 / 4];
+	struct { unsigned int reg, value; } writes[256];
+	unsigned int write_count, unsafe_reads, fail_read, fail_write;
+	u32 stuck_gpio;
+};
+
+static int asic2_irq_test_read(void *data, unsigned int reg, unsigned int *value)
+{
+	struct asic2_irq_test *ctx = data;
+
+	if (reg == ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE) {
+		ctx->unsafe_reads++;
+		return -EIO;
+	}
+	if (reg == ctx->fail_read)
+		return -EIO;
+	*value = ctx->regs[reg / 4];
+	return 0;
+}
+
+static int asic2_irq_test_write(void *data, unsigned int reg, unsigned int value)
+{
+	struct asic2_irq_test *ctx = data;
+
+	if (ctx->write_count < ARRAY_SIZE(ctx->writes)) {
+		ctx->writes[ctx->write_count].reg = reg;
+		ctx->writes[ctx->write_count].value = value;
+	}
+	ctx->write_count++;
+	if (reg == ctx->fail_write)
+		return -EIO;
+	if (reg == ASIC2_IRQ_PENDING || reg == ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING) {
+		ctx->regs[reg / 4] &= ~value;
+		if (reg == ASIC2_IRQ_PENDING)
+			ctx->regs[reg / 4] |= ctx->stuck_gpio;
+	} else {
+		ctx->regs[reg / 4] = value;
+	}
+	return 0;
+}
+
+static const struct regmap_bus asic2_irq_test_bus = {
+	.fast_io = true,
+	.reg_read = asic2_irq_test_read,
+	.reg_write = asic2_irq_test_write,
+};
+
+static void asic2_irq_test_unregister(void *dev)
+{
+	root_device_unregister(dev);
+}
+
+static void asic2_irq_test_dispose(void *data)
+{
+	irq_dispose_mapping((unsigned long)data);
+}
+
+static void asic2_irq_test_raise_work(struct irq_work *work)
+{
+	struct asic2_irq_test *ctx = container_of(work, struct asic2_irq_test, raise_work);
+
+	generic_handle_irq(ctx->parent_irq);
+}
+
+static void asic2_irq_test_raise(struct asic2_irq_test *ctx)
+{
+	irq_work_queue(&ctx->raise_work);
+	irq_work_sync(&ctx->raise_work);
+}
+
+static int asic2_irq_test_init(struct kunit *test)
+{
+	static const struct regmap_config config = {
+		.reg_bits = 32, .val_bits = 32, .reg_stride = 4,
+		.max_register = 0x1ffc,
+	};
+	struct gpio_regmap_config gpio_config = {
+		.label = "asic2-irq-test-gpio", .ngpio = 16,
+		.reg_dat_base = 0x14, .reg_set_base = 0x14,
+		.reg_dir_in_base = GPIO_REGMAP_ADDR(0),
+	};
+	struct asic2_irq_test *ctx;
+	struct gpio_regmap *gpio;
+	struct gpio_device *gdev;
+	struct irq_domain *parent;
+	struct device *dev;
+	int ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	ctx->test = test;
+	ctx->fail_read = ~0U;
+	ctx->fail_write = ~0U;
+	ctx->regs[0] = 0xffff;
+	ctx->regs[0x14 / 4] = 0xa5a5;
+	ctx->regs[0x3c / 4] = 0x140;
+	ctx->regs[0x200 / 4] = 0xfff;
+	ctx->regs[0x214 / 4] = 0x5a5a;
+	ctx->regs[0x23c / 4] = 0x3e;
+	ctx->regs[0x1000 / 4] = 0x5030;
+	ctx->regs[0x1600 / 4] = 0x76;
+	ctx->regs[0x1604 / 4] = 0x1e;
+	ctx->regs[0x1608 / 4] = 7;
+	ctx->regs[ASIC2_IRQ_TYPE / 4] = BIT(5);
+	ctx->regs[ASIC2_IRQ_EDGE / 4] = BIT(5);
+	ctx->regs[ASIC2_IRQ_ENABLE / 4] = BIT(31) | ASIC2_GPIO_IRQ_MASK;
+	ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_ENABLE) / 4] = BIT(18) | BIT(0);
+	ctx->regs[ASIC2_IRQ_PENDING / 4] = BIT(11);
+	ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING) / 4] = BIT(18);
+	ctx->raise_work = IRQ_WORK_INIT_HARD(asic2_irq_test_raise_work);
+	dev = kunit_device_register(test, "asic2-irq-parent");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	parent = devm_irq_domain_create_sim(dev, NULL, 1);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, parent);
+	ctx->parent_irq = irq_create_mapping(parent, 0);
+	KUNIT_ASSERT_NE(test, ctx->parent_irq, 0U);
+	ret = kunit_add_action_or_reset(test, asic2_irq_test_dispose,
+					(void *)(unsigned long)ctx->parent_irq);
+	if (ret)
+		return ret;
+	ctx->provider = root_device_register("asic2-irq-provider");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->provider);
+	ret = kunit_add_action_or_reset(test, asic2_irq_test_unregister, ctx->provider);
+	if (ret)
+		return ret;
+	ctx->map = devm_regmap_init(ctx->provider, &asic2_irq_test_bus, ctx, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->map);
+	gpio_config.parent = ctx->provider;
+	gpio_config.regmap = ctx->map;
+	gpio = devm_gpio_regmap_register(ctx->provider, &gpio_config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, gpio);
+	gdev = gpio_device_find_by_label(gpio_config.label);
+	KUNIT_ASSERT_NOT_NULL(test, gdev);
+	ctx->gpio = gpio_device_get_chip(gdev);
+	gpio_device_put(gdev);
+	test->priv = ctx;
+	return 0;
+}
+
+static void asic2_irq_test_register(struct kunit *test)
+{
+	struct asic2_irq_test *ctx = test->priv;
+
+	ctx->domain = devm_asic2_irq_register(ctx->provider, ctx->map, ctx->gpio,
+					      ctx->parent_irq, THIS_MODULE);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->domain);
+}
+
+static irqreturn_t asic2_irq_test_event(int irq, void *data)
+{
+	struct asic2_irq_test_event *event = data;
+
+	event->count++;
+	if (event->count == 1) {
+		event->ctx->regs[ASIC2_IRQ_PENDING / 4] |= event->inject_gpio;
+		event->ctx->regs[(ASIC2_KPIO_BASE + ASIC2_IRQ_PENDING) / 4] |= event->inject_kpio;
+	}
+	return IRQ_HANDLED;
+}
+
+static struct asic2_irq_test_event *
+asic2_irq_test_request(struct kunit *test, unsigned int hwirq, unsigned long flags)
+{
+	struct asic2_irq_test *ctx = test->priv;
+	struct asic2_irq_test_event *event;
+	int ret;
