new file mode 100644
index 0000000000000000000000000000000000000000..429f656f14944fb1ed589cf6bb90c58e141684f1
--- /dev/null
+++ b/drivers/gpio/gpio-compaq-asic.c
@@ -0,0 +1,456 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* GPIO functions of the Compaq ASIC2 and ASIC3 companion chips. */
+#include <linux/clk.h>
+#include <linux/gpio/driver.h>
+#include <linux/gpio/regmap.h>
+#include <linux/irqchip/asic2.h>
+#include <linux/mfd/compaq-asic.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+
+struct compaq_asic_gpio_data {
+	enum compaq_asic_kind kind;
+};
+
+static struct gpio_regmap *
+compaq_asic_gpio_register(struct device *dev, struct compaq_asic *asic)
+{
+	struct gpio_regmap_config config = {
+		.parent = dev,
+		.fwnode = dev_fwnode(dev),
+		.regmap = asic->map,
+		.ngpio_per_reg = 16,
+	};
+
+	switch (asic->kind) {
+	case COMPAQ_ASIC2:
+		config.ngpio = 16;
+		config.reg_dat_base = 0x14;
+		config.reg_set_base = 0x14;
+		/* ASIC2 direction bits are set for inputs. */
+		config.reg_dir_in_base = GPIO_REGMAP_ADDR(0);
+		break;
+	case COMPAQ_ASIC3:
+		config.ngpio = 64;
+		config.reg_stride = 0x100;
+		config.reg_dat_base = 0x30;
+		config.reg_set_base = 0x08;
+		/* ASIC3 direction bits are set for outputs. */
+		config.reg_dir_out_base = 0x04;
+		break;
+	default:
+		return ERR_PTR(-EINVAL);
+	}
+
+	/* Registration must not reset inherited GPIO, alternate functions or rails. */
+	return devm_gpio_regmap_register(dev, &config);
+}
+
+static void compaq_asic_irq_clock_disable(void *data)
+{
+	clk_disable_unprepare(data);
+}
+
+static int compaq_asic_gpio_irq_probe(struct platform_device *pdev,
+				      struct compaq_asic *asic)
+{
+	struct device *dev = &pdev->dev;
+	struct gpio_device *gdev;
+	struct irq_domain *domain;
+	struct clk *clock;
+	int parent_irq, ret;
+
+	if (!device_property_read_bool(dev, "interrupt-controller"))
+		return 0;
+	if (asic->kind != COMPAQ_ASIC2)
+		return -EINVAL;
+	parent_irq = platform_get_irq(pdev, 0);
+	if (parent_irq < 0)
+		return parent_irq;
+	clock = devm_clk_get(dev, "irq");
+	if (IS_ERR(clock))
+		return dev_err_probe(dev, PTR_ERR(clock), "interrupt clock\n");
+	if (clk_get_rate(clock) != 32768)
+		return dev_err_probe(dev, -EINVAL, "EX0 requires a 32768 Hz input\n");
+	ret = clk_prepare_enable(clock);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, compaq_asic_irq_clock_disable, clock);
+	if (ret)
+		return ret;
+	gdev = gpio_device_find_by_fwnode(dev_fwnode(dev));
+	if (!gdev)
+		return -EPROBE_DEFER;
+	domain = devm_asic2_irq_register(dev, asic->map, gpio_device_get_chip(gdev),
+					 parent_irq, THIS_MODULE);
+	gpio_device_put(gdev);
+	return PTR_ERR_OR_ZERO(domain);
+}
+
+static int compaq_asic_gpio_probe(struct platform_device *pdev)
+{
+	const struct compaq_asic_gpio_data *data = device_get_match_data(&pdev->dev);
+	struct compaq_asic *asic;
+	struct gpio_regmap *gpio;
+
+	if (!data)
+		return -EINVAL;
+	asic = compaq_asic_parent(&pdev->dev, data->kind);
+	if (IS_ERR(asic))
+		return PTR_ERR(asic);
+	gpio = compaq_asic_gpio_register(&pdev->dev, asic);
+	if (IS_ERR(gpio))
+		return PTR_ERR(gpio);
+	return compaq_asic_gpio_irq_probe(pdev, asic);
+}
+
+static const struct compaq_asic_gpio_data asic2_gpio_data = {
+	.kind = COMPAQ_ASIC2,
+};
+
+static const struct compaq_asic_gpio_data asic3_gpio_data = {
+	.kind = COMPAQ_ASIC3,
+};
+
+static const struct of_device_id compaq_asic_gpio_match[] = {
+	{ .compatible = "compaq,asic2-gpio", .data = &asic2_gpio_data },
+	{ .compatible = "compaq,asic3-gpio", .data = &asic3_gpio_data },
+	{}
+};
+MODULE_DEVICE_TABLE(of, compaq_asic_gpio_match);
+
+static struct platform_driver compaq_asic_gpio_driver = {
+	.probe = compaq_asic_gpio_probe,
+	.driver = {
+		.name = "compaq-asic-gpio",
+		.of_match_table = compaq_asic_gpio_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(compaq_asic_gpio_driver);
+
+MODULE_DESCRIPTION("Compaq ASIC2 and ASIC3 GPIO");
+MODULE_LICENSE("GPL");
+
+#if IS_ENABLED(CONFIG_GPIO_COMPAQ_ASIC_KUNIT_TEST)
+#include <kunit/device.h>
+#include <kunit/test.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio/driver.h>
+#include <linux/gpio/machine.h>
+#include <linux/regmap.h>
+
+struct compaq_gpio_test_param {
+	const char *desc;
+	enum compaq_asic_kind kind;
+};
+
+static const struct compaq_gpio_test_param compaq_gpio_params[] = {
+	{ "asic2", COMPAQ_ASIC2 },
+	{ "asic3", COMPAQ_ASIC3 },
+};
+
+KUNIT_ARRAY_PARAM_DESC(compaq_gpio, compaq_gpio_params, desc);
+
+struct compaq_gpio_test {
+	struct compaq_asic asic;
+	struct gpio_device *gdev;
+	struct gpio_chip *chip;
+	u32 regs[0x2000 / 4];
+	unsigned int writes;
+	unsigned int write_reg[32];
+	unsigned int fail_write;
+	unsigned int fail_read;
+};
+
+static int compaq_gpio_test_read(void *context, unsigned int reg, unsigned int *value)
+{
+	struct compaq_gpio_test *ctx = context;
+
+	if (reg > 0x1ffc || reg % 4)
+		return -EINVAL;
+	if (reg == ctx->fail_read)
+		return -EIO;
+	*value = ctx->regs[reg / 4];
+	return 0;
+}
+
+static int compaq_gpio_test_write(void *context, unsigned int reg, unsigned int value)
+{
+	struct compaq_gpio_test *ctx = context;
+
+	if (reg > 0x1ffc || reg % 4)
+		return -EINVAL;
+	if (ctx->writes < ARRAY_SIZE(ctx->write_reg))
+		ctx->write_reg[ctx->writes] = reg;
+	ctx->writes++;
+	if (reg == ctx->fail_write)
+		return -EIO;
+	ctx->regs[reg / 4] = value;
+	return 0;
+}
+
+static const struct regmap_bus compaq_gpio_test_bus = {
+	.fast_io = true,
+	.reg_read = compaq_gpio_test_read,
+	.reg_write = compaq_gpio_test_write,
+};
+
+static void compaq_gpio_test_remove_node(void *node)
+{
+	fwnode_remove_software_node(node);
+}
+
+static void compaq_gpio_test_put_device(void *data)
+{
+	gpio_device_put(data);
+}
+
+static void compaq_gpio_test_free_desc(void *data)
+{
+	gpiochip_free_own_desc(data);
+}
+
+static struct gpio_desc *compaq_gpio_test_request(struct kunit *test, unsigned int pin)
+{
+	struct compaq_gpio_test *ctx = test->priv;
+	struct gpio_desc *desc;
+	int ret;
+
+	desc = gpiochip_request_own_desc(ctx->chip, pin, "compaq-gpio-kunit",
+					 GPIO_ACTIVE_HIGH, GPIOD_ASIS);
+	if (IS_ERR(desc))
+		return desc;
+	ret = kunit_add_action_or_reset(test, compaq_gpio_test_free_desc, desc);
+	return ret ? ERR_PTR(ret) : desc;
+}
+
+static int compaq_gpio_test_init(struct kunit *test)
+{
+	static const u32 reserved[] = { 0, 4 };
+	const struct property_entry props[] = {
+		PROPERTY_ENTRY_U32_ARRAY("gpio-reserved-ranges", reserved),
+		{}
+	};
+	const struct compaq_gpio_test_param *param = test->param_value;
+	const struct regmap_config config = {
+		.reg_bits = 32,
+		.val_bits = param->kind == COMPAQ_ASIC2 ? 32 : 16,
+		.reg_stride = 4,
+		.max_register = 0x1ffc,
+	};
+	struct compaq_gpio_test *ctx;
+	struct fwnode_handle *node;
+	struct gpio_regmap *gpio;
+	struct device *dev;
+	unsigned int i;
+	int ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	test->priv = ctx;
+	ctx->asic.kind = param->kind;
+	ctx->fail_read = UINT_MAX;
+	ctx->fail_write = UINT_MAX;
+	for (i = 0; i < ARRAY_SIZE(ctx->regs); i++)
+		ctx->regs[i] = param->kind == COMPAQ_ASIC2 ? 0xa5a5a5a5 : 0xa5a5;
+	node = fwnode_create_software_node(props, NULL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, node);
+	ret = kunit_add_action_or_reset(test, compaq_gpio_test_remove_node, node);
+	if (ret)
+		return ret;
+	dev = kunit_device_register(test, "compaq-gpio-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	/* The device and this fixture each own a software-node reference. */
+	device_set_node(dev, fwnode_handle_get(node));
+	ctx->asic.map = devm_regmap_init(dev, &compaq_gpio_test_bus, ctx, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->asic.map);
+	gpio = compaq_asic_gpio_register(dev, &ctx->asic);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, gpio);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 0U);
+	ctx->gdev = gpio_device_find_by_fwnode(node);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->gdev);
+	ret = kunit_add_action_or_reset(test, compaq_gpio_test_put_device, ctx->gdev);
+	if (ret)
+		return ret;
+	ctx->chip = gpio_device_get_chip(ctx->gdev);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->chip);
+	return 0;
+}
+
+static void compaq_gpio_inherited_ownership(struct kunit *test)
+{
+	struct compaq_gpio_test *ctx = test->priv;
+	struct gpio_desc *desc, *second;
+
+	desc = compaq_gpio_test_request(test, 5);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, desc);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 0U);
+	second = gpiochip_request_own_desc(ctx->chip, 5, "other-consumer",
+					   GPIO_ACTIVE_HIGH, GPIOD_ASIS);
+	KUNIT_EXPECT_EQ(test, PTR_ERR(second), -EBUSY);
+	if (!IS_ERR(second))
+		gpiochip_free_own_desc(second);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 0U);
+}
+
+static void compaq_gpio_output_transaction(struct kunit *test)
+{
+	struct compaq_gpio_test *ctx = test->priv;
+	bool asic2 = ctx->asic.kind == COMPAQ_ASIC2;
+	unsigned int pin = asic2 ? 5 : 26;
+	unsigned int dir = asic2 ? 0 : 0x104;
+	unsigned int out = asic2 ? 0x14 : 0x108;
+	unsigned int mask = asic2 ? BIT(5) : BIT(10);
+	struct gpio_desc *desc;
+	u32 *expected;
+
+	ctx->regs[out / 4] &= ~mask;
+	if (asic2)
+		ctx->regs[dir / 4] |= mask;
+	else
+		ctx->regs[dir / 4] &= ~mask;
+	expected = kunit_kmalloc(test, sizeof(ctx->regs), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, expected);
+	memcpy(expected, ctx->regs, sizeof(ctx->regs));
+	expected[out / 4] |= mask;
+	if (asic2)
+		expected[dir / 4] &= ~mask;
+	else
+		expected[dir / 4] |= mask;
+	desc = compaq_gpio_test_request(test, pin);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, desc);
+	KUNIT_ASSERT_EQ(test, gpiod_direction_output(desc, 1), 0);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 2U);
+	KUNIT_EXPECT_EQ(test, ctx->write_reg[0], out);
+	KUNIT_EXPECT_EQ(test, ctx->write_reg[1], dir);
+	KUNIT_EXPECT_MEMEQ(test, ctx->regs, expected, sizeof(ctx->regs));
+	KUNIT_EXPECT_EQ(test, gpiod_get_direction(desc), 0);
+}
+
+static void compaq_gpio_input_and_pin_status(struct kunit *test)
+{
+	struct compaq_gpio_test *ctx = test->priv;
+	bool asic2 = ctx->asic.kind == COMPAQ_ASIC2;
+	unsigned int dir = asic2 ? 0 : 0x104;
+	unsigned int data = asic2 ? 0x14 : 0x130;
+	unsigned int out = asic2 ? 0x14 : 0x108;
+	unsigned int mask = asic2 ? BIT(5) : BIT(10);
+	unsigned int pin = asic2 ? 5 : 26;
+	struct gpio_desc *desc;
+	u32 saved_out;
+
+	if (asic2)
+		ctx->regs[dir / 4] &= ~mask;
+	else
+		ctx->regs[dir / 4] |= mask;
+	ctx->regs[data / 4] &= ~mask;
+	saved_out = ctx->regs[out / 4];
+	desc = compaq_gpio_test_request(test, pin);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, desc);
+	KUNIT_ASSERT_EQ(test, gpiod_direction_input(desc), 0);
+	KUNIT_EXPECT_EQ(test, ctx->regs[out / 4], saved_out);
+	KUNIT_EXPECT_EQ(test, gpiod_get_direction(desc), 1);
+	KUNIT_EXPECT_EQ(test, gpiod_get_value_cansleep(desc), 0);
+	ctx->regs[data / 4] |= mask;
+	KUNIT_EXPECT_EQ(test, gpiod_get_value_cansleep(desc), 1);
+}
+
+static void compaq_gpio_bank_boundaries(struct kunit *test)
+{
+	static const struct { unsigned int pin, bank; } edges[] = {
+		{ 4, 0 }, { 15, 0 }, { 16, 0x100 }, { 31, 0x100 },
+		{ 32, 0x200 }, { 47, 0x200 }, { 48, 0x300 }, { 63, 0x300 },
+	};
+	struct compaq_gpio_test *ctx = test->priv;
+	bool asic2 = ctx->asic.kind == COMPAQ_ASIC2;
+	unsigned int count = asic2 ? 2 : ARRAY_SIZE(edges), i;
+	struct gpio_desc *desc;
+
+	for (i = 0; i < count; i++) {
+		unsigned int out = asic2 ? 0x14 : edges[i].bank + 8;
+		unsigned int mask = BIT(edges[i].pin % 16);
+		u32 saved;
+
+		ctx->regs[out / 4] &= ~mask;
+		saved = ctx->regs[out / 4];
+		desc = compaq_gpio_test_request(test, edges[i].pin);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, desc);
+		KUNIT_ASSERT_EQ(test, gpiod_direction_output(desc, 0), 0);
+		KUNIT_ASSERT_EQ(test, gpiod_set_value_cansleep(desc, 1), 0);
+		KUNIT_EXPECT_EQ(test, ctx->regs[out / 4], saved | mask);
+		KUNIT_EXPECT_EQ(test, ctx->write_reg[ctx->writes - 1], out);
+	}
+}
+
+static void compaq_gpio_reserved_ranges(struct kunit *test)
+{
+	struct compaq_gpio_test *ctx = test->priv;
+	struct gpio_desc *desc;
+
+	desc = gpiochip_request_own_desc(ctx->chip, 0, "reserved-touch-line",
+					 GPIO_ACTIVE_HIGH, GPIOD_ASIS);
+	KUNIT_EXPECT_TRUE(test, IS_ERR(desc));
+	if (!IS_ERR(desc))
+		gpiochip_free_own_desc(desc);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 0U);
+}
+
+static void compaq_gpio_read_errors(struct kunit *test)
+{
+	struct compaq_gpio_test *ctx = test->priv;
+	bool asic2 = ctx->asic.kind == COMPAQ_ASIC2;
+	struct gpio_desc *desc = compaq_gpio_test_request(test, asic2 ? 5 : 26);
+
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, desc);
+	ctx->fail_read = asic2 ? 0x14 : 0x130;
+	KUNIT_EXPECT_EQ(test, gpiod_get_value_cansleep(desc), -EIO);
+	ctx->fail_read = asic2 ? 0 : 0x104;
+	KUNIT_EXPECT_EQ(test, gpiod_get_direction(desc), -EIO);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 0U);
+}
+
+static void compaq_gpio_failed_value_preserves_input(struct kunit *test)
+{
+	struct compaq_gpio_test *ctx = test->priv;
+	bool asic2 = ctx->asic.kind == COMPAQ_ASIC2;
+	unsigned int dir = asic2 ? 0 : 0x104;
+	unsigned int out = asic2 ? 0x14 : 0x108;
+	unsigned int mask = asic2 ? BIT(5) : BIT(10);
+	struct gpio_desc *desc;
+	u32 saved_dir;
+
+	ctx->regs[out / 4] &= ~mask;
+	if (asic2)
+		ctx->regs[dir / 4] |= mask;
+	else
+		ctx->regs[dir / 4] &= ~mask;
+	saved_dir = ctx->regs[dir / 4];
+	desc = compaq_gpio_test_request(test, asic2 ? 5 : 26);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, desc);
+	ctx->fail_write = out;
+	KUNIT_EXPECT_EQ(test, gpiod_direction_output(desc, 1), -EIO);
+	KUNIT_EXPECT_EQ(test, ctx->regs[dir / 4], saved_dir);
+}
+
+static struct kunit_case compaq_gpio_test_cases[] = {
+	KUNIT_CASE_PARAM(compaq_gpio_inherited_ownership, compaq_gpio_gen_params),
+	KUNIT_CASE_PARAM(compaq_gpio_output_transaction, compaq_gpio_gen_params),
+	KUNIT_CASE_PARAM(compaq_gpio_input_and_pin_status, compaq_gpio_gen_params),
+	KUNIT_CASE_PARAM(compaq_gpio_bank_boundaries, compaq_gpio_gen_params),
+	KUNIT_CASE_PARAM(compaq_gpio_reserved_ranges, compaq_gpio_gen_params),
+	KUNIT_CASE_PARAM(compaq_gpio_read_errors, compaq_gpio_gen_params),
+	KUNIT_CASE_PARAM(compaq_gpio_failed_value_preserves_input, compaq_gpio_gen_params),
+	{}
+};
+
+static struct kunit_suite compaq_gpio_test_suite = {
+	.name = "compaq-asic-gpio",
+	.init = compaq_gpio_test_init,
+	.test_cases = compaq_gpio_test_cases,
+};
+
+kunit_test_suite(compaq_gpio_test_suite);
+#endif
