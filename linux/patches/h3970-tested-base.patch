+
+void h3970_sd_read_response(void __iomem *regs, struct mmc_command *cmd)
+{
+	unsigned int i;
+	u16 response[8];
+
+	if (!(cmd->flags & MMC_RSP_PRESENT))
+		return;
+	if (!(cmd->flags & MMC_RSP_136)) {
+		cmd->resp[0] = readw(regs + SD_RESPONSE) |
+			((u32)readw(regs + SD_RESPONSE + 4) << 16);
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(response); ++i)
+		response[i] = readw(regs + SD_RESPONSE + 4 * i);
+	cmd->resp[0] = (u32)response[7] << 24 | (u32)response[6] << 8 |
+		       response[5] >> 8;
+	cmd->resp[1] = (u32)response[5] << 24 | (u32)response[4] << 8 |
+		       response[3] >> 8;
+	cmd->resp[2] = (u32)response[3] << 24 | (u32)response[2] << 8 |
+		       response[1] >> 8;
+	cmd->resp[3] = (u32)response[1] << 24 | (u32)response[0] << 8 | 0xff;
+}
+
+static int h3970_sd_wait(void __iomem *regs, unsigned int reg, u16 mask,
+			 u16 errors)
+{
+	u16 status, buffer;
+	int ret;
+
+	ret = read_poll_timeout(readw, status,
+				(status & mask) || (readw(regs + SD_BUFFER_STATUS) & errors),
+				30, 300000, false, regs + reg);
+	buffer = readw(regs + SD_BUFFER_STATUS) & errors;
+	if (buffer & (BUFFER_CMD_TIMEOUT | BUFFER_DATA_TIMEOUT))
+		return -ETIMEDOUT;
+	if (buffer)
+		return -EILSEQ;
+	return ret;
+}
+
+void h3970_sd_work(struct work_struct *work)
+{
+	struct asic3_sd *host = container_of(work, struct asic3_sd, work);
+	struct mmc_request *mrq = host->request;
+	struct mmc_command *cmd = mrq->cmd;
+	struct mmc_data *data = mrq->data;
+	void __iomem *regs = host->regs;
+	u16 command = cmd->opcode, errors = BUFFER_ERRORS, buffer;
+	unsigned int i;
+
+	cmd->error = asic3_sd_validate_readonly_request(mrq, sizeof(host->data));
+	if (cmd->error)
+		goto done;
+
+	switch (mmc_resp_type(cmd)) {
+	case MMC_RSP_NONE:
+		if (cmd->opcode == MMC_GO_IDLE_STATE)
+			command |= CMD_IDLE;
+		break;
+	case MMC_RSP_R1:
+		command |= CMD_R1;
+		break;
+	case MMC_RSP_R1B:
+		command |= CMD_R1B;
+		break;
+	case MMC_RSP_R2:
+		command |= CMD_R2;
+		break;
+	case MMC_RSP_R3:
+		command |= CMD_R3;
+		break;
+	default:
+		cmd->error = -EINVAL;
+		goto done;
+	}
+	if (!(cmd->flags & MMC_RSP_CRC))
+		errors &= ~BUFFER_CRC_ERROR;
+	if (cmd->opcode == MMC_APP_CMD)
+		command |= CMD_APP_PREFIX;
+
+	cmd->error = read_poll_timeout(readw, buffer, !(buffer & BUFFER_BUSY),
+				       30, 300000, false, regs + SD_BUFFER_STATUS);
+	if (cmd->error)
+		goto report;
+	writew(0, regs + SD_STATUS);
+	writew(0, regs + SD_BUFFER_STATUS);
+	writew(0, regs + SD_ERROR0);
+	writew(0, regs + SD_ERROR1);
+	if (data) {
+		writew(1, regs + SD_BLOCK_COUNT);
+		writew(data->blksz, regs + SD_BLOCK_LENGTH);
+		command |= CMD_READ_DATA;
+	}
+	writew(cmd->arg >> 16, regs + SD_ARG_HI);
+	writew(cmd->arg, regs + SD_ARG_LO);
+	writew(command, regs + SD_COMMAND);
+
+	cmd->error = h3970_sd_wait(regs, SD_STATUS, STATUS_RESPONSE_END, errors);
+	if (cmd->error)
+		goto report;
+	writew((u16)~STATUS_RESPONSE_END, regs + SD_STATUS);
+	h3970_sd_read_response(regs, cmd);
+	if (!data)
+		goto done;
+
+	data->error = h3970_sd_wait(regs, SD_BUFFER_STATUS, BUFFER_READ_READY,
+				    BUFFER_ERRORS);
+	if (data->error)
+		goto report;
+	writew((u16)~BUFFER_READ_READY, regs + SD_BUFFER_STATUS);
+	for (i = 0; i < data->blksz / 2; ++i)
+		host->data[i] = readw(regs + SD_DATA);
+	data->error = h3970_sd_wait(regs, SD_STATUS, STATUS_DATA_END, BUFFER_ERRORS);
+	if (data->error)
+		goto report;
+	writew((u16)~STATUS_DATA_END, regs + SD_STATUS);
+	data->bytes_xfered = sg_copy_from_buffer(data->sg, data->sg_len,
+						 host->data, data->blksz);
+	if (data->bytes_xfered != data->blksz)
+		data->error = -EIO;
+	goto done;
+
+report:
+	dev_info_ratelimited(mmc_dev(host->mmc),
+		"CMD%u arg=%08x error=%d status=%04x/%04x detail=%04x/%04x\n",
+		cmd->opcode, cmd->arg, cmd->error ?: data->error,
+		readw(regs + SD_STATUS), readw(regs + SD_BUFFER_STATUS),
+		readw(regs + SD_ERROR0), readw(regs + SD_ERROR1));
+done:
+	mmc_request_done(host->mmc, mrq);
+}
+
+static void h3970_sd_request(struct mmc_host *mmc, struct mmc_request *mrq)
+{
+	struct asic3_sd *host = mmc_priv(mmc);
+
+	host->request = mrq;
+	schedule_work(&host->work);
+}
+
+static void h3970_sd_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
+{
+	asic3_sd_program_clock(mmc_priv(mmc), ios);
+}
+
+static const struct mmc_host_ops h3970_sd_ops = {
+	.request = h3970_sd_request,
+	.set_ios = h3970_sd_set_ios,
+	.get_ro = asic3_sd_get_ro,
+};
+
+static void h3970_sd_enable(struct asic3_sd *host)
+{
+	asic3_sd_prepare(host);
+	asic3_sd_configure(host, true, true);
+}
+
+int asic3_sd_legacy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct asic3_sd *host;
+	struct mmc_host *mmc;
+	struct clk *clock;
+	int ret;
+
+	mmc = devm_mmc_alloc_host(dev, sizeof(*host));
+	if (!mmc)
+		return -ENOMEM;
+	host = mmc_priv(mmc);
+	host->mmc = mmc;
+	host->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(host->regs))
+		return PTR_ERR(host->regs);
+	ret = asic3_sd_get_control(pdev, host);
+	if (ret)
+		return ret;
+	clock = devm_clk_get_enabled(dev, "sd");
+	if (IS_ERR(clock))
+		return dev_err_probe(dev, PTR_ERR(clock), "failed to enable SD clock\n");
+
+	INIT_WORK(&host->work, h3970_sd_work);
+	mmc->ops = &h3970_sd_ops;
+	ret = mmc_of_parse(mmc);
+	if (ret)
+		return ret;
+	ret = asic3_sd_configure_mmc(mmc);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, host);
+
+	h3970_sd_enable(host);
+	dev_info(dev, "ASIC3 SD enabled, status=%04x/%04x, slot power=%04x\n",
+		 readw(host->regs + SD_STATUS), readw(host->regs + SD_BUFFER_STATUS),
+		 readw(host->regs + CFG_POWER));
+	return mmc_add_host(mmc);
+}
+
+void asic3_sd_legacy_remove(struct platform_device *pdev)
+{
+	struct asic3_sd *host = platform_get_drvdata(pdev);
+
+	mmc_remove_host(host->mmc);
+	cancel_work_sync(&host->work);
+}
diff --git a/drivers/mmc/host/compaq-asic3-mmc.c b/drivers/mmc/host/compaq-asic3-mmc.c
new file mode 100644
index 0000000000000000000000000000000000000000..124c898e70e45926c865b19178d5ea765bba51f4
--- /dev/null
+++ b/drivers/mmc/host/compaq-asic3-mmc.c
@@ -0,0 +1,442 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * DT-driven ASIC3 TMIO frontend. Register layout, clock setup and R2 response packing
+ * follow the Familiar ASIC3 drivers by SDG Systems and Ian Molton.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/compaq-asic.h>
+#include <linux/mmc/host.h>
+#include <linux/mmc/mmc.h>
+#include <linux/mmc/sd.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/platform_data/tmio.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/scatterlist.h>
+#include <linux/workqueue.h>
+
+#include "asic3-sd.h"
+#include "tmio_mmc.h"
+#include "compaq-asic3-mmc.h"
+
+/* TMIO request engine with IRQ or per-request polled completion. */
+struct asic3_tmio {
+	struct tmio_mmc_data pdata;
+	struct asic3_sd asic;
+	struct tmio_mmc_host *host;
+	struct work_struct work;
+	spinlock_t lock;
+	struct mmc_request *request;
+	void (*core_request)(struct mmc_host *, struct mmc_request *);
+	void (*done)(struct mmc_request *);
+	struct mmc_host *original_host;
+	struct scatterlist bounce_sg, *original_sg;
+	unsigned int original_sg_len;
+	u32 original_response[4];
+	u16 bounce[256];
+	u64 request_seq;
+	int irq;
+	bool polling;
+	bool stopping, registered, pinned, prepared, irq_enabled;
+};
+
+static struct asic3_tmio *asic3_tmio_priv(struct tmio_mmc_host *host)
+{
+	return container_of(host->pdata, struct asic3_tmio, pdata);
+}
+
+static void asic3_tmio_configure_host(struct tmio_mmc_host *host)
+{
+	/* Firmware was validated before host_probe; reapply after generic caps. */
+	asic3_sd_configure_mmc(host->mmc);
+	host->ops.get_ro = asic3_sd_get_ro;
+}
+
+static int asic3_tmio_clk_enable(struct tmio_mmc_host *host)
+{
+	/* CCF owns the oscillator for the entire bound-device lifetime. */
+	return 0;
+}
+
+static void asic3_tmio_set_clock(struct tmio_mmc_host *host, unsigned int clock)
+{
+	struct asic3_tmio *priv = asic3_tmio_priv(host);
+	struct mmc_ios ios = { .clock = clock };
+
+	if (!priv->prepared) {
+		asic3_sd_prepare(&priv->asic);
+		priv->prepared = true;
+	}
+	asic3_sd_program_clock(&priv->asic, &ios);
+}
+
+static void asic3_tmio_reset(struct tmio_mmc_host *host, bool preserve)
+{
+	struct asic3_tmio *priv = asic3_tmio_priv(host);
+
+	asic3_sd_configure(&priv->asic, false, !preserve);
+	writew(0, priv->asic.regs + SD_STATUS);
+	writew(0, priv->asic.regs + SD_BUFFER_STATUS);
+	writew(0, priv->asic.regs + SD_ERROR0);
+	writew(0, priv->asic.regs + SD_ERROR1);
+	if (!priv->polling && !priv->irq_enabled) {
+		enable_irq(priv->irq);
+		priv->irq_enabled = true;
+	}
+}
+
+static void asic3_tmio_write_command(struct tmio_mmc_host *host,
+				     struct mmc_command *cmd, u16 value)
+{
+	/* ASIC3 uses RESP_NONE only for CMD0 and tags the CMD55 prefix. */
+	if (mmc_resp_type(cmd) == MMC_RSP_NONE && cmd->opcode != MMC_GO_IDLE_STATE)
+		value &= ~CMD_IDLE;
+	if (cmd->opcode == MMC_APP_CMD)
+		value |= CMD_APP_PREFIX;
+	/* Card detect remains the existing diagnostic policy, not hotplug. */
+	tmio_mmc_disable_mmc_irqs(host, TMIO_STAT_CARD_INSERT | TMIO_STAT_CARD_REMOVE);
+	sd_ctrl_write16(host, CTL_ARG_REG + 2, cmd->arg >> 16);
+	sd_ctrl_write16(host, CTL_ARG_REG, cmd->arg);
+	sd_ctrl_write16(host, CTL_SD_CMD, value);
+}
+
+static void asic3_tmio_done(struct mmc_request *mrq)
+{
+	struct tmio_mmc_host *host = mmc_priv(mrq->host);
+	struct asic3_tmio *priv = asic3_tmio_priv(host);
+	struct mmc_data *data = mrq->data;
+	void (*done)(struct mmc_request *);
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->lock, flags);
+	if (!mrq->cmd->error && (mrq->cmd->flags & MMC_RSP_PRESENT)) {
+		if (mrq->cmd->flags & MMC_RSP_136)
+			mrq->cmd->resp[3] |= 0xff;
+		else
+			memcpy(&mrq->cmd->resp[1], &priv->original_response[1], 3 * sizeof(u32));
+	} else {
+		memcpy(mrq->cmd->resp, priv->original_response, sizeof(priv->original_response));
+	}
+	if (data && priv->original_sg) {
+		data->sg = priv->original_sg;
+		data->sg_len = priv->original_sg_len;
+		if (!mrq->cmd->error && !data->error &&
+		    (data->bytes_xfered != data->blksz || host->sg_len)) {
+			data->error = -EIO;
+			data->bytes_xfered = 0;
+		}
+		if (!mrq->cmd->error && !data->error) {
+			data->bytes_xfered = sg_copy_from_buffer(data->sg, data->sg_len,
+							    priv->bounce, data->blksz);
+			if (data->bytes_xfered != data->blksz)
+				data->error = -EIO;
+		}
+	}
+	done = priv->done;
+	mrq->done = done;
+	mrq->host = priv->original_host;
+	priv->request = NULL;
+	priv->original_sg = NULL;
+	spin_unlock_irqrestore(&priv->lock, flags);
+	if (done)
+		done(mrq);
+}
+
+static int asic3_tmio_validate_request(struct mmc_request *mrq)
+{
+	struct mmc_data *data = mrq->data;
+	struct scatterlist *sg;
+	unsigned int i, size = 0;
+	int ret = asic3_sd_validate_readonly_request(mrq, 512);
+
+	if (ret)
+		return ret;
+	if (mrq->sbc || mrq->stop || (data && data->stop))
+		return -EINVAL;
+	switch (mmc_resp_type(mrq->cmd)) {
+	case MMC_RSP_NONE:
+	case MMC_RSP_R1:
+	case MMC_RSP_R1B:
+	case MMC_RSP_R2:
+	case MMC_RSP_R3:
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (data) {
+		if (!data->sg || !data->sg_len || data->sg_len > PAGE_SIZE / 512)
+			return -EINVAL;
+		for_each_sg(data->sg, sg, data->sg_len, i) {
+			if (sg->length > PAGE_SIZE - size)
+				return -EINVAL;
+			size += sg->length;
+		}
+		if (size < data->blksz)
+			return -EINVAL;
+	}
+	return 0;
+}
+
+static void asic3_tmio_work(struct work_struct *work)
+{
+	struct asic3_tmio *priv = container_of(work, struct asic3_tmio, work);
+	struct mmc_request *mrq = priv->request;
+	struct mmc_data *data = mrq->data;
+	u16 status;
+	unsigned long flags;
+	u64 seq = priv->request_seq;
+
+	if (READ_ONCE(priv->stopping)) {
+		mrq->cmd->error = -ENODEV;
+		goto done;
+	}
+	mrq->cmd->error = read_poll_timeout(readw, status, !(status & BUFFER_BUSY),
+					   30, 300000, false, priv->asic.regs + SD_BUFFER_STATUS);
+	if (mrq->cmd->error)
+		goto done;
+	writew(0, priv->asic.regs + SD_STATUS);
+	writew(0, priv->asic.regs + SD_BUFFER_STATUS);
+	writew(0, priv->asic.regs + SD_ERROR0);
+	writew(0, priv->asic.regs + SD_ERROR1);
+	if (data) {
+		spin_lock_irqsave(&priv->lock, flags);
+		priv->original_sg = data->sg;
+		priv->original_sg_len = data->sg_len;
+		sg_init_one(&priv->bounce_sg, priv->bounce, data->blksz);
+		data->sg = &priv->bounce_sg;
+		data->sg_len = 1;
+		spin_unlock_irqrestore(&priv->lock, flags);
+	}
+	priv->core_request(priv->host->mmc, mrq);
+	/* Poll the same TMIO state machine when the completion line is not
+	 * described. Do not guess a board IRQ edge or keep a second request engine.
+	 * Completion may immediately reuse the request object; the generation
+	 * prevents this worker from waiting for the next queued request to start.
+	 */
+	while (priv->polling) {
+		bool active;
+
+		spin_lock_irqsave(&priv->lock, flags);
+		active = !priv->stopping && priv->request && priv->request_seq == seq;
+		spin_unlock_irqrestore(&priv->lock, flags);
+		if (!active)
+			break;
+		tmio_mmc_irq(0, priv->host);
+		/* Finish a handled event before polling or reusing its request again. */
+		flush_work(&priv->host->done);
+		usleep_range(100, 300);
+	}
+	return;
+done:
+	mmc_request_done(priv->host->mmc, mrq);
+}
+
+static void asic3_tmio_request(struct mmc_host *mmc, struct mmc_request *mrq)
+{
+	struct asic3_tmio *priv = asic3_tmio_priv(mmc_priv(mmc));
+	unsigned long flags;
+	int ret = asic3_tmio_validate_request(mrq);
+
+	if (ret)
+		goto fail;
+	spin_lock_irqsave(&priv->lock, flags);
+	if (priv->stopping || priv->request) {
+		ret = priv->stopping ? -ENODEV : -EBUSY;
+		spin_unlock_irqrestore(&priv->lock, flags);
+		goto fail;
+	}
+	priv->request = mrq;
+	priv->request_seq++;
+	priv->done = mrq->done;
+	/* Only CQE initializes mrq->host in the core. Supply completion context
+	 * for ordinary synchronous requests too, then restore the caller's value.
+	 */
+	priv->original_host = mrq->host;
+	mrq->host = mmc;
+	priv->original_sg = NULL;
+	memcpy(priv->original_response, mrq->cmd->resp, sizeof(priv->original_response));
+	mrq->done = asic3_tmio_done;
+	schedule_work(&priv->work);
+	spin_unlock_irqrestore(&priv->lock, flags);
+	return;
+fail:
+	mrq->cmd->error = ret;
+	mmc_request_done(mmc, mrq);
+}
+
+static void asic3_tmio_init(struct asic3_tmio *priv, struct tmio_mmc_host *host)
+{
+	priv->host = host;
+	priv->asic.tmio = priv;
+	priv->asic.mmc = host->mmc;
+	priv->core_request = host->ops.request;
+	spin_lock_init(&priv->lock);
+	INIT_WORK(&priv->work, asic3_tmio_work);
+	host->bus_shift = 1;
+	host->reset_delay_us = 2000;
+	host->request_timeout_ms = 300;
+	host->sdcard_irq_mask_all = ~0U;
+	host->clk_enable = asic3_tmio_clk_enable;
+	host->set_clock = asic3_tmio_set_clock;
+	host->reset = asic3_tmio_reset;
+	host->write_command = asic3_tmio_write_command;
+	host->configure_host = asic3_tmio_configure_host;
+	host->ops.request = asic3_tmio_request;
+	host->ops.get_ro = asic3_sd_get_ro;
+}
+
+static int asic3_tmio_probe(struct platform_device *pdev, int irq)
+{
+	struct device *dev = &pdev->dev;
+	struct asic3_tmio *priv;
+	struct tmio_mmc_host *host;
+	struct clk *clock;
+	void __iomem *regs;
+	int ret;
+
+	ret = asic3_sd_firmware_supported(dev);
+	if (ret)
+		return ret;
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->irq = irq;
+	priv->polling = !irq;
+	priv->pdata.flags = TMIO_MMC_ABORT_DATA_ON_CMD_ERROR | TMIO_MMC_KEEP_POWER;
+	priv->pdata.ocr_mask = MMC_VDD_32_33 | MMC_VDD_33_34;
+	regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(regs))
+		return PTR_ERR(regs);
+	priv->asic.regs = regs;
+	host = tmio_mmc_host_alloc_mapped(pdev, &priv->pdata, regs + SD_COMMAND);
+	if (IS_ERR(host))
+		return PTR_ERR(host);
+	asic3_tmio_init(priv, host);
+	ret = asic3_sd_configure_mmc(host->mmc);
+	if (ret)
+		return ret;
+	ret = asic3_sd_get_control(pdev, &priv->asic);
+	if (ret)
+		return ret;
+	clock = devm_clk_get_enabled(dev, "sd");
+	if (IS_ERR(clock))
+		return dev_err_probe(dev, PTR_ERR(clock), "SD clock\n");
+	if (clk_get_rate(clock) != 24576000)
+		return dev_err_probe(dev, -EINVAL, "ASIC3 development host requires 24.576 MHz\n");
+	if (irq) {
+		ret = devm_request_irq(dev, irq, tmio_mmc_irq, IRQF_NO_AUTOEN,
+				       dev_name(dev), host);
+		if (ret)
+			return ret;
+	}
+	/* Hold controller resources active; keep slot VDD across rescan/kexec. */
+	pm_runtime_get_noresume(dev);
+	priv->pinned = true;
+	ret = tmio_mmc_host_probe(host);
+	if (ret) {
+		if (priv->irq_enabled)
+			disable_irq(irq);
+		pm_runtime_put_noidle(dev);
+		return ret;
+	}
+	priv->registered = true;
+	dev_info(dev, "ASIC3 TMIO host using %s completion\n",
+		 priv->polling ? "polled" : "IRQ");
+	/* Generic runtime callbacks are deliberately not installed for this role. */
+	platform_set_drvdata(pdev, &priv->asic);
+	return 0;
+}
+
+static void asic3_tmio_remove(struct asic3_tmio *priv)
+{
+	unsigned long flags;
+
+	if (!priv->registered)
+		return;
+	spin_lock_irqsave(&priv->lock, flags);
+	priv->stopping = true;
+	spin_unlock_irqrestore(&priv->lock, flags);
+	/* Run a queued request to ENODEV rather than abandoning its completion. */
+	flush_work(&priv->work);
+	tmio_mmc_host_remove(priv->host);
+	priv->registered = false;
+	if (priv->irq_enabled) {
+		disable_irq(priv->irq);
+		priv->irq_enabled = false;
+	}
+	if (priv->pinned) {
+		pm_runtime_put_noidle(&priv->host->pdev->dev);
+		priv->pinned = false;
+	}
+}
+
+static int h3970_sd_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	int ret, irq;
+
+	ret = asic3_sd_firmware_supported(dev);
+	if (ret)
+		return ret;
+	irq = platform_get_irq_optional(pdev, 0);
+	if (irq > 0)
+		return asic3_tmio_probe(pdev, irq);
+	if (irq != -ENXIO || device_property_present(dev, "interrupts") ||
+	    device_property_present(dev, "interrupts-extended"))
+		return irq ?: -EINVAL;
+	if (device_is_compatible(dev, "compaq,asic3-mmc"))
+		return asic3_tmio_probe(pdev, 0);
+
+	return asic3_sd_legacy_probe(pdev);
+}
+
+static void h3970_sd_remove(struct platform_device *pdev)
+{
+	struct asic3_sd *host = platform_get_drvdata(pdev);
+
+	if (host->tmio) {
+		asic3_tmio_remove(host->tmio);
+		return;
+	}
+
+	asic3_sd_legacy_remove(pdev);
+}
+
+static void h3970_sd_shutdown(struct platform_device *pdev)
+{
+	struct asic3_sd *host = platform_get_drvdata(pdev);
+
+	if (host->tmio)
+		asic3_tmio_remove(host->tmio);
+}
+
+static const struct of_device_id h3970_sd_match[] = {
+	{ .compatible = "compaq,asic3-mmc" },
+	{ .compatible = "compaq,h3970-asic3-sd" },
+	{}
+};
+
+MODULE_DEVICE_TABLE(of, h3970_sd_match);
+
+static struct platform_driver h3970_sd_driver = {
+	.probe = h3970_sd_probe,
+	.remove = h3970_sd_remove,
+	.shutdown = h3970_sd_shutdown,
+	.driver = {
+		/* Preserve the existing RAM updater's bind/unbind ABI. */
+		.name = "h3970-asic3-sd",
+		.of_match_table = h3970_sd_match,
+	},
+};
+module_platform_driver(h3970_sd_driver);
+MODULE_DESCRIPTION("Compaq ASIC3 DT-driven TMIO SD host");
+MODULE_LICENSE("GPL");
+
+#if IS_ENABLED(CONFIG_MMC_H3970_ASIC3_KUNIT_TEST)
+#include "h3970-sd-test.c"
+#endif
diff --git a/drivers/mmc/host/compaq-asic3-mmc.h b/drivers/mmc/host/compaq-asic3-mmc.h
new file mode 100644
index 0000000000000000000000000000000000000000..056b536bef5d8562952a1f0670ace07fed960896
--- /dev/null
+++ b/drivers/mmc/host/compaq-asic3-mmc.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _COMPAQ_ASIC3_MMC_H
+#define _COMPAQ_ASIC3_MMC_H
+#include <linux/bits.h>
+#include <linux/mmc/host.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+#define ASIC3_CLOCK_ENABLE	0x0000
+#define ASIC3_CLOCK_SELECT	0x0004
+#define ASIC3_SD_HWCTRL		0x0400
+#define ASIC3_EXTCF_SELECT	0x0700
+#define ASIC3_EX0_EX1		(BIT(13) | BIT(14))
+#define ASIC3_SD_CLOCKS		(BIT(9) | BIT(10))
+#define ASIC3_SD_HOST_24M	BIT(0)
+#define ASIC3_SD_BUS_24M	BIT(1)
+#define ASIC3_SD_SUSPEND	BIT(0)
+#define ASIC3_SD_CLEAR		BIT(2)
+#define ASIC3_SD_CD_WP		(BIT(3) | BIT(4))
+#define ASIC3_SD_POWER		BIT(6)
+#define ASIC3_SD_MEM_ENABLE	BIT(14)
+
+#define CFG_COMMAND		0x0408
+#define CFG_ADDR_LO		0x0420
+#define CFG_ADDR_HI		0x0424
+#define CFG_CLOCK_GATE		0x0480
+#define CFG_CLOCK_MODE		0x0484
+#define CFG_POWER		0x0490
+#define CFG_AUTO_POWER		0x0494
+#define CFG_CARD_DETECT		0x0498
+#define SD_COMMAND		0x1000
+#define SD_ARG_LO		0x1008
+#define SD_ARG_HI		0x100c
+#define SD_STOP			0x1010
+#define SD_BLOCK_COUNT		0x1014
+#define SD_RESPONSE		0x1018
+#define SD_STATUS		0x1038
+#define SD_BUFFER_STATUS	0x103c
+#define SD_STATUS_MASK		0x1040
+#define SD_BUFFER_MASK		0x1044
+#define SD_CLOCK		0x1048
+#define SD_BLOCK_LENGTH		0x104c
+#define SD_OPTION		0x1050
+#define SD_ERROR0		0x1058
+#define SD_ERROR1		0x105c
+#define SD_DATA			0x1060
+#define SD_RESET		0x11c0
+#define SDIO_CLOCK_WAIT		0x1270
+
+#define CMD_APP_PREFIX		BIT(6)
+#define CMD_IDLE		(3 << 8)
+#define CMD_R1			(4 << 8)
+#define CMD_R1B			(5 << 8)
+#define CMD_R2			(6 << 8)
+#define CMD_R3			(7 << 8)
+#define CMD_READ_DATA		(BIT(11) | BIT(12))
+
+#define STATUS_RESPONSE_END	BIT(0)
+#define STATUS_DATA_END		BIT(2)
+#define BUFFER_CRC_ERROR	BIT(1)
+#define BUFFER_DATA_TIMEOUT	BIT(3)
+#define BUFFER_CMD_TIMEOUT	BIT(6)
+#define BUFFER_READ_READY	BIT(8)
+#define BUFFER_BUSY		BIT(14)
+#define BUFFER_ERRORS		(GENMASK(6, 0) | BIT(15))
+#define SD_CLOCK_ENABLE		BIT(8)
+#define SD_CLOCK_DIV_64		BIT(4)
+#define SD_CLOCK_DIV_128		BIT(5)
+
+struct asic3_tmio;
+
+struct asic3_sd {
+	struct asic3_tmio *tmio;
+	void __iomem *regs;
+	struct regmap *control;
+	unsigned int control_base;
+	struct mmc_host *mmc;
+	struct work_struct work;
+	struct mmc_request *request;
+	u16 data[256];
+};
+
+void asic3_sd_program_clock(struct asic3_sd *host, struct mmc_ios *ios);
+int asic3_sd_get_ro(struct mmc_host *mmc);
+void asic3_sd_prepare(struct asic3_sd *host);
+void asic3_sd_configure(struct asic3_sd *host, bool reset, bool power);
+int asic3_sd_get_control(struct platform_device *pdev, struct asic3_sd *host);
+int asic3_sd_firmware_supported(struct device *dev);
+int asic3_sd_configure_mmc(struct mmc_host *mmc);
+int asic3_sd_legacy_probe(struct platform_device *pdev);
+void asic3_sd_legacy_remove(struct platform_device *pdev);
+/* Retained for the old-DTB protocol contract tests. */
+void h3970_sd_read_response(void __iomem *regs, struct mmc_command *cmd);
+void h3970_sd_work(struct work_struct *work);
+
+#endif
diff --git a/drivers/mmc/host/h3970-sd-test.c b/drivers/mmc/host/h3970-sd-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..33b9873e7147440db26aa5f2db6e29dfa0493bbe
--- /dev/null
+++ b/drivers/mmc/host/h3970-sd-test.c
@@ -0,0 +1,759 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Software contracts over RAM-backed registers, not an ASIC3 emulator. */
+#include <kunit/device.h>
+#include <kunit/test.h>
+#include <linux/platform_data/tmio.h>
+
+#include "tmio_mmc.h"
+
+struct asic3_sd_test {
+	struct asic3_sd *host;
+	struct tmio_mmc_host tmio;
+	struct mmc_request request;
+	struct mmc_command command;
+	struct mmc_data data;
+};
+
+static void h3970_sd_test_done(struct work_struct *work)
+{
+}
+
+static int h3970_sd_test_init(struct kunit *test)
+{
+	struct asic3_sd_test *ctx;
+	struct mmc_host *mmc;
+	struct device *dev;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	dev = kunit_device_register(test, "asic3-sd-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	mmc = devm_mmc_alloc_host(dev, sizeof(*ctx->host));
+	KUNIT_ASSERT_NOT_NULL(test, mmc);
+	ctx->host = mmc_priv(mmc);
+	ctx->host->mmc = mmc;
+	ctx->host->regs = (void __iomem *)kunit_kzalloc(test, 0x2000, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->host->regs);
+	ctx->host->request = &ctx->request;
+	ctx->request.cmd = &ctx->command;
+	INIT_WORK(&ctx->host->work, h3970_sd_work);
+	ctx->tmio.ctl = ctx->host->regs + SD_COMMAND;
+	ctx->tmio.bus_shift = 1;
+	spin_lock_init(&ctx->tmio.lock);
+	INIT_WORK(&ctx->tmio.done, h3970_sd_test_done);
+	test->priv = ctx;
+	return 0;
+}
+
+static void h3970_sd_test_response(struct kunit *test, unsigned int flags)
+{
+	struct asic3_sd_test *ctx = test->priv;
+	struct mmc_command polled = { .flags = flags };
+	struct mmc_command tmio = { .flags = flags };
+	const u16 words[] = { 0x1234, 0x5678, 0x9abc, 0xdef0,
+			      0x1357, 0x2468, 0x9bdf, 0xace0 };
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(words); i++)
+		writew(words[i], ctx->host->regs + SD_RESPONSE + 4 * i);
+	h3970_sd_read_response(ctx->host->regs, &polled);
+	ctx->tmio.cmd = &tmio;
+	ctx->tmio.sdcard_irq_mask = ~TMIO_STAT_CMDRESPEND;
+	writew(TMIO_STAT_CMDRESPEND, ctx->host->regs + SD_STATUS);
+	writew(0, ctx->host->regs + SD_BUFFER_STATUS);
+	KUNIT_EXPECT_EQ(test, tmio_mmc_irq(0, &ctx->tmio), IRQ_HANDLED);
+	flush_work(&ctx->tmio.done);
+	KUNIT_EXPECT_EQ(test, tmio.error, 0);
+	if (flags & MMC_RSP_136) {
+		for (i = 0; i < 3; i++)
+			KUNIT_EXPECT_EQ(test, polled.resp[i], tmio.resp[i]);
+		KUNIT_EXPECT_EQ(test, polled.resp[3] & ~0xffU, tmio.resp[3]);
+		/* Preserve the observed software difference; do not assert equivalence. */
+		KUNIT_EXPECT_EQ(test, polled.resp[3] & 0xffU, 0xffU);
+		KUNIT_EXPECT_EQ(test, tmio.resp[3] & 0xffU, 0U);
+	} else {
+		KUNIT_EXPECT_EQ(test, polled.resp[0], tmio.resp[0]);
+		KUNIT_EXPECT_EQ(test, polled.resp[0], 0x56781234U);
+	}
+}
+
+static void h3970_sd_short_responses(struct kunit *test)
+{
+	h3970_sd_test_response(test, MMC_RSP_R1);
+	h3970_sd_test_response(test, MMC_RSP_R1B);
+	h3970_sd_test_response(test, MMC_RSP_R3);
+	h3970_sd_test_response(test, MMC_RSP_R6);
+	h3970_sd_test_response(test, MMC_RSP_R7);
+}
+
+static void h3970_sd_long_response_difference(struct kunit *test)
+{
+	h3970_sd_test_response(test, MMC_RSP_R2);
+}
+
+static void h3970_sd_data_write_is_read_only(struct kunit *test)
+{
+	struct asic3_sd_test *ctx = test->priv;
+
+	ctx->request.data = &ctx->data;
+	ctx->data.flags = MMC_DATA_WRITE;
+	ctx->data.blksz = 512;
+	ctx->data.blocks = 1;
+	ctx->command.opcode = MMC_WRITE_BLOCK;
+	ctx->command.flags = MMC_RSP_R1;
+	h3970_sd_work(&ctx->host->work);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -EROFS);
+	KUNIT_EXPECT_EQ(test, readw(ctx->host->regs + SD_COMMAND), 0);
+}
+
+static void h3970_sd_no_data_write_commands(struct kunit *test)
+{
+	struct asic3_sd_test *ctx = test->priv;
+	static const unsigned int opcodes[] = {
+		MMC_WRITE_BLOCK, MMC_WRITE_MULTIPLE_BLOCK, MMC_PROGRAM_CID,
+		MMC_PROGRAM_CSD, MMC_LOCK_UNLOCK, MMC_GEN_CMD,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(opcodes); i++) {
+		ctx->command.opcode = opcodes[i];
+		ctx->command.flags = MMC_RSP_R1;
+		ctx->command.error = 0;
+		writew(0, ctx->host->regs + SD_COMMAND);
+		h3970_sd_work(&ctx->host->work);
+		KUNIT_EXPECT_EQ(test, ctx->command.error, -EROFS);
+		KUNIT_EXPECT_EQ(test, readw(ctx->host->regs + SD_COMMAND), 0);
+	}
+}
+
+static void h3970_sd_erase_and_protect_commands(struct kunit *test)
+{
+	struct asic3_sd_test *ctx = test->priv;
+	static const unsigned int opcodes[] = {
+		MMC_ERASE, MMC_SET_WRITE_PROT, MMC_CLR_WRITE_PROT,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(opcodes); i++) {
+		ctx->command.opcode = opcodes[i];
+		ctx->command.flags = MMC_RSP_R1B;
+		ctx->command.error = 0;
+		h3970_sd_work(&ctx->host->work);
+		KUNIT_EXPECT_EQ(test, ctx->command.error, -EROFS);
+		KUNIT_EXPECT_EQ(test, readw(ctx->host->regs + SD_COMMAND), 0);
+	}
+}
+
+static void h3970_sd_read_request_bounds(struct kunit *test)
+{
+	struct asic3_sd_test *ctx = test->priv;
+	static const struct {
+		unsigned int size, blocks;
+		int expected;
+	} bounds[] = {
+		{ 2, 1, 0 }, { 512, 1, 0 },
+		{ 0, 1, -EINVAL }, { 1, 1, -EINVAL }, { 3, 1, -EINVAL },
+		{ 514, 1, -EINVAL }, { 512, 0, -EINVAL }, { 512, 2, -EINVAL },
+	};
+	unsigned int i;
+
+	ctx->command.opcode = MMC_READ_SINGLE_BLOCK;
+	ctx->data.flags = MMC_DATA_READ;
+	ctx->request.data = &ctx->data;
+	for (i = 0; i < ARRAY_SIZE(bounds); i++) {
+		ctx->data.blksz = bounds[i].size;
+		ctx->data.blocks = bounds[i].blocks;
+		KUNIT_EXPECT_EQ(test, asic3_sd_validate_readonly_request(&ctx->request,
+									 sizeof(ctx->host->data)),
+				bounds[i].expected);
+	}
+	ctx->data.flags = 0;
+	KUNIT_EXPECT_EQ(test, asic3_sd_validate_readonly_request(&ctx->request, 512), -EINVAL);
+	ctx->data.flags = MMC_DATA_READ | MMC_DATA_WRITE;
+	KUNIT_EXPECT_EQ(test, asic3_sd_validate_readonly_request(&ctx->request, 512), -EROFS);
+	ctx->request.data = NULL;
+	ctx->command.opcode = MMC_SEND_STATUS;
+	KUNIT_EXPECT_EQ(test, asic3_sd_validate_readonly_request(&ctx->request, 512), 0);
+}
+
+static void h3970_sd_encoded_write_alias(struct kunit *test)
+{
+	struct asic3_sd_test *ctx = test->priv;
+
+	ctx->command.opcode = MMC_ERASE | BIT(8);
+	ctx->command.flags = MMC_RSP_R1B;
+	h3970_sd_work(&ctx->host->work);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -EINVAL);
+	KUNIT_EXPECT_EQ(test, readw(ctx->host->regs + SD_COMMAND), 0);
+}
+
+static struct kunit_case h3970_sd_test_cases[] = {
+	KUNIT_CASE(h3970_sd_short_responses),
+	KUNIT_CASE(h3970_sd_long_response_difference),
+	KUNIT_CASE(h3970_sd_data_write_is_read_only),
+	KUNIT_CASE(h3970_sd_no_data_write_commands),
+	KUNIT_CASE(h3970_sd_erase_and_protect_commands),
+	KUNIT_CASE(h3970_sd_read_request_bounds),
+	KUNIT_CASE(h3970_sd_encoded_write_alias),
+	{}
+};
+
+static struct kunit_suite h3970_sd_test_suite = {
+	.name = "asic3-sd-contract",
+	.init = h3970_sd_test_init,
+	.test_cases = h3970_sd_test_cases,
+};
+
+kunit_test_suite(h3970_sd_test_suite);
+
+/* Actual TMIO requests/PIO/completion over a RAM register fixture. */
+#include <kunit/device.h>
+#include <linux/property.h>
+#include <linux/completion.h>
+#include "../core/core.h"
+
+struct asic3_tmio_test {
+	struct asic3_tmio priv;
+	struct platform_device *pdev;
+	struct mmc_request request;
+	struct mmc_command command;
+	struct mmc_data data;
+	struct scatterlist sg[2];
+	u8 bytes[512];
+	u32 control[0x2000 / 4];
+	unsigned int complete, writes[32], count;
+	struct completion command_written;
+	bool resubmit, respond_on_command, stop_on_command;
+};
+
+static int asic3_tmio_test_reg_read(void *data, unsigned int reg, unsigned int *val)
+{
+	*val = ((struct asic3_tmio_test *)data)->control[reg / 4];
+	return 0;
+}
+
+static int asic3_tmio_test_reg_write(void *data, unsigned int reg, unsigned int val)
+{
+	((struct asic3_tmio_test *)data)->control[reg / 4] = val;
+	return 0;
+}
+
+static const struct regmap_bus asic3_tmio_test_bus = {
+	.fast_io = true, .reg_read = asic3_tmio_test_reg_read,
+	.reg_write = asic3_tmio_test_reg_write,
+};
+
+static void asic3_tmio_test_unregister(void *pdev)
+{
+	platform_device_unregister(pdev);
+}
+
+static void asic3_tmio_test_cleanup(void *data)
+{
+	struct asic3_tmio_test *ctx = data;
+
+	WRITE_ONCE(ctx->priv.stopping, true);
+	flush_work(&ctx->priv.work);
+	cancel_delayed_work_sync(&ctx->priv.host->delayed_reset_work);
+	cancel_work_sync(&ctx->priv.host->done);
+}
+
+static void asic3_tmio_test_done(struct mmc_request *request)
+{
+	struct asic3_tmio_test *ctx = container_of(request, struct asic3_tmio_test, request);
+
+	ctx->complete++;
+	if (ctx->resubmit && ctx->complete == 1) {
+		/* Plain RAM stores W0C acknowledge values; BUSY is read-only in silicon. */
+		writew(0, ctx->priv.asic.regs + SD_BUFFER_STATUS);
+		asic3_tmio_request(ctx->priv.host->mmc, request);
+	}
+}
+
+static int asic3_tmio_test_write_hook(struct tmio_mmc_host *host, int addr)
+{
+	struct asic3_tmio_test *ctx = container_of(asic3_tmio_priv(host),
+						 struct asic3_tmio_test, priv);
+
+	if (ctx->count < ARRAY_SIZE(ctx->writes))
+		ctx->writes[ctx->count] = addr;
+	ctx->count++;
+	if (addr == CTL_SD_CMD) {
+		if (ctx->respond_on_command) {
+			/* Supply a completed command before the first poll. Ordinary RAM
+			 * cannot implement the chip's W0C status-register side effects.
+			 */
+			writew(0x5678, ctx->priv.asic.regs + SD_RESPONSE);
+			writew(0x1234, ctx->priv.asic.regs + SD_RESPONSE + 4);
+			writew(0, ctx->priv.asic.regs + SD_BUFFER_STATUS);
+			writew(TMIO_STAT_CMDRESPEND, ctx->priv.asic.regs + SD_STATUS);
+		}
+		if (ctx->stop_on_command)
+			WRITE_ONCE(ctx->priv.stopping, true);
+		complete(&ctx->command_written);
+	}
+	return 0;
+}
+
+static int asic3_tmio_test_init(struct kunit *test)
+{
+	const struct property_entry props[] = {
+		PROPERTY_ENTRY_U32("bus-width", 4),
+		PROPERTY_ENTRY_U32("max-frequency", 24576000),
+		PROPERTY_ENTRY_BOOL("cap-sd-highspeed"),
+		{}
+	};
+	const struct regmap_config config = {
+		.reg_bits = 32, .val_bits = 16, .reg_stride = 4, .max_register = 0x1ffc,
+	};
+	struct asic3_tmio_test *ctx;
+	struct tmio_mmc_host *host;
+	void *regs;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	init_completion(&ctx->command_written);
+	ctx->pdev = platform_device_register_simple("asic3-tmio-kunit", -1, NULL, 0);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->pdev);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+		asic3_tmio_test_unregister, ctx->pdev), 0);
+	KUNIT_ASSERT_EQ(test, device_create_managed_software_node(&ctx->pdev->dev,
+		props, NULL), 0);
+	regs = kunit_kzalloc(test, 0x2000, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, regs);
+	ctx->priv.asic.regs = (void __iomem *)regs;
+	ctx->priv.asic.control = devm_regmap_init(&ctx->pdev->dev,
+		&asic3_tmio_test_bus, ctx, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->priv.asic.control);
+	ctx->priv.asic.control_base = 0xa00;
+	ctx->priv.pdata.flags = TMIO_MMC_ABORT_DATA_ON_CMD_ERROR | TMIO_MMC_KEEP_POWER;
+	host = tmio_mmc_host_alloc_mapped(ctx->pdev, &ctx->priv.pdata,
+					ctx->priv.asic.regs + SD_COMMAND);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, host);
+	asic3_tmio_init(&ctx->priv, host);
+	KUNIT_ASSERT_EQ(test, asic3_sd_configure_mmc(host->mmc), 0);
+	ctx->priv.prepared = true;
+	ctx->priv.irq_enabled = true;
+	host->sdcard_irq_mask = ~0U;
+	host->write16_hook = asic3_tmio_test_write_hook;
+	ctx->request.cmd = &ctx->command;
+	ctx->request.done = asic3_tmio_test_done;
+	ctx->command.flags = MMC_RSP_R1;
+	ctx->command.opcode = MMC_SEND_STATUS;
+	ctx->command.arg = 0x1234abcd;
+	ctx->command.resp[0] = 0x12345678;
+	ctx->command.resp[1] = 0x11223344;
+	ctx->command.resp[2] = 0x55667788;
+	ctx->command.resp[3] = 0x99aabbcc;
+	writew(0x0200, ctx->priv.asic.regs + CFG_POWER);
+	writew(0xc0ee, ctx->priv.asic.regs + SD_OPTION);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+		asic3_tmio_test_cleanup, ctx), 0);
+	test->priv = ctx;
+	return 0;
+}
+
+static void asic3_tmio_test_submit(struct asic3_tmio_test *ctx)
+{
+	ctx->priv.host->ops.request(ctx->priv.host->mmc, &ctx->request);
+	flush_work(&ctx->priv.work);
+}
+
+static void asic3_tmio_test_irq(struct asic3_tmio_test *ctx, unsigned int status)
+{
+	writew(status, ctx->priv.asic.regs + SD_STATUS);
+	writew(status >> 16, ctx->priv.asic.regs + SD_BUFFER_STATUS);
+	tmio_mmc_irq(0, ctx->priv.host);
+	flush_work(&ctx->priv.host->done);
+}
+
+static void asic3_tmio_test_read(struct asic3_tmio_test *ctx)
+{
+	memset(ctx->bytes, 0x5a, sizeof(ctx->bytes));
+	sg_init_table(ctx->sg, 2);
+	sg_set_buf(&ctx->sg[0], &ctx->bytes[0], 1);
+	sg_set_buf(&ctx->sg[1], &ctx->bytes[1], 1);
+	ctx->request.data = &ctx->data;
+	ctx->command.opcode = MMC_READ_SINGLE_BLOCK;
+	ctx->command.flags = MMC_RSP_R1 | MMC_CMD_ADTC;
+	ctx->data.flags = MMC_DATA_READ;
+	ctx->data.blksz = 2;
+	ctx->data.blocks = 1;
+	ctx->data.sg = ctx->sg;
+	ctx->data.sg_len = 2;
+	writew(0xabcd, ctx->priv.asic.regs + SD_DATA);
+}
+
+static void asic3_tmio_firmware_role_limits(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	struct mmc_host *mmc = ctx->priv.host->mmc;
+
+	KUNIT_EXPECT_EQ(test, mmc->caps, (unsigned int)MMC_CAP_NONREMOVABLE);
+	KUNIT_EXPECT_EQ(test, mmc->caps2, (unsigned int)(MMC_CAP2_NO_MMC | MMC_CAP2_NO_SDIO));
+	KUNIT_EXPECT_EQ(test, mmc->f_min, 192000U);
+	KUNIT_EXPECT_EQ(test, mmc->f_max, 384000U);
+	KUNIT_EXPECT_EQ(test, mmc->max_req_size, (unsigned int)PAGE_SIZE);
+	KUNIT_EXPECT_EQ(test, mmc->max_blk_count, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->priv.host->ops.get_ro(mmc), 1);
+	mmc->f_max = 250000;
+	KUNIT_ASSERT_EQ(test, asic3_sd_configure_mmc(mmc), 0);
+	KUNIT_EXPECT_EQ(test, mmc->f_max, 250000U);
+	mmc->f_max = 191999;
+	KUNIT_EXPECT_EQ(test, asic3_sd_configure_mmc(mmc), -EINVAL);
+}
+
+static void asic3_tmio_command_encoding(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	static const struct { unsigned int opcode, flags, expected; } commands[] = {
+		{ MMC_APP_CMD, MMC_RSP_R1, MMC_APP_CMD | CMD_APP_PREFIX | CMD_R1 },
+		{ MMC_GO_IDLE_STATE, MMC_RSP_NONE, CMD_IDLE },
+		{ 15, MMC_RSP_NONE, 15 },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(commands); i++) {
+		ctx->command.opcode = commands[i].opcode;
+		ctx->command.flags = commands[i].flags;
+		ctx->count = 0;
+		asic3_tmio_test_submit(ctx);
+		KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + SD_COMMAND), commands[i].expected);
+		KUNIT_ASSERT_EQ(test, ctx->count, 3U);
+		KUNIT_EXPECT_EQ(test, ctx->writes[0], (unsigned int)CTL_ARG_REG + 2);
+		KUNIT_EXPECT_EQ(test, ctx->writes[1], (unsigned int)CTL_ARG_REG);
+		KUNIT_EXPECT_EQ(test, ctx->writes[2], (unsigned int)CTL_SD_CMD);
+		KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + SD_ARG_HI), 0x1234);
+		KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + SD_ARG_LO), 0xabcd);
+		asic3_tmio_test_irq(ctx, TMIO_STAT_CMDRESPEND);
+		KUNIT_EXPECT_EQ(test, ctx->complete, i + 1);
+		/* Ordinary RAM retains W0C acknowledge bits; inject idle explicitly. */
+		writew(0, ctx->priv.asic.regs + SD_BUFFER_STATUS);
+	}
+}
+
+static void asic3_tmio_bounce_split_read(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+
+	asic3_tmio_test_read(ctx);
+	asic3_tmio_test_submit(ctx);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->data.sg, &ctx->priv.bounce_sg);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_CMDRESPEND);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_RXRDY);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_DATAEND);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->data.error, 0);
+	KUNIT_EXPECT_EQ(test, ctx->data.bytes_xfered, 2U);
+	KUNIT_EXPECT_EQ(test, ctx->bytes[0], (u8)0xcd);
+	KUNIT_EXPECT_EQ(test, ctx->bytes[1], (u8)0xab);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->data.sg, &ctx->sg[0]);
+	KUNIT_EXPECT_EQ(test, ctx->data.sg_len, 2U);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->request.done, &asic3_tmio_test_done);
+}
+
+static void asic3_tmio_unbounced_split_difference(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+
+	asic3_tmio_test_read(ctx);
+	ctx->priv.core_request(ctx->priv.host->mmc, &ctx->request);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_CMDRESPEND);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_RXRDY);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_DATAEND);
+	/* Direct TMIO assumes a block fits its current SG segment. */
+	KUNIT_EXPECT_EQ(test, ctx->data.bytes_xfered, 2U);
+	KUNIT_EXPECT_EQ(test, ctx->bytes[0], (u8)0xcd);
+	KUNIT_EXPECT_EQ(test, ctx->bytes[1], (u8)0x5a);
+}
+
+static void asic3_tmio_early_dataend(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+
+	asic3_tmio_test_read(ctx);
+	asic3_tmio_test_submit(ctx);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_CMDRESPEND);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_DATAEND);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->data.error, -EIO);
+	KUNIT_EXPECT_EQ(test, ctx->data.bytes_xfered, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->bytes[0], (u8)0x5a);
+}
+
+static void asic3_tmio_crc_abort(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+
+	asic3_tmio_test_read(ctx);
+	asic3_tmio_test_submit(ctx);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_CMDRESPEND | TMIO_STAT_CRCFAIL);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -EILSEQ);
+	KUNIT_EXPECT_EQ(test, ctx->data.bytes_xfered, 0U);
+	KUNIT_EXPECT_TRUE(test, !!(ctx->priv.host->sdcard_irq_mask & TMIO_STAT_RXRDY));
+	KUNIT_EXPECT_PTR_EQ(test, ctx->data.sg, &ctx->sg[0]);
+}
+
+static void asic3_tmio_generic_crc_continues(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+
+	asic3_tmio_test_read(ctx);
+	ctx->priv.pdata.flags = 0;
+	ctx->priv.core_request(ctx->priv.host->mmc, &ctx->request);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_CMDRESPEND | TMIO_STAT_CRCFAIL);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 0U);
+	KUNIT_EXPECT_FALSE(test, !!(ctx->priv.host->sdcard_irq_mask & TMIO_STAT_RXRDY));
+	asic3_tmio_test_irq(ctx, TMIO_STAT_DATAEND);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 1U);
+}
+
+static void asic3_tmio_write_gate(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	struct mmc_command stop = { .opcode = MMC_ERASE, .flags = MMC_RSP_R1B };
+	void *before = kunit_kmalloc(test, 0x2000, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, before);
+	memcpy(before, (void __force *)ctx->priv.asic.regs, 0x2000);
+	ctx->command.opcode = MMC_WRITE_BLOCK;
+	asic3_tmio_test_submit(ctx);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -EROFS);
+	KUNIT_EXPECT_EQ(test, memcmp(before, (void __force *)ctx->priv.asic.regs, 0x2000), 0);
+	ctx->command.opcode = MMC_ERASE | BIT(8);
+	asic3_tmio_test_submit(ctx);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -EINVAL);
+	ctx->command.opcode = MMC_SEND_STATUS;
+	ctx->request.stop = &stop;
+	asic3_tmio_test_submit(ctx);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -EINVAL);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 3U);
+	KUNIT_EXPECT_EQ(test, memcmp(before, (void __force *)ctx->priv.asic.regs, 0x2000), 0);
+}
+
+static void asic3_tmio_timeout_preserves_slot(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	struct tmio_mmc_host *host = ctx->priv.host;
+
+	writew(0x110, ctx->priv.asic.regs + SD_CLOCK);
+	asic3_tmio_test_submit(ctx);
+	cancel_delayed_work_sync(&host->delayed_reset_work);
+	host->last_req_ts = jiffies - msecs_to_jiffies(301);
+	mod_delayed_work(system_wq, &host->delayed_reset_work, 0);
+	flush_delayed_work(&host->delayed_reset_work);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + CFG_POWER), 0x200);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + SD_CLOCK), 0x110);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->priv.request, NULL);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->request.done, &asic3_tmio_test_done);
+}
+
+static void asic3_tmio_response_contract(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	const unsigned int responses[] = {
+		MMC_RSP_NONE, MMC_RSP_R1, MMC_RSP_R1B, MMC_RSP_R2,
+		MMC_RSP_R3, MMC_RSP_R6, MMC_RSP_R7,
+	};
+	const u16 words[] = { 0x1234, 0x5678, 0x9abc, 0xdef0,
+			      0x1357, 0x2468, 0x9bdf, 0xace0 };
+	unsigned int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(responses); i++) {
+		struct mmc_command expected = ctx->command;
+
+		expected.flags = ctx->command.flags = responses[i];
+		for (j = 0; j < ARRAY_SIZE(words); j++)
+			writew(words[j], ctx->priv.asic.regs + SD_RESPONSE + 4 * j);
+		h3970_sd_read_response(ctx->priv.asic.regs, &expected);
+		asic3_tmio_test_submit(ctx);
+		asic3_tmio_test_irq(ctx, TMIO_STAT_CMDRESPEND);
+		KUNIT_EXPECT_EQ(test, ctx->complete, i + 1);
+		KUNIT_EXPECT_EQ(test, ctx->command.error, 0);
+		KUNIT_EXPECT_MEMEQ(test, expected.resp, ctx->command.resp, sizeof(expected.resp));
+		writew(0, ctx->priv.asic.regs + SD_BUFFER_STATUS);
+	}
+	/* A failed command must leave all caller response words untouched. */
+	{
+		u32 saved[4];
+
+		memcpy(saved, ctx->command.resp, sizeof(saved));
+		asic3_tmio_test_submit(ctx);
+		asic3_tmio_test_irq(ctx, TMIO_STAT_CMDTIMEOUT);
+		KUNIT_EXPECT_EQ(test, ctx->command.error, -ETIMEDOUT);
+		KUNIT_EXPECT_MEMEQ(test, saved, ctx->command.resp, sizeof(saved));
+	}
+}
+
+static void asic3_tmio_full_block_read(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	unsigned int i;
+
+	asic3_tmio_test_read(ctx);
+	sg_init_table(ctx->sg, 2);
+	sg_set_buf(&ctx->sg[0], &ctx->bytes[0], 255);
+	sg_set_buf(&ctx->sg[1], &ctx->bytes[255], 257);
+	ctx->data.blksz = 512;
+	asic3_tmio_test_submit(ctx);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_CMDRESPEND);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_RXRDY);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_DATAEND);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->data.error, 0);
+	KUNIT_EXPECT_EQ(test, ctx->data.bytes_xfered, 512U);
+	for (i = 0; i < sizeof(ctx->bytes); i++)
+		KUNIT_EXPECT_EQ(test, ctx->bytes[i], (u8)(i & 1 ? 0xab : 0xcd));
+}
+
+static void asic3_tmio_clock_power_contract(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	struct mmc_host *mmc = ctx->priv.host->mmc;
+	struct mmc_ios ios = { .bus_width = MMC_BUS_WIDTH_1, .clock = 384000,
+			       .power_mode = MMC_POWER_UP };
+
+	mmc->ops->set_ios(mmc, &ios);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + SD_CLOCK), 0x110);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + CFG_POWER), 0x200);
+	ios.clock = 192000;
+	ios.power_mode = MMC_POWER_ON;
+	mmc->ops->set_ios(mmc, &ios);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + SD_CLOCK), 0x120);
+	ios.power_mode = MMC_POWER_OFF;
+	mmc->ops->set_ios(mmc, &ios);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + SD_CLOCK), 0);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + CFG_POWER), 0x200);
+}
+
+static void asic3_tmio_busy_and_stopping(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+
+	writew(BUFFER_BUSY, ctx->priv.asic.regs + SD_BUFFER_STATUS);
+	writew(0x55aa, ctx->priv.asic.regs + SD_COMMAND);
+	asic3_tmio_test_submit(ctx);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 1U);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + SD_COMMAND), 0x55aa);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->priv.request, NULL);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->request.done, &asic3_tmio_test_done);
+	WRITE_ONCE(ctx->priv.stopping, true);
+	asic3_tmio_test_submit(ctx);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -ENODEV);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 2U);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + SD_COMMAND), 0x55aa);
+}
+
+static void asic3_tmio_polled_request_reuse(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	unsigned int i;
+
+	ctx->priv.polling = true;
+	ctx->priv.irq_enabled = false;
+	ctx->resubmit = true;
+	ctx->respond_on_command = true;
+	asic3_tmio_request(ctx->priv.host->mmc, &ctx->request);
+	for (i = 0; i < 2; i++) {
+		KUNIT_ASSERT_NE_MSG(test, wait_for_completion_timeout(&ctx->command_written,
+							 msecs_to_jiffies(100)), 0UL,
+				    "command %u, completed %u", i + 1, ctx->complete);
+	}
+	flush_work(&ctx->priv.work);
+	flush_work(&ctx->priv.host->done);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 2U);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, 0);
+	KUNIT_EXPECT_EQ(test, ctx->command.resp[0], 0x12345678U);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->priv.request, NULL);
+	KUNIT_EXPECT_FALSE(test, ctx->priv.irq_enabled);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->request.host, NULL);
+}
+
+static void asic3_tmio_synchronous_core_request(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	struct mmc_host *mmc = ctx->priv.host->mmc;
+	int ret;
+
+	ctx->priv.polling = true;
+	ctx->priv.irq_enabled = false;
+	ctx->respond_on_command = true;
+	ctx->command.opcode = MMC_GO_IDLE_STATE;
+	ctx->command.flags = MMC_RSP_NONE;
+	ctx->command.arg = 0;
+	mmc_claim_host(mmc);
+	/* This real core entry creates a synchronous request with host == NULL. */
+	ret = mmc_wait_for_cmd(mmc, &ctx->command, 0);
+	mmc_release_host(mmc);
+	flush_work(&ctx->priv.work);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->priv.request, NULL);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->priv.original_host, NULL);
+}
+
+static void asic3_tmio_existing_host_context(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	struct mmc_host *mmc = ctx->priv.host->mmc;
+
+	ctx->request.host = mmc;
+	asic3_tmio_test_submit(ctx);
+	asic3_tmio_test_irq(ctx, TMIO_STAT_CMDRESPEND);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 1U);
+	KUNIT_EXPECT_PTR_EQ(test, ctx->request.host, mmc);
+}
+
+static void asic3_tmio_polled_stop_timeout(struct kunit *test)
+{
+	struct asic3_tmio_test *ctx = test->priv;
+	struct tmio_mmc_host *host = ctx->priv.host;
+
+	ctx->priv.polling = true;
+	ctx->priv.irq_enabled = false;
+	ctx->stop_on_command = true;
+	asic3_tmio_request(host->mmc, &ctx->request);
+	KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&ctx->command_written,
+						 msecs_to_jiffies(100)), 0UL);
+	WRITE_ONCE(ctx->priv.stopping, true);
+	flush_work(&ctx->priv.work);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 0U);
+	cancel_delayed_work_sync(&host->delayed_reset_work);
+	host->last_req_ts = jiffies - msecs_to_jiffies(301);
+	mod_delayed_work(system_wq, &host->delayed_reset_work, 0);
+	flush_delayed_work(&host->delayed_reset_work);
+	KUNIT_EXPECT_EQ(test, ctx->complete, 1U);
+	KUNIT_EXPECT_EQ(test, ctx->command.error, -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, readw(ctx->priv.asic.regs + CFG_POWER), 0x200);
+	KUNIT_EXPECT_FALSE(test, ctx->priv.irq_enabled);
+}
+
+static struct kunit_case asic3_tmio_test_cases[] = {
+	KUNIT_CASE(asic3_tmio_synchronous_core_request),
+	KUNIT_CASE(asic3_tmio_existing_host_context),
+	KUNIT_CASE(asic3_tmio_polled_request_reuse),
+	KUNIT_CASE(asic3_tmio_polled_stop_timeout),
+	KUNIT_CASE(asic3_tmio_response_contract),
+	KUNIT_CASE(asic3_tmio_full_block_read),
+	KUNIT_CASE(asic3_tmio_clock_power_contract),
+	KUNIT_CASE(asic3_tmio_busy_and_stopping),
+	KUNIT_CASE(asic3_tmio_firmware_role_limits),
+	KUNIT_CASE(asic3_tmio_command_encoding),
+	KUNIT_CASE(asic3_tmio_bounce_split_read),
+	KUNIT_CASE(asic3_tmio_unbounced_split_difference),
+	KUNIT_CASE(asic3_tmio_early_dataend),
+	KUNIT_CASE(asic3_tmio_crc_abort),
+	KUNIT_CASE(asic3_tmio_generic_crc_continues),
+	KUNIT_CASE(asic3_tmio_write_gate),
+	KUNIT_CASE(asic3_tmio_timeout_preserves_slot),
+	{}
+};
+
+static struct kunit_suite asic3_tmio_test_suite = {
+	.name = "asic3-tmio-engine", .init = asic3_tmio_test_init,
+	.test_cases = asic3_tmio_test_cases,
+};
+kunit_test_suite(asic3_tmio_test_suite);
