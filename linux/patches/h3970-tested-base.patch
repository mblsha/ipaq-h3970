index 0000000000000000000000000000000000000000..58d91caaf7629f07292a518f706f99f7fc7365f3
--- /dev/null
+++ b/Documentation/devicetree/bindings/cpufreq/marvell,pxa2xx-cpufreq.yaml
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/cpufreq/marvell,pxa2xx-cpufreq.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: PXA2xx CPU frequency resources
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  PXA25x and PXA27x CPU clocks use a PXA-specific transition sequence.
+  Available OPPs describe board constraints on the rates implemented by that
+  sequence. The driver also restricts the table to rates that preserve the
+  current memory clock, until memory retiming is implemented.
+
+  The core clock is the first clock; memory is the memory-timing reference
+  (CLK_MEMORY). An optional cpu-supply describes a controllable core rail.
+  Without a supply description the existing firmware/board voltage contract
+  remains in effect. Describing OPP voltages alone does not control a rail.
+
+  PXA25x run/turbo selection at the same CPU frequency is runtime policy,
+  not a second OPP with a duplicate opp-hz. PXA turbo clocking does not imply
+  the OPP turbo-mode boost property.
+
+select:
+  properties:
+    compatible:
+      const: marvell,xscale
+  required:
+    - compatible
+
+properties:
+  compatible:
+    const: marvell,xscale
+
+  clocks:
+    items:
+      - description: CPU core clock
+      - description: Memory-timing reference clock
+
+  clock-names:
+    items:
+      - const: core
+      - const: memory
+
+  operating-points-v2: true
+
+  cpu-supply: true
+
+dependencies:
+  clocks: [clock-names]
+  clock-names: [clocks]
+
+additionalProperties: true
+
+examples:
+  - |
+    #include <dt-bindings/clock/pxa-clock.h>
+    cpus {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        cpu@0 {
+            compatible = "marvell,xscale";
+            device_type = "cpu";
+            reg = <0>;
+            clocks = <&clks CLK_CORE>, <&clks CLK_MEMORY>;
+            clock-names = "core", "memory";
+            operating-points-v2 = <&cpu_opp_table>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/gpio/compaq,asic-gpio.yaml b/Documentation/devicetree/bindings/gpio/compaq,asic-gpio.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..1dda52857da8426fd74eb2e5629d64badcd238b7
--- /dev/null
+++ b/Documentation/devicetree/bindings/gpio/compaq,asic-gpio.yaml
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/compaq,asic-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Compaq ASIC2 and ASIC3 GPIO banks
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  GPIO functions below an ASIC2 or ASIC3 companion parent, sharing its register
+  map. ASIC2 exposes its 16 GPIO lines; the separate KPIO block is not part of
+  the GPIO line namespace. When described as an interrupt controller, this ASIC2
+  function also owns the GPIO and KPIO IRQ masks. Hardware IRQ numbers are
+  GPIO0-11, KPIO32-43 and special KPIO48-55, using the constants in
+  dt-bindings/interrupt-controller/compaq,asic2.h. ASIC3 exposes 64 lines: banks A through D at indices 0-15,
+  16-31, 32-47 and 48-63. Use ASIC3_GPIO() and the bank constants from
+  dt-bindings/gpio/compaq,asic3.h. The parent handles register bus spacing.
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: compaq,asic2-gpio
+    then:
+      properties:
+        gpio-line-names:
+          maxItems: 16
+    else:
+      properties:
+        gpio-line-names:
+          maxItems: 64
+        interrupt-controller: false
+        "#interrupt-cells": false
+        interrupts: false
+        clocks: false
+        clock-names: false
+
+properties:
+  compatible:
+    enum:
+      - compaq,asic2-gpio
+      - compaq,asic3-gpio
+
+  gpio-reserved-ranges: true
+
+  gpio-line-names:
+    minItems: 1
+    maxItems: 64
+
+  gpio-controller: true
+
+  "#gpio-cells":
+    const: 2
+    description: GPIO index and standard GPIO flags.
+
+  "#address-cells":
+    const: 0
+
+  interrupt-controller: true
+
+  "#interrupt-cells":
+    const: 2
+    description: ASIC2 hardware IRQ number and standard IRQ trigger flags.
+
+  interrupts:
+    maxItems: 1
+    description: ASIC2 parent interrupt signal.
+
+  clocks:
+    maxItems: 1
+    description: ASIC2 EX0 output clock.
+
+  clock-names:
+    const: irq
+
+required:
+  - compatible
+  - gpio-controller
+  - "#gpio-cells"
+
+dependencies:
+  interrupt-controller: [ "#interrupt-cells", interrupts, clocks, clock-names ]
+  "#interrupt-cells": [ interrupt-controller ]
+  interrupts: [ interrupt-controller ]
+  clocks: [ interrupt-controller ]
+  clock-names: [ interrupt-controller ]
+
+patternProperties:
+  "^.+-hog(-[0-9]+)?$":
+    type: object
+    required:
+      - gpio-hog
+
+additionalProperties: false
+
+examples:
+  - |
+    gpio {
+        compatible = "compaq,asic3-gpio";
+        gpio-controller;
+        #gpio-cells = <2>;
+    };
