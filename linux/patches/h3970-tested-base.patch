@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/compaq,h3970-asic2-clocks.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Legacy standalone Compaq ASIC2 clocks
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  Older H3970 descriptions expose only the four-byte ASIC2 clock-enable
+  register. New descriptions use the shared compaq,asic2 companion parent.
+  Clock indices are defined in dt-bindings/clock/compaq,asic2.h; existing
+  EX1, ADC, SD and audio indices remain unchanged. The legacy standalone
+  interface uses the fixed 24.576 MHz EX1 and 32.768 kHz EX0 inputs.
+
+properties:
+  compatible:
+    const: compaq,h3970-asic2-clocks
+    deprecated: true
+
+  reg:
+    maxItems: 1
+    description: Four-byte clock-enable register window.
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@15001000 {
+        compatible = "compaq,h3970-asic2-clocks";
+        reg = <0x15001000 0x4>;
+        #clock-cells = <1>;
+    };
