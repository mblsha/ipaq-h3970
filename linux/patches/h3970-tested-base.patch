+static void uda1380_default_and_invalid_resources(struct kunit *test)
+{
+	static const struct property_entry invalid[] = {
+		PROPERTY_ENTRY_STRING("dac-clk", "invalid"), {}
+	};
+	static const struct software_node defaults = {};
+	static const struct software_node bad_clock = { .properties = invalid };
+	struct uda1380_priv priv = {};
+	struct device *dev;
+	int ret;
+
+	dev = kunit_device_register(test, "uda1380-no-resources");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	KUNIT_EXPECT_EQ(test, uda1380_get_resources(dev, &priv), -EINVAL);
+	KUNIT_ASSERT_EQ(test, device_add_software_node(dev, &defaults), 0);
+	ret = kunit_add_action_or_reset(test, uda_test_remove_device_node, dev);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_EQ(test, uda1380_get_resources(dev, &priv), 0);
+	KUNIT_EXPECT_EQ(test, priv.dac_clk, (unsigned int)UDA1380_DAC_CLK_SYSCLK);
+	KUNIT_EXPECT_PTR_EQ(test, priv.power, NULL);
+	KUNIT_EXPECT_PTR_EQ(test, priv.reset, NULL);
+	KUNIT_EXPECT_PTR_EQ(test, priv.sysclk, NULL);
+	device_remove_software_node(dev);
+	KUNIT_ASSERT_EQ(test, device_add_software_node(dev, &bad_clock), 0);
+	KUNIT_EXPECT_EQ(test, uda1380_get_resources(dev, &priv), -EINVAL);
+}
