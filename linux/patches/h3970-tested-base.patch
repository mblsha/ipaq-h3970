+	KUNIT_CASE(h3970_touch_irq_open_close),
+	KUNIT_CASE(h3970_touch_irq_press_release),
+	KUNIT_CASE(h3970_touch_irq_poll_race),
+	KUNIT_CASE(h3970_touch_irq_stop_final),
+	KUNIT_CASE(h3970_touch_pen_ownership),
+	KUNIT_CASE(h3970_touch_pen_read_error),
+	KUNIT_CASE(h3970_touch_poll_disabled),
+	KUNIT_CASE(h3970_touch_irq_adc_recovery),
+	KUNIT_CASE(h3970_touch_resource_mismatch),
+	KUNIT_CASE(h3970_touch_resource_defer),
+	{}
+};
+
+static struct kunit_suite h3970_touch_test_suite = {
+	.name = "h3970-touch-transaction",
+	.init = h3970_touch_test_init,
+	.test_cases = h3970_touch_test_cases,
+};
+
+kunit_test_suite(h3970_touch_test_suite);
