diff --git a/sound/soc/codecs/uda1380-test.c b/sound/soc/codecs/uda1380-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..6007323829b25dadbf498b6ec21271661a37f82d
--- /dev/null
+++ b/sound/soc/codecs/uda1380-test.c
@@ -0,0 +1,1139 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Resource and cache contracts; uses real I2C, GPIO and clock frameworks. */
+#include <kunit/device.h>
+#include <kunit/test.h>
+#include <linux/clk-provider.h>
+#include <linux/clkdev.h>
+#include <linux/completion.h>
+#include <linux/gpio/driver.h>
+#include <linux/gpio/machine.h>
+#include <linux/platform_device.h>
+#include <linux/kthread.h>
+#include <linux/sched/task.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/machine.h>
+
+#define UDA_TEST_CLK_ON 100
+#define UDA_TEST_CLK_OFF 101
+#define UDA_TEST_GPIO(pin, value) (200 + 2 * (pin) + (value))
+#define UDA_TEST_WRITE(reg) (300 + (reg))
+
+struct uda1380_test {
+	struct uda1380_priv priv;
+	struct snd_soc_component component;
+	struct i2c_adapter adapter;
+	struct gpio_chip gpio;
+	struct clk_hw hw;
+	struct gpiod_lookup_table *lookup;
+	struct software_node node;
+	unsigned int events[256];
+	unsigned int nevents;
+	unsigned int transfers;
+	unsigned int fail_transfer;
+	unsigned int unclocked_io;
+	int fail_gpio;
+	int fail_prepare;
+	int gpio_values[3];
+	u16 registers[256];
+	u8 selected;
+	bool clock_on;
+	bool corrupt_read;
+	bool probed;
+	bool lookup_registered;
+	bool amp_supply_on;
+	struct regulator_dev *amp_rdev;
+	bool selection_lost_at_stop;
+	bool short_combined_read;
+	bool watch_wspll;
+	unsigned int dsp_io_after_wspll_stop;
+	struct completion flush_entered;
+	struct completion flush_release;
+	struct completion shutdown_entered;
+	struct completion shutdown_done;
+	bool test_dac_power_down;
+	unsigned int invalid_reg_writes;
+};
+
+static void uda_test_event(struct uda1380_test *ctx, unsigned int event)
+{
+	if (ctx->nevents < ARRAY_SIZE(ctx->events))
+		ctx->events[ctx->nevents++] = event;
+}
+
+static int uda_test_xfer(struct i2c_adapter *adapter, struct i2c_msg *msgs, int num)
+{
+	struct uda1380_test *ctx = i2c_get_adapdata(adapter);
+	struct i2c_msg *msg = &msgs[0];
+
+	ctx->transfers++;
+	if (!ctx->clock_on)
+		ctx->unclocked_io++;
+	if (ctx->transfers == ctx->fail_transfer)
+		return 0; /* A short transfer, including on register/readback requests. */
+	if (msg->addr != 0x18)
+		return -EINVAL;
+	if (num == 2) {
+		if (msg->flags & I2C_M_RD || msg->len != 1 ||
+		    msgs[1].addr != 0x18 || !(msgs[1].flags & I2C_M_RD) || msgs[1].len != 2)
+			return -EINVAL;
+		ctx->selected = msg->buf[0];
+		if (ctx->short_combined_read)
+			return 1;
+		msg = &msgs[1];
+	} else if (num != 1) {
+		return -EINVAL;
+	}
+	if (msg->flags & I2C_M_RD) {
+		u16 value = ctx->registers[ctx->selected];
+
+		if (msg->len != 2)
+			return -EINVAL;
+		if (ctx->corrupt_read)
+			value ^= 1;
+		msg->buf[0] = value >> 8;
+		msg->buf[1] = value;
+	} else if (msg->len == 1) {
+		ctx->selected = ctx->selection_lost_at_stop ? 0xff : msg->buf[0];
+	} else if (msg->len == 3) {
+		u8 reg = msg->buf[0];
+
+		if (reg > 0x04 && (reg < 0x10 || reg > 0x14) &&
+		    (reg < 0x20 || reg > 0x23) && reg != 0x7f) {
+			ctx->invalid_reg_writes++;
+			return num; /* Reserved/status writes have no effect. */
+		}
+		if (ctx->watch_wspll && reg >= UDA1380_MVOL &&
+		    !(ctx->registers[UDA1380_PM] & R02_PON_PLL))
+			ctx->dsp_io_after_wspll_stop++;
+		uda_test_event(ctx, UDA_TEST_WRITE(reg));
+		ctx->registers[reg] = msg->buf[1] << 8 | msg->buf[2];
+	} else {
+		return -EINVAL;
+	}
+	return num;
+}
+
+static u32 uda_test_functionality(struct i2c_adapter *adapter)
+{
+	return I2C_FUNC_I2C;
+}
+
+static const struct i2c_algorithm uda_test_algorithm = {
+	.xfer = uda_test_xfer,
+	.functionality = uda_test_functionality,
+};
+
+static int uda_test_gpio_set(struct gpio_chip *chip, unsigned int pin, int value)
+{
+	struct uda1380_test *ctx = gpiochip_get_data(chip);
+
+	uda_test_event(ctx, UDA_TEST_GPIO(pin, value));
+	if (ctx->fail_gpio == pin && value)
+		return -EIO;
+	ctx->gpio_values[pin] = value;
+	return 0;
+}
+
+static int uda_test_gpio_get(struct gpio_chip *chip, unsigned int pin)
+{
+	struct uda1380_test *ctx = gpiochip_get_data(chip);
+
+	return ctx->gpio_values[pin];
+}
+
+static int uda_test_gpio_direction(struct gpio_chip *chip, unsigned int pin)
+{
+	return 0;
+}
+
+static int uda_test_prepare(struct clk_hw *hw)
+{
+	struct uda1380_test *ctx = container_of(hw, struct uda1380_test, hw);
+
+	if (ctx->fail_prepare)
+		return ctx->fail_prepare;
+	ctx->clock_on = true;
+	uda_test_event(ctx, UDA_TEST_CLK_ON);
+	return 0;
+}
+
+static void uda_test_unprepare(struct clk_hw *hw)
+{
+	struct uda1380_test *ctx = container_of(hw, struct uda1380_test, hw);
+
+	uda_test_event(ctx, UDA_TEST_CLK_OFF);
+	ctx->clock_on = false;
+}
+
+static const struct clk_ops uda_test_clk_ops = {
+	.prepare = uda_test_prepare,
+	.unprepare = uda_test_unprepare,
+};
+
+static void uda_test_del_adapter(void *data)
+{
+	i2c_del_adapter(data);
+}
+
+static void uda_test_del_client(void *data)
+{
+	i2c_unregister_device(data);
+}
+
+static void uda_test_del_node(void *data)
+{
+	software_node_unregister(data);
+}
+
+static void uda_test_del_lookup(void *data)
+{
+	struct uda1380_test *ctx = data;
+
+	if (ctx->lookup_registered)
+		gpiod_remove_lookup_table(ctx->lookup);
+}
+
+static void uda_test_drop_clock(void *data)
+{
+	clkdev_drop(data);
+}
+
+static void uda_test_remove(void *data)
+{
+	struct uda1380_test *ctx = data;
+
+	if (ctx->probed)
+		uda1380_remove(&ctx->component);
+}
+
+static int uda1380_test_init(struct kunit *test)
+{
+	static const struct property_entry props[] = {
+		PROPERTY_ENTRY_STRING("dac-clk", "wspll"),
+		{}
+	};
+	const struct clk_init_data init = {
+		.name = "uda1380-kunit-sysclk",
+		.ops = &uda_test_clk_ops,
+	};
+	struct i2c_board_info info = { I2C_BOARD_INFO("dummy", 0x18) };
+	struct uda1380_test *ctx;
+	struct clk_lookup *cl;
+	struct i2c_client *client;
+	struct device *dev;
+	int ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	test->priv = ctx;
+	ctx->fail_gpio = -1;
+	dev = kunit_device_register(test, "uda1380-kunit");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+
+	ctx->gpio = (struct gpio_chip) {
+		.label = "uda1380-kunit-gpio",
+		.parent = dev,
+		.owner = THIS_MODULE,
+		.base = -1,
+		.ngpio = 3,
+		.can_sleep = true,
+		.get = uda_test_gpio_get,
+		.set = uda_test_gpio_set,
+		.get_direction = uda_test_gpio_direction,
+		.direction_output = uda_test_gpio_set,
+	};
+	ret = devm_gpiochip_add_data(dev, &ctx->gpio, ctx);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	ctx->hw.init = &init;
+	ret = devm_clk_hw_register(dev, &ctx->hw);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	ctx->adapter.owner = THIS_MODULE;
+	ctx->adapter.algo = &uda_test_algorithm;
+	ctx->adapter.dev.parent = dev;
+	strscpy(ctx->adapter.name, "uda1380-kunit");
+	i2c_set_adapdata(&ctx->adapter, ctx);
+	ret = i2c_add_adapter(&ctx->adapter);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	ret = kunit_add_action_or_reset(test, uda_test_del_adapter, &ctx->adapter);
+	if (ret)
+		return ret;
+
+	ctx->node.name = "uda1380-kunit-codec";
+	ctx->node.properties = props;
+	ret = software_node_register(&ctx->node);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	ret = kunit_add_action_or_reset(test, uda_test_del_node, &ctx->node);
+	if (ret)
+		return ret;
+	info.swnode = &ctx->node;
+	client = i2c_new_client_device(&ctx->adapter, &info);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, client);
+	ret = kunit_add_action_or_reset(test, uda_test_del_client, client);
+	if (ret)
+		return ret;
+
+	ctx->lookup = kunit_kzalloc(test, struct_size(ctx->lookup, table, 3), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->lookup);
+	ctx->lookup->dev_id = dev_name(&client->dev);
+	ctx->lookup->table[0] = (struct gpiod_lookup)
+		GPIO_LOOKUP("uda1380-kunit-gpio", 0, "reset", GPIO_ACTIVE_HIGH);
+	ctx->lookup->table[1] = (struct gpiod_lookup)
+		GPIO_LOOKUP("uda1380-kunit-gpio", 1, "power", GPIO_ACTIVE_HIGH);
+	gpiod_add_lookup_table(ctx->lookup);
+	ctx->lookup_registered = true;
+	ret = kunit_add_action_or_reset(test, uda_test_del_lookup, ctx);
+	if (ret)
+		return ret;
+	cl = clkdev_hw_create(&ctx->hw, "sysclk", "%s", dev_name(&client->dev));
+	KUNIT_ASSERT_NOT_NULL(test, cl);
+	ret = kunit_add_action_or_reset(test, uda_test_drop_clock, cl);
+	if (ret)
+		return ret;
+
+	ctx->priv.i2c = client;
+	ctx->priv.reg_cache = kunit_kmalloc(test, sizeof(uda1380_reg), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->priv.reg_cache);
+	memcpy(ctx->priv.reg_cache, uda1380_reg, sizeof(uda1380_reg));
+	ctx->component.dev = &client->dev;
+	ctx->component.driver = &soc_component_dev_uda1380;
+	snd_soc_component_set_drvdata(&ctx->component, &ctx->priv);
+	return kunit_add_action_or_reset(test, uda_test_remove, ctx);
+}
