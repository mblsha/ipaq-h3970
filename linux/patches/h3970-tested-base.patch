diff --git a/drivers/mmc/host/asic3-sd.h b/drivers/mmc/host/asic3-sd.h
new file mode 100644
index 0000000000000000000000000000000000000000..9ef385cbc13cdebde674452472183ce4c538e27f
--- /dev/null
+++ b/drivers/mmc/host/asic3-sd.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASIC3_SD_H
+#define _ASIC3_SD_H
+
+#include <linux/errno.h>
+#include <linux/mmc/host.h>
+#include <linux/mmc/mmc.h>
+
+/* Read-only, single-block contract for ASIC3 development hosts. */
+static inline int asic3_sd_validate_readonly_request(const struct mmc_request *mrq,
+						     unsigned int max_block_size)
+{
+	const struct mmc_command *cmd = mrq->cmd;
+	const struct mmc_data *data = mrq->data;
+
+	/* Hardware command indices are six bits; reject encoded aliases. */
+	if (cmd->opcode > 63)
+		return -EINVAL;
+	if (data && (data->flags & MMC_DATA_WRITE))
+		return -EROFS;
+
+	/* Direct requests must not bypass the gate by omitting their payload. */
+	switch (cmd->opcode) {
+	case MMC_WRITE_BLOCK:
+	case MMC_WRITE_MULTIPLE_BLOCK:
+	case MMC_PROGRAM_CID:
+	case MMC_PROGRAM_CSD:
+	case MMC_SET_WRITE_PROT:
+	case MMC_CLR_WRITE_PROT:
+	case MMC_ERASE:
+	case MMC_LOCK_UNLOCK:
+		return -EROFS;
+	case MMC_GEN_CMD:
+		if (!(cmd->arg & 1))
+			return -EROFS;
+		break;
+	}
+
+	if (data && (!(data->flags & MMC_DATA_READ) || data->blocks != 1 ||
+		     data->blksz < 2 || (data->blksz & 1) ||
+		     data->blksz > max_block_size))
+		return -EINVAL;
+	return 0;
+}
+
+#endif
diff --git a/drivers/mmc/host/compaq-asic3-mmc-core.c b/drivers/mmc/host/compaq-asic3-mmc-core.c
new file mode 100644
index 0000000000000000000000000000000000000000..3e5a72f6449819662a6ba52b620263d1b976774c
--- /dev/null
+++ b/drivers/mmc/host/compaq-asic3-mmc-core.c
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* ASIC3 SD cell registers and retained-power development contract. */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/compaq-asic.h>
+#include <linux/mmc/host.h>
+#include <linux/mmc/mmc.h>
+#include <linux/mmc/sd.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/platform_data/tmio.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/scatterlist.h>
+#include <linux/workqueue.h>
+
+#include "asic3-sd.h"
+#include "tmio_mmc.h"
+
+#include "compaq-asic3-mmc.h"
+
+static void update16(struct asic3_sd *host, unsigned int reg, u16 mask, u16 value)
+{
+	/* Force the write to retain the hardware initialization sequence. */
+	regmap_write_bits(host->control, host->control_base + reg, mask, value);
+}
+
+void asic3_sd_program_clock(struct asic3_sd *host, struct mmc_ios *ios)
+{
+	void __iomem *regs = host->regs;
+
+	writew(0, regs + SD_CLOCK);
+	if (ios->clock) {
+		/* ASIC2 supplies 24.576 MHz. Stay below 400 kHz for Glasgow. */
+		writew(1, regs + CFG_CLOCK_MODE);
+		writew(SD_CLOCK_ENABLE | (ios->clock >= 384000 ?
+		       SD_CLOCK_DIV_64 : SD_CLOCK_DIV_128), regs + SD_CLOCK);
+	}
+	/* Keep slot VDD asserted across rescans and kexec. */
+}
+
+int asic3_sd_get_ro(struct mmc_host *mmc)
+{
+	return 1;
+}
+
+void asic3_sd_prepare(struct asic3_sd *host)
+{
+	void __iomem *regs = host->regs;
+
+	update16(host, ASIC3_SD_HWCTRL,
+		 ASIC3_SD_SUSPEND | ASIC3_SD_CLEAR | ASIC3_SD_CD_WP, ASIC3_SD_CD_WP);
+	update16(host, ASIC3_CLOCK_ENABLE, ASIC3_EX0_EX1, ASIC3_EX0_EX1);
+	usleep_range(1000, 2000);
+	update16(host, ASIC3_CLOCK_SELECT, ASIC3_SD_HOST_24M | ASIC3_SD_BUS_24M,
+		 ASIC3_SD_HOST_24M);
+	update16(host, ASIC3_CLOCK_ENABLE, ASIC3_SD_CLOCKS, ASIC3_SD_CLOCKS);
+	usleep_range(1000, 2000);
+	update16(host, ASIC3_EXTCF_SELECT, ASIC3_SD_MEM_ENABLE, ASIC3_SD_MEM_ENABLE);
+	msleep(500);
+
+	writew(0, regs + CFG_ADDR_HI);
+	writew(0x0800, regs + CFG_ADDR_LO);
+	writew(0x1f, regs + CFG_CLOCK_GATE);
+	writew(2, regs + CFG_CARD_DETECT);
+	writew(2, regs + CFG_COMMAND);
+}
+
+void asic3_sd_configure(struct asic3_sd *host, bool reset, bool power)
+{
+	void __iomem *regs = host->regs;
+
+	if (reset) {
+		writew(0, regs + SD_RESET);
+		usleep_range(2000, 3000);
+		writew(1, regs + SD_RESET);
+		usleep_range(2000, 3000);
+	}
+	/* One-bit bus, no C2 module, response timeout exponent 14. */
+	writew(0xc0ee, regs + SD_OPTION);
+	writew(0, regs + SD_CLOCK);
+	writew(0, regs + SD_STOP);
+	writew(0xffff, regs + SD_STATUS_MASK);
+	writew(0xffff, regs + SD_BUFFER_MASK);
+	writew(0x0100, regs + SDIO_CLOCK_WAIT);
+	if (power) {
+		update16(host, ASIC3_SD_HWCTRL, ASIC3_SD_POWER, ASIC3_SD_POWER);
+		writew(0, regs + CFG_AUTO_POWER);
+		writew(0x0200, regs + CFG_POWER);
+		msleep(20);
+	}
+}
+
+int asic3_sd_get_control(struct platform_device *pdev, struct asic3_sd *host)
+{
+	struct device *dev = &pdev->dev;
+	struct compaq_asic *asic;
+	void __iomem *base;
+	static const struct regmap_config config = {
+		.reg_bits = 32, .val_bits = 16, .reg_stride = 4,
+		.max_register = ASIC3_EXTCF_SELECT,
+	};
+
+	asic = compaq_asic_parent(dev, COMPAQ_ASIC3);
+	if (!IS_ERR(asic)) {
+		/* The current host only implements the 32-bit-addressed SD window. */
+		if (asic->reg_shift)
+			return -EINVAL;
+		host->control = asic->map;
+		host->control_base = 0xa00;
+	} else if (PTR_ERR(asic) == -ENODEV) {
+		base = devm_platform_ioremap_resource(pdev, 1);
+		if (IS_ERR(base))
+			return PTR_ERR(base);
+		host->control = devm_regmap_init_mmio(dev, base, &config);
+		if (IS_ERR(host->control))
+			return PTR_ERR(host->control);
+	} else {
+		return PTR_ERR(asic);
+	}
+	return 0;
+}
+
+int asic3_sd_firmware_supported(struct device *dev)
+{
+	if (device_property_present(dev, "vmmc-supply") ||
+	    device_property_present(dev, "vqmmc-supply") ||
+	    device_property_present(dev, "vqmmc2-supply") ||
+	    device_property_present(dev, "mmc-pwrseq"))
+		return dev_err_probe(dev, -EOPNOTSUPP,
+				     "external slot power control is not qualified\n");
+	return 0;
+}
+
+int asic3_sd_configure_mmc(struct mmc_host *mmc)
+{
+	if (mmc->f_max && mmc->f_max < 192000)
+		return -EINVAL;
+	/* These are the development role's limits, independent of board wiring. */
+	mmc->caps = MMC_CAP_NONREMOVABLE;
+	mmc->caps2 = MMC_CAP2_NO_SDIO | MMC_CAP2_NO_MMC;
+	mmc->f_min = 192000;
+	mmc->f_max = min(mmc->f_max ?: 384000U, 384000U);
+	mmc->ocr_avail = MMC_VDD_32_33 | MMC_VDD_33_34;
+	mmc->max_blk_size = 512;
+	mmc->max_blk_count = 1;
+	mmc->max_req_size = PAGE_SIZE;
+	mmc->max_seg_size = PAGE_SIZE;
+	mmc->max_segs = PAGE_SIZE / 512;
+	return 0;
+}
