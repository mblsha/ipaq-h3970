+static struct platform_device *asic2_touch_channel_device(struct kunit *test,
+							struct device *parent,
+							const char *name)
+{
+	const struct platform_device_info info = {
+		.parent = parent, .name = name, .id = PLATFORM_DEVID_AUTO,
+	};
