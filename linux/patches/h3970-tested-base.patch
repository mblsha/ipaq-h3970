diff --git a/Documentation/devicetree/bindings/mfd/compaq,asic.yaml b/Documentation/devicetree/bindings/mfd/compaq,asic.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..df81d23f6a23d51aa9f8ae7e07b1b2bacc94473d
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/compaq,asic.yaml
@@ -0,0 +1,142 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/compaq,asic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Compaq ASIC2 and ASIC3 handheld companion chips
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  ASIC2 combines clocks, GPIO, key input and ADC functions. ASIC3 combines
+  GPIO, clocks and an external SD controller window. Each chip has one
+  shared core register window. ASIC2 uses 32-bit registers; ASIC3 uses
+  16-bit registers at either four-byte (8 KiB window) or two-byte
+  (4 KiB window) spacing. Register offsets and clock controls are intrinsic
+  to the chip, rather than properties of individual consumers.
+
+properties:
+  compatible:
+    enum:
+      - compaq,asic2
+      - compaq,asic3
+
+  reg:
+    maxItems: 1
+    description: Core register window, 8 KiB for ASIC2 and 4 or 8 KiB for ASIC3.
+
+  clocks:
+    minItems: 1
+    items:
+      - description: EX1 oscillator input, normally 24.576 MHz
+      - description: EX0 oscillator input, normally 32.768 kHz
+
+  clock-names:
+    minItems: 1
+    items:
+      - const: osc
+      - const: osc32k
+
+  "#clock-cells":
+    const: 1
+    description: ASIC2 output index from dt-bindings/clock/compaq,asic2.h.
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 1
+
+  ranges:
+    maxItems: 1
+    description: Translation of the separate ASIC3 SD controller window.
+
+  gpio:
+    $ref: /schemas/gpio/compaq,asic-gpio.yaml#
+
+  keypad:
+    $ref: /schemas/input/compaq,asic2-keys.yaml#
+
+  adc:
+    $ref: /schemas/iio/adc/compaq,asic2-adc.yaml#
+
+  touchscreen:
+    $ref: /schemas/input/touchscreen/compaq,asic2-touchscreen.yaml#
+
+patternProperties:
+  "^mmc@[0-9a-f]+$":
+    $ref: /schemas/mmc/compaq,asic3-mmc.yaml#
+
+required:
+  - compatible
+  - reg
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: compaq,asic2
+    then:
+      required:
+        - clocks
+        - clock-names
+        - "#clock-cells"
+      properties:
+        gpio:
+          properties:
+            compatible:
+              const: compaq,asic2-gpio
+        "#address-cells": false
+        "#size-cells": false
+        ranges: false
+      patternProperties:
+        "^mmc@[0-9a-f]+$": false
+    else:
+      properties:
+        gpio:
+          properties:
+            compatible:
+              const: compaq,asic3-gpio
+        clocks: false
+        clock-names: false
+        "#clock-cells": false
+        adc: false
+        touchscreen: false
+        keypad: false
+      dependencies:
+        ranges: [ '#address-cells', '#size-cells' ]
+
+  - if:
+      required:
+        - gpio
+      properties:
+        gpio:
+          required:
+            - interrupt-controller
+    then:
+      properties:
+        clocks:
+          minItems: 2
+        clock-names:
+          minItems: 2
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/compaq,asic2.h>
+    asic2: asic@15000000 {
+        compatible = "compaq,asic2";
+        reg = <0x15000000 0x2000>;
+        clocks = <&oscillator>;
+        clock-names = "osc";
+        #clock-cells = <1>;
+
+        touchscreen {
+            compatible = "compaq,asic2-touchscreen";
+            clocks = <&asic2 ASIC2_CLK_ADC>;
+            clock-names = "adc";
+        };
+    };
diff --git a/Documentation/devicetree/bindings/mmc/compaq,asic3-mmc.yaml b/Documentation/devicetree/bindings/mmc/compaq,asic3-mmc.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..f1fffd71835be785b0f0113d9186f53dff4962b6
--- /dev/null
+++ b/Documentation/devicetree/bindings/mmc/compaq,asic3-mmc.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mmc/compaq,asic3-mmc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Compaq ASIC3 SD controller
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  The SD controller occupies an external window separate from the ASIC3 core.
+  New descriptions place the controller below ASIC3, sharing its core register
+  ownership. The legacy standalone form exposes a second window covering the
+  ASIC3 clock and SD control registers. Driver diagnostic limits are not
+  hardware properties of the socket.
+
+properties:
+  compatible:
+    oneOf:
+      - const: compaq,asic3-mmc
+      - const: compaq,h3970-asic3-sd
+        deprecated: true
+
+  reg:
+    minItems: 1
+    items:
+      - description: SD controller register window
+      - description: Legacy ASIC3 clock and SD control window
+
+  interrupts:
+    maxItems: 1
+    description:
+      Completion signal from the external SD controller. If absent, the
+      driver polls the same TMIO command/data engine instead of assuming an
+      interrupt routing or polarity.
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: sd
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+allOf:
+  - $ref: mmc-controller.yaml#
+  - if:
+      properties:
+        compatible:
+          const: compaq,asic3-mmc
+    then:
+      properties:
+        reg:
+          maxItems: 1
+    else:
+      properties:
+        reg:
+          minItems: 2
+
+unevaluatedProperties: false
