@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/adc/compaq,asic2-adc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Compaq ASIC2 analog-to-digital converter
+
+maintainers:
+  - Michael Pishchagin <mblsha+gh@gmail.com>
+
+description: |
+  ASIC2 has five multiplexed 10-bit ADC inputs. On H3970, channels 3 and 4
+  connect to touchscreen terminals; panel-drive and conversion transactions share
+  the companion's ADC service. Raw channel values do not describe touch
+  coordinates or imply a battery or current scale. The parent owns the
+  register window, so this child has no separate register resource.
+
+properties:
+  compatible:
+    const: compaq,asic2-adc
+
+  '#io-channel-cells':
+    const: 1
+    description: ADC input number, 0 through 4.
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: adc
+
+required:
+  - compatible
+  - '#io-channel-cells'
+  - clocks
+  - clock-names
+
+additionalProperties: false
