 					 ERR_PTR(ret));
 		}
+		if (!regulator->deferred_disables)
+			complete_all(&regulator->deferred_disables_done);
 	}
 	WARN_ON(!total_count);
 
@@ -3218,6 +3227,8 @@ int regulator_disable_deferred(struct regulator *regulator, int ms)
 		return regulator_disable(regulator);
 
 	regulator_lock(rdev);
+	if (!regulator->deferred_disables)
+		reinit_completion(&regulator->deferred_disables_done);
