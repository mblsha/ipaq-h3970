diff --git a/drivers/clk/clk-asic2-test.c b/drivers/clk/clk-asic2-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..50e067c6416c9516ab0988e0cdc63b367cff5d7a
--- /dev/null
+++ b/drivers/clk/clk-asic2-test.c
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exercise consumer arbitration and inherited firmware state through CCF. */
+#include <kunit/clk.h>
+#include <kunit/device.h>
+#include <kunit/test.h>
+#include <linux/clk.h>
+#include <linux/clk/asic2.h>
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+
+#include <dt-bindings/clock/compaq,asic2.h>
+
+struct asic2_test_param {
+	const char *desc;
+	unsigned int reg;
+	u32 initial;
+	bool oscillator;
+};
+
+static const struct asic2_test_param asic2_params[] = {
+	{ "legacy-gates-off", 0, BIT(20), false },
+	{ "legacy-inherited-gates", 0,
+	  BIT(20) | BIT(13) | BIT(14) | BIT(4) | BIT(10) | 0xd, false },
+	{ "parent-gates-off", 0x1000, BIT(20), true },
+	{ "parent-inherited-gates", 0x1000,
+	  BIT(20) | BIT(13) | BIT(14) | BIT(4) | BIT(10) | 0xd, true },
+};
+
+KUNIT_ARRAY_PARAM_DESC(asic2, asic2_params, desc);
+
+struct asic2_test {
+	const struct asic2_test_param *param;
+	struct clk *clocks[ASIC2_CLK_NUM];
+	unsigned int enables[ASIC2_CLK_NUM];
+	u32 value;
+	unsigned int writes;
+	bool fail_adc;
+	bool fail_ex0;
+};
+
+static int asic2_test_read(void *context, unsigned int reg, unsigned int *value)
+{
+	struct asic2_test *ctx = context;
+
+	if (reg != ctx->param->reg)
+		return -EINVAL;
+	*value = ctx->value;
+	return 0;
+}
+
+static int asic2_test_write(void *context, unsigned int reg, unsigned int value)
+{
+	struct asic2_test *ctx = context;
+
+	if (reg != ctx->param->reg)
+		return -EINVAL;
+	if (ctx->fail_adc && (value & BIT(4)))
+		return -EIO;
+	if (ctx->fail_ex0 && (value & BIT(13)))
+		return -EIO;
+	ctx->value = value;
+	ctx->writes++;
+	return 0;
+}
+
+static const struct regmap_bus asic2_test_bus = {
+	.fast_io = true,
+	.reg_read = asic2_test_read,
+	.reg_write = asic2_test_write,
+};
+
+static int asic2_test_init(struct kunit *test)
+{
+	const struct regmap_config config = {
+		.reg_bits = 32,
+		.val_bits = 32,
+		.reg_stride = 4,
+		.max_register = 0x1000,
+	};
+	struct clk_hw_onecell_data *data;
+	struct asic2_test *ctx;
+	struct clk_hw *osc = NULL, *osc32k = NULL;
+	struct regmap *map;
+	struct device *dev;
+	unsigned int i;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	test->priv = ctx;
+	ctx->param = test->param_value;
+	ctx->value = ctx->param->initial;
+	dev = kunit_device_register(test, "asic2-clock-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	map = devm_regmap_init(dev, &asic2_test_bus, ctx, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, map);
+	if (ctx->param->oscillator) {
+		osc = devm_clk_hw_register_fixed_rate(dev, "asic2-test-osc", NULL, 0, 24576000);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, osc);
+		osc32k = devm_clk_hw_register_fixed_rate(dev, "asic2-test-osc32k", NULL, 0, 32768);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, osc32k);
+	}
+	data = devm_asic2_clk_register(dev, map, ctx->param->reg, osc, osc32k, "asic2-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, data);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->value, ctx->param->initial);
+	for (i = 0; i < ASIC2_CLK_NUM; i++) {
+		ctx->clocks[i] = clk_hw_get_clk_kunit(test, data->hws[i], NULL);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->clocks[i]);
+	}
+	return 0;
+}
+
+static void asic2_test_exit(struct kunit *test)
+{
+	struct asic2_test *ctx = test->priv;
+	unsigned int i;
+
+	if (!ctx)
+		return;
+	ctx->fail_adc = false;
+	ctx->fail_ex0 = false;
+	for (i = 0; i < ASIC2_CLK_NUM; i++) {
+		while (ctx->enables[i]) {
+			clk_disable_unprepare(ctx->clocks[i]);
+			ctx->enables[i]--;
+		}
+	}
+}
+
+static int asic2_test_enable(struct asic2_test *ctx, unsigned int id)
+{
+	int ret = clk_prepare_enable(ctx->clocks[id]);
+
+	if (!ret)
+		ctx->enables[id]++;
+	return ret;
+}
+
+static void asic2_test_disable(struct asic2_test *ctx, unsigned int id)
+{
+	clk_disable_unprepare(ctx->clocks[id]);
+	ctx->enables[id]--;
+}
+
+static void asic2_shared_oscillator(struct kunit *test)
+{
+	struct asic2_test *ctx = test->priv;
+	u32 initial = ctx->param->initial;
+
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_ADC), 0);
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_SD), 0);
+	KUNIT_EXPECT_EQ(test, ctx->value, (initial & ~GENMASK(11, 10)) |
+			BIT(14) | BIT(11) | BIT(4));
+	asic2_test_disable(ctx, ASIC2_CLK_ADC);
+	KUNIT_EXPECT_EQ(test, ctx->value, (initial & ~GENMASK(11, 10)) | BIT(14) | BIT(11));
+	asic2_test_disable(ctx, ASIC2_CLK_SD);
+	KUNIT_EXPECT_EQ(test, ctx->value, initial);
+}
+
+static void asic2_consumer_reference_count(struct kunit *test)
+{
+	struct asic2_test *ctx = test->priv;
+	u32 active;
+	unsigned int writes;
+
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_ADC), 0);
+	active = ctx->value;
+	writes = ctx->writes;
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_ADC), 0);
+	KUNIT_EXPECT_EQ(test, ctx->writes, writes);
+	asic2_test_disable(ctx, ASIC2_CLK_ADC);
+	KUNIT_EXPECT_EQ(test, ctx->value, active);
+	KUNIT_EXPECT_EQ(test, ctx->writes, writes);
+	asic2_test_disable(ctx, ASIC2_CLK_ADC);
+	KUNIT_EXPECT_EQ(test, ctx->value, ctx->param->initial);
+}
+
+static void asic2_audio_restore_with_adc_active(struct kunit *test)
+{
+	struct asic2_test *ctx = test->priv;
+	u32 adc_state;
+
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_ADC), 0);
+	adc_state = ctx->value;
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_AUDIO), 0);
+	KUNIT_EXPECT_EQ(test, ctx->value, (adc_state & ~GENMASK(3, 0)) | BIT(0));
+	asic2_test_disable(ctx, ASIC2_CLK_AUDIO);
+	KUNIT_EXPECT_EQ(test, ctx->value, adc_state);
+	asic2_test_disable(ctx, ASIC2_CLK_ADC);
+	KUNIT_EXPECT_EQ(test, ctx->value, ctx->param->initial);
+}
+
+static void asic2_rates(struct kunit *test)
+{
+	struct asic2_test *ctx = test->priv;
+
+	KUNIT_EXPECT_EQ(test, clk_get_rate(ctx->clocks[ASIC2_CLK_EX1]), 24576000UL);
+	KUNIT_EXPECT_EQ(test, clk_get_rate(ctx->clocks[ASIC2_CLK_SD]), 24576000UL);
+	KUNIT_EXPECT_EQ(test, clk_get_rate(ctx->clocks[ASIC2_CLK_ADC]), 1024000UL);
+	KUNIT_EXPECT_EQ(test, clk_get_rate(ctx->clocks[ASIC2_CLK_AUDIO]), 4096000UL);
+	KUNIT_EXPECT_EQ(test, clk_get_rate(ctx->clocks[ASIC2_CLK_EX0]), 32768UL);
+	KUNIT_EXPECT_EQ(test, ctx->writes, 0U);
+}
+
+static void asic2_failed_enable_unwinds_parent(struct kunit *test)
+{
+	struct asic2_test *ctx = test->priv;
+
+	/* Reject the ADC write after the oscillator has successfully enabled. */
+	ctx->value &= ~BIT(4);
+	ctx->fail_adc = true;
+	KUNIT_EXPECT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_ADC), -EIO);
+	ctx->fail_adc = false;
+	KUNIT_EXPECT_EQ(test, ctx->value, ctx->param->initial & ~BIT(4));
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_ADC), 0);
+	asic2_test_disable(ctx, ASIC2_CLK_ADC);
+	KUNIT_EXPECT_EQ(test, ctx->value, ctx->param->initial & ~BIT(4));
+}
+
+static void asic2_ex0_independent_of_ex1(struct kunit *test)
+{
+	struct asic2_test *ctx = test->priv;
+	u32 initial = ctx->param->initial;
+
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_EX0), 0);
+	KUNIT_EXPECT_EQ(test, ctx->value, initial | BIT(13));
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_ADC), 0);
+	KUNIT_EXPECT_EQ(test, ctx->value, initial | BIT(13) | BIT(14) | BIT(4));
+	asic2_test_disable(ctx, ASIC2_CLK_EX0);
+	KUNIT_EXPECT_EQ(test, ctx->value, initial | BIT(14) | BIT(4));
+	asic2_test_disable(ctx, ASIC2_CLK_ADC);
+	KUNIT_EXPECT_EQ(test, ctx->value, initial);
+}
+
+static void asic2_failed_ex0_enable(struct kunit *test)
+{
+	struct asic2_test *ctx = test->priv;
+	u32 initial = ctx->param->initial & ~BIT(13);
+
+	ctx->value = initial;
+	ctx->fail_ex0 = true;
+	KUNIT_EXPECT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_EX0), -EIO);
+	ctx->fail_ex0 = false;
+	KUNIT_EXPECT_EQ(test, ctx->value, initial);
+	KUNIT_ASSERT_EQ(test, asic2_test_enable(ctx, ASIC2_CLK_EX0), 0);
+	asic2_test_disable(ctx, ASIC2_CLK_EX0);
+	KUNIT_EXPECT_EQ(test, ctx->value, initial);
+}
+
+static struct kunit_case asic2_clock_cases[] = {
+	KUNIT_CASE_PARAM(asic2_shared_oscillator, asic2_gen_params),
+	KUNIT_CASE_PARAM(asic2_consumer_reference_count, asic2_gen_params),
+	KUNIT_CASE_PARAM(asic2_audio_restore_with_adc_active, asic2_gen_params),
+	KUNIT_CASE_PARAM(asic2_ex0_independent_of_ex1, asic2_gen_params),
+	KUNIT_CASE_PARAM(asic2_failed_ex0_enable, asic2_gen_params),
+	KUNIT_CASE_PARAM(asic2_rates, asic2_gen_params),
+	KUNIT_CASE_PARAM(asic2_failed_enable_unwinds_parent, asic2_gen_params),
+	{}
+};
+
+static struct kunit_suite asic2_clock_suite = {
+	.name = "asic2-clock",
+	.init = asic2_test_init,
+	.exit = asic2_test_exit,
+	.test_cases = asic2_clock_cases,
+};
+
+kunit_test_suite(asic2_clock_suite);
+
+MODULE_LICENSE("GPL");
diff --git a/drivers/clk/clk-asic2.c b/drivers/clk/clk-asic2.c
new file mode 100644
index 0000000000000000000000000000000000000000..3be0baeadf74139a0f936a974ab1ab49477fb094
--- /dev/null
+++ b/drivers/clk/clk-asic2.c
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* ASIC2 clocks shared by the ADC, SD interface and audio codec. */
+#include <linux/clk/asic2.h>
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include <dt-bindings/clock/compaq,asic2.h>
+
+struct asic2_clk {
+	struct clk_hw hw;
+	struct regmap *map;
+	unsigned int reg;
+	u32 mask;
+	u32 value;
+	u32 saved;
+	unsigned int divisor;
+	unsigned long fallback_rate;
+};
+
+static struct asic2_clk *to_asic2_clk(struct clk_hw *hw)
+{
+	return container_of(hw, struct asic2_clk, hw);
+}
+
+/* The clock core serializes enable and disable for this shared register. */
+static int asic2_clk_enable(struct clk_hw *hw)
+{
+	struct asic2_clk *clk = to_asic2_clk(hw);
+	u32 value;
+	int ret;
+
+	ret = regmap_read(clk->map, clk->reg, &value);
+	if (ret)
+		return ret;
+	clk->saved = value & clk->mask;
+	return regmap_write(clk->map, clk->reg,
+			    (value & ~clk->mask) | clk->value);
+}
+
+static void asic2_clk_disable(struct clk_hw *hw)
+{
+	struct asic2_clk *clk = to_asic2_clk(hw);
+	u32 value;
+
+	/* Preserve firmware state for consumers Linux does not manage yet. */
+	if (!regmap_read(clk->map, clk->reg, &value))
+		regmap_write(clk->map, clk->reg,
+			     (value & ~clk->mask) | clk->saved);
+}
+
+static int asic2_clk_is_enabled(struct clk_hw *hw)
+{
+	struct asic2_clk *clk = to_asic2_clk(hw);
+	u32 value;
+	int ret;
+
+	ret = regmap_read(clk->map, clk->reg, &value);
+	return ret ?: ((value & clk->mask) == clk->value);
+}
+
+static unsigned long asic2_clk_rate(struct clk_hw *hw, unsigned long parent_rate)
+{
+	struct asic2_clk *clk = to_asic2_clk(hw);
+
+	if (clk->divisor)
+		return parent_rate / clk->divisor;
+	return parent_rate ?: clk->fallback_rate;
+}
+
+static const struct clk_ops asic2_clk_ops = {
+	.enable = asic2_clk_enable,
+	.disable = asic2_clk_disable,
+	.is_enabled = asic2_clk_is_enabled,
+	.recalc_rate = asic2_clk_rate,
+};
+
+struct clk_hw_onecell_data *
+devm_asic2_clk_register(struct device *dev, struct regmap *map,
+			unsigned int reg, const struct clk_hw *osc,
+			const struct clk_hw *osc32k, const char *prefix)
+{
+	static const struct {
+		const char *name;
+		u32 mask;
+		u32 value;
+		unsigned int divisor;
+		unsigned long fallback_rate;
+	} desc[ASIC2_CLK_NUM] = {
+		[ASIC2_CLK_EX1] = { "ex1", BIT(14), BIT(14), 0, 24576000 },
+		[ASIC2_CLK_ADC] = { "adc", BIT(4), BIT(4), 24 },
+		[ASIC2_CLK_SD] = { "sd", GENMASK(11, 10), BIT(11), 1 },
+		[ASIC2_CLK_AUDIO] = { "audio", GENMASK(3, 0), BIT(0), 6 },
+		[ASIC2_CLK_EX0] = { "ex0", BIT(13), BIT(13), 0, 32768 },
+	};
+	struct clk_hw_onecell_data *data;
+	struct asic2_clk *clks;
+	unsigned int i;
+	int ret;
+
+	clks = devm_kcalloc(dev, ASIC2_CLK_NUM, sizeof(*clks), GFP_KERNEL);
+	data = devm_kzalloc(dev, struct_size(data, hws, ASIC2_CLK_NUM), GFP_KERNEL);
+	if (!clks || !data)
+		return ERR_PTR(-ENOMEM);
+
+	data->num = ASIC2_CLK_NUM;
+	for (i = 0; i < ASIC2_CLK_NUM; i++) {
+		const struct clk_hw *parent = i == ASIC2_CLK_EX1 ?
+			osc : i == ASIC2_CLK_EX0 ? osc32k : &clks[ASIC2_CLK_EX1].hw;
+		const struct clk_init_data init = {
+			.name = devm_kasprintf(dev, GFP_KERNEL, "%s-%s",
+					      prefix ?: dev_name(dev), desc[i].name),
+			.ops = &asic2_clk_ops,
+			.parent_hws = parent ? &parent : NULL,
+			.num_parents = !!parent,
+			/* Only restore the gate on a matched consumer disable. */
+			.flags = CLK_IGNORE_UNUSED,
+		};
+
+		if (!init.name)
+			return ERR_PTR(-ENOMEM);
+		clks[i].map = map;
+		clks[i].reg = reg;
+		clks[i].mask = desc[i].mask;
+		clks[i].value = desc[i].value;
+		clks[i].divisor = desc[i].divisor;
+		clks[i].fallback_rate = desc[i].fallback_rate;
+		clks[i].hw.init = &init;
+		ret = devm_clk_hw_register(dev, &clks[i].hw);
+		if (ret)
+			return ERR_PTR(ret);
+		data->hws[i] = &clks[i].hw;
+	}
+
+	return data;
+}
+EXPORT_SYMBOL_GPL(devm_asic2_clk_register);
+
+/* Compatibility with DTBs containing only the old standalone clock node. */
+static int asic2_clk_probe(struct platform_device *pdev)
+{
+	static const struct regmap_config config = {
+		.reg_bits = 32,
+		.val_bits = 32,
+		.reg_stride = 4,
+		.max_register = 0,
+	};
+	struct device *dev = &pdev->dev;
+	struct clk_hw_onecell_data *data;
+	struct regmap *map;
+	void __iomem *base;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	map = devm_regmap_init_mmio(dev, base, &config);
+	if (IS_ERR(map))
+		return PTR_ERR(map);
+	data = devm_asic2_clk_register(dev, map, 0, NULL, NULL, "h3970-asic2");
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, data);
+}
+
+static const struct of_device_id asic2_clk_match[] = {
+	{ .compatible = "compaq,h3970-asic2-clocks" },
+	{}
+};
+
+static struct platform_driver asic2_clk_driver = {
+	.probe = asic2_clk_probe,
+	.driver = {
+		.name = "h3970-asic2-clocks",
+		.of_match_table = asic2_clk_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(asic2_clk_driver);
+
+MODULE_DESCRIPTION("Compaq ASIC2 clock provider");
+MODULE_LICENSE("GPL");
