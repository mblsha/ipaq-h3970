+static void uda_test_powered(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+
+	uda_test_start(test);
+	KUNIT_ASSERT_EQ(test, uda1380_set_bias_level(&ctx->component, SND_SOC_BIAS_STANDBY), 0);
+	snd_soc_dapm_init_bias_level(snd_soc_component_get_dapm(&ctx->component),
+				     SND_SOC_BIAS_STANDBY);
+	ctx->transfers = 0;
+	ctx->nevents = 0;
+}
+
+static void uda1380_cache_is_per_device(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+	struct uda1380_priv other = { .i2c = ctx->priv.i2c };
+	struct snd_soc_component second = {};
+	struct device *dev;
+
+	uda_test_powered(test);
+	dev = kunit_device_register(test, "uda1380-second-codec");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	second.dev = dev;
+	other.reg_cache = kunit_kzalloc(test, sizeof(uda1380_reg), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, other.reg_cache);
+	other.component = &second;
+	snd_soc_component_set_drvdata(&second, &other);
+	INIT_WORK(&other.work, uda1380_flush_work);
+	KUNIT_ASSERT_EQ(test, uda1380_write(&ctx->component, UDA1380_MVOL, 0x1234), 0);
+	KUNIT_EXPECT_EQ(test, ctx->transfers, 0U);
+	KUNIT_EXPECT_EQ(test, other.cache_dirty, 0UL);
+	uda1380_write_reg_cache(&second, UDA1380_MVOL + 1, 0x5678);
+	ctx->component.active = 1;
+	uda1380_flush_work(&ctx->priv.work);
+	KUNIT_EXPECT_EQ(test, ctx->registers[UDA1380_MVOL], (u16)0x1234);
+	KUNIT_EXPECT_EQ(test, ctx->priv.cache_dirty, 0UL);
+	KUNIT_EXPECT_EQ(test, other.cache_dirty, BIT(1));
+	/* An inactive flush must leave the deferred value dirty. */
+	uda1380_flush_work(&other.work);
+	KUNIT_EXPECT_EQ(test, other.cache_dirty, BIT(1));
+}
+
+static void uda1380_failed_flush_is_retryable(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+	unsigned int step;
+
+	uda_test_powered(test);
+	ctx->component.active = 1;
+	/* The write and the combined read are separate adapter transfers. */
+	for (step = 1; step <= 2; step++) {
+		uda1380_write_reg_cache(&ctx->component, UDA1380_MVOL, step);
+		ctx->fail_transfer = ctx->transfers + step;
+		uda1380_flush_work(&ctx->priv.work);
+		KUNIT_EXPECT_TRUE(test, test_bit(0, &ctx->priv.cache_dirty));
+		ctx->fail_transfer = 0;
+		uda1380_flush_work(&ctx->priv.work);
+		KUNIT_EXPECT_EQ(test, ctx->priv.cache_dirty, 0UL);
+	}
+	ctx->corrupt_read = true;
+	KUNIT_EXPECT_EQ(test, uda1380_write(&ctx->component, UDA1380_MVOL, 42), -EIO);
+	KUNIT_EXPECT_TRUE(test, test_bit(0, &ctx->priv.cache_dirty));
+	ctx->corrupt_read = false;
+	uda1380_flush_work(&ctx->priv.work);
+	KUNIT_EXPECT_EQ(test, ctx->priv.cache_dirty, 0UL);
+}
+
+static void uda1380_power_cycle_and_remove(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+	unsigned int first;
+	int cycle;
+
+	uda_test_start(test);
+	KUNIT_EXPECT_EQ(test, ctx->priv.dac_clk, (unsigned int)UDA1380_DAC_CLK_WSPLL);
+	KUNIT_EXPECT_EQ(test, ctx->priv.reg_cache[UDA1380_CLK], (u16)R00_DAC_CLK);
+	for (cycle = 0; cycle < 2; cycle++) {
+		first = ctx->nevents;
+		KUNIT_ASSERT_EQ(test, uda1380_set_bias_level(&ctx->component,
+							     SND_SOC_BIAS_STANDBY), 0);
+		KUNIT_EXPECT_EQ(test, ctx->events[first++], (unsigned int)UDA_TEST_CLK_ON);
+		KUNIT_EXPECT_EQ(test, ctx->events[first++], (unsigned int)UDA_TEST_GPIO(1, 1));
+		KUNIT_EXPECT_EQ(test, ctx->events[first++], (unsigned int)UDA_TEST_GPIO(0, 1));
+		KUNIT_EXPECT_EQ(test, ctx->events[first], (unsigned int)UDA_TEST_GPIO(0, 0));
+		KUNIT_EXPECT_EQ(test, ctx->registers[UDA1380_CLK], (u16)R00_DAC_CLK);
+		KUNIT_EXPECT_TRUE(test, ctx->clock_on);
+		snd_soc_dapm_init_bias_level(snd_soc_component_get_dapm(&ctx->component),
+					     SND_SOC_BIAS_STANDBY);
+		first = ctx->nevents;
+		KUNIT_ASSERT_EQ(test, uda1380_set_bias_level(&ctx->component,
+							     SND_SOC_BIAS_STANDBY), 0);
+		KUNIT_EXPECT_EQ(test, ctx->nevents, first + 1);
+		KUNIT_ASSERT_EQ(test, uda1380_set_bias_level(&ctx->component,
+							     SND_SOC_BIAS_ON), 0);
+		KUNIT_EXPECT_TRUE(test, ctx->registers[UDA1380_PM] & R02_PON_BIAS);
+		ctx->component.active = 1;
+		uda1380_write_reg_cache(&ctx->component, UDA1380_MIXER, cycle + 1);
+		schedule_work(&ctx->priv.work);
+		KUNIT_ASSERT_EQ(test, uda1380_set_bias_level(&ctx->component,
+							     SND_SOC_BIAS_OFF), 0);
+		KUNIT_EXPECT_FALSE(test, work_busy(&ctx->priv.work));
+		KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 0);
+		snd_soc_dapm_init_bias_level(snd_soc_component_get_dapm(&ctx->component),
+					     SND_SOC_BIAS_OFF);
+		KUNIT_EXPECT_EQ(test, ctx->events[ctx->nevents - 1],
+				(unsigned int)UDA_TEST_CLK_OFF);
+		KUNIT_EXPECT_EQ(test, ctx->priv.cache_dirty,
+				GENMASK(4, 0) | GENMASK(19, 16));
+	}
+	KUNIT_EXPECT_EQ(test, ctx->invalid_reg_writes, 0U);
+	uda1380_remove(&ctx->component);
+	ctx->probed = false;
+	KUNIT_EXPECT_FALSE(test, work_busy(&ctx->priv.work));
+	KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+	KUNIT_EXPECT_EQ(test, ctx->unclocked_io, 0U);
+}
+
+static void uda1380_power_up_errors_unwind(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+	unsigned int transfers;
+
+	uda_test_start(test);
+	ctx->fail_gpio = 0;
+	KUNIT_EXPECT_EQ(test, uda1380_set_bias_level(&ctx->component,
+						     SND_SOC_BIAS_STANDBY), -EIO);
+	KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+	KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 0);
+	KUNIT_EXPECT_EQ(test, ctx->transfers, 0U);
+	ctx->fail_gpio = -1;
+	transfers = ctx->transfers;
+	ctx->fail_transfer = transfers + 4;
+	KUNIT_EXPECT_EQ(test, uda1380_set_bias_level(&ctx->component,
+						     SND_SOC_BIAS_STANDBY), -EIO);
+	KUNIT_EXPECT_EQ(test, ctx->transfers, transfers + 4);
+	KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+	KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 0);
+	ctx->fail_transfer = 0;
+	KUNIT_EXPECT_EQ(test, uda1380_set_bias_level(&ctx->component,
+						     SND_SOC_BIAS_STANDBY), 0);
+	KUNIT_EXPECT_TRUE(test, ctx->clock_on);
+	KUNIT_EXPECT_EQ(test, ctx->unclocked_io, 0U);
+}
