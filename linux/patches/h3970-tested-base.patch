+static void uda1380_clock_failure_is_retryable(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+	unsigned int first;
+
+	KUNIT_ASSERT_EQ(test, uda1380_get_resources(ctx->component.dev, &ctx->priv), 0);
+	first = ctx->nevents;
+	ctx->fail_prepare = -EIO;
+	KUNIT_EXPECT_EQ(test, uda1380_probe(&ctx->component), -EIO);
+	KUNIT_EXPECT_EQ(test, ctx->nevents, first);
+	KUNIT_EXPECT_EQ(test, ctx->transfers, 0U);
+	KUNIT_EXPECT_FALSE(test, ctx->priv.sysclk_enabled);
+	ctx->fail_prepare = 0;
+	KUNIT_ASSERT_EQ(test, uda1380_probe(&ctx->component), 0);
+	ctx->probed = true;
+	KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+}
