+// SPDX-License-Identifier: GPL-2.0-only
+/* Real OF/OPP, CCF, regulator and notifier paths; no PXA register access. */
+#include <kunit/test.h>
+#include <linux/clk-provider.h>
+#include <linux/clkdev.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/machine.h>
+
+struct pxa_test_clock {
+	struct clk_hw hw;
+	struct pxa_test *ctx;
+	unsigned long rate;
+	bool registered;
+};
+
+struct pxa_test {
+	struct pxa_cpufreq_data data;
+	struct cpufreq_frequency_table table[ARRAY_SIZE(pxa27x_freqs) + 1];
+	struct cpufreq_policy policy;
+	struct of_changeset changes;
+	struct device_node *nodes[16];
+	unsigned int nnodes;
+	struct device_node *cpu, *opps, *provider, *regulator;
+	struct pxa_test_clock core, memory;
+	struct clk_hw_onecell_data *clks;
+	struct regulator_dev *rdev;
+	struct clk_lookup *lookup[2];
+	struct notifier_block notifier;
+	unsigned int phandle;
+	bool applied, provider_added, clocks_acquired, notifier_added;
+	bool voltage_fail, clock_fail, mismatch, veto;
+	int voltage;
+	char events[32];
+	unsigned int nevents;
+	struct pxa_cpufreq_transition transition;
+};
+
+static void pxa_test_event(struct pxa_test *ctx, char event)
+{
+	if (ctx->nevents < sizeof(ctx->events) - 1)
+		ctx->events[ctx->nevents++] = event;
+}
+
+static unsigned long pxa_test_recalc(struct clk_hw *hw, unsigned long parent)
+{
+	return container_of(hw, struct pxa_test_clock, hw)->rate;
+}
+
+static long pxa_test_round(struct clk_hw *hw, unsigned long rate, unsigned long *parent)
+{
+	return rate;
+}
+
+static int pxa_test_set_rate(struct clk_hw *hw, unsigned long rate, unsigned long parent)
+{
+	struct pxa_test_clock *clock = container_of(hw, struct pxa_test_clock, hw);
+	struct pxa_test *ctx = clock->ctx;
+
+	pxa_test_event(ctx, 'C');
+	if (ctx->clock_fail)
+		return -EIO;
+	clock->rate = ctx->mismatch ? rate - 1 : rate;
+	ctx->mismatch = false;
+	return 0;
+}
+
+static const struct clk_ops pxa_test_clk_ops = {
+	.recalc_rate = pxa_test_recalc,
+	.round_rate = pxa_test_round,
+	.set_rate = pxa_test_set_rate,
+};
+
+static int pxa_test_set_voltage(struct regulator_dev *rdev, int min, int max,
+				unsigned int *selector)
+{
+	struct pxa_test *ctx = rdev_get_drvdata(rdev);
+
+	pxa_test_event(ctx, 'V');
+	if (ctx->voltage_fail)
+		return -EIO;
+	ctx->voltage = min;
+	return 0;
+}
+
+static int pxa_test_get_voltage(struct regulator_dev *rdev)
+{
+	return ((struct pxa_test *)rdev_get_drvdata(rdev))->voltage;
+}
+
+static const struct regulator_ops pxa_test_regulator_ops = {
+	.get_voltage = pxa_test_get_voltage,
+	.set_voltage = pxa_test_set_voltage,
+};
+
+static int pxa_test_notify(struct notifier_block *nb, unsigned long event, void *arg)
+{
+	struct pxa_test *ctx = container_of(nb, struct pxa_test, notifier);
+
+	ctx->transition = *(struct pxa_cpufreq_transition *)arg;
+	pxa_test_event(ctx, event == PXA_CPUFREQ_PRECHANGE ? 'P' :
+			    event == PXA_CPUFREQ_POSTCHANGE ? 'D' : 'A');
+	return ctx->veto && event == PXA_CPUFREQ_PRECHANGE ? notifier_from_errno(-EBUSY) : NOTIFY_OK;
+}
+
+static void pxa_test_cleanup(void *arg)
+{
+	struct pxa_test *ctx = arg;
+	unsigned int i;
+
+	if (ctx->notifier_added)
+		pxa_cpufreq_unregister_transition_notifier(&ctx->notifier);
+	if (ctx->data.has_opps)
+		dev_pm_opp_of_remove_table(ctx->data.cpu_dev);
+	if (!IS_ERR_OR_NULL(ctx->data.vcc_core))
+		regulator_put(ctx->data.vcc_core);
+	if (!IS_ERR_OR_NULL(ctx->rdev))
+		regulator_unregister(ctx->rdev);
+	if (ctx->clocks_acquired) {
+		clk_put(ctx->data.clk_memory);
+		clk_put(ctx->data.clk_core);
+	}
+	for (i = 0; i < ARRAY_SIZE(ctx->lookup); i++)
+		if (ctx->lookup[i])
+			clkdev_drop(ctx->lookup[i]);
+	if (ctx->provider_added)
+		of_clk_del_provider(ctx->provider);
+	if (ctx->core.registered)
+		clk_hw_unregister(&ctx->core.hw);
+	if (ctx->memory.registered)
+		clk_hw_unregister(&ctx->memory.hw);
+	if (!IS_ERR_OR_NULL(ctx->data.cpu_dev)) {
+		device_remove_of_node(ctx->data.cpu_dev);
+		root_device_unregister(ctx->data.cpu_dev);
+	}
+	if (ctx->applied)
+		of_changeset_revert(&ctx->changes);
+	of_changeset_destroy(&ctx->changes);
+	for (i = 0; i < ctx->nnodes; i++)
+		of_node_put(ctx->nodes[i]);
+}
+
+static struct device_node *pxa_test_node(struct kunit *test, struct device_node *parent,
+				       const char *name)
+{
+	struct pxa_test *ctx = test->priv;
+	struct device_node *np = of_changeset_create_node(&ctx->changes, parent, name);
+
+	KUNIT_ASSERT_NOT_NULL(test, np);
+	KUNIT_ASSERT_LT(test, ctx->nnodes, (unsigned int)ARRAY_SIZE(ctx->nodes));
+	ctx->nodes[ctx->nnodes++] = np;
+	return np;
+}
+
+static int pxa_test_init(struct kunit *test)
+{
+	struct pxa_test *ctx;
+	struct device_node *parent, *np;
+	int ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	test->priv = ctx;
+	of_changeset_init(&ctx->changes);
+	ret = kunit_add_action_or_reset(test, pxa_test_cleanup, ctx);
+	if (ret)
+		return ret;
+	ctx->data.cpu_dev = root_device_register("pxa-cpufreq-test");
+	if (IS_ERR(ctx->data.cpu_dev))
+		return PTR_ERR(ctx->data.cpu_dev);
+	ctx->data.pxa25x = true;
+	ctx->data.freqs = pxa255_run_freqs;
+	ctx->data.num_freqs = ARRAY_SIZE(pxa255_run_freqs);
+	ctx->data.max_khz = UINT_MAX;
+	ctx->data.freq_table = ctx->table;
+	ctx->core.ctx = ctx;
+	ctx->core.rate = 99532800;
+	ctx->memory.ctx = ctx;
+	ctx->memory.rate = 99532800;
+	ctx->voltage = 1000000;
+	ctx->policy.cur = 99532;
+	for_each_of_allnodes(np)
+		ctx->phandle = max(ctx->phandle, np->phandle);
+	ctx->phandle++;
+	parent = pxa_test_node(test, of_root, "pxa-cpufreq-test");
+	ctx->cpu = pxa_test_node(test, parent, "cpu");
+	ctx->opps = pxa_test_node(test, parent, "opps");
+	ctx->provider = pxa_test_node(test, parent, "clocks");
+	ctx->regulator = pxa_test_node(test, parent, "regulator");
+	ctx->opps->phandle = ctx->phandle;
+	ctx->provider->phandle = ctx->phandle + 1;
+	ctx->regulator->phandle = ctx->phandle + 2;
+	KUNIT_ASSERT_EQ(test, of_changeset_add_prop_string(&ctx->changes, ctx->opps,
+						       "compatible", "operating-points-v2"), 0);
+	KUNIT_ASSERT_EQ(test, of_changeset_add_prop_u32(&ctx->changes, ctx->provider,
+						    "#clock-cells", 1), 0);
+	return device_add_of_node(ctx->data.cpu_dev, ctx->cpu);
+}
+
+static void pxa_test_opp(struct kunit *test, unsigned long hz, unsigned int uv,
+			 const char *status)
+{
+	struct pxa_test *ctx = test->priv;
+	struct device_node *np;
+	u32 rate[] = { 0, hz };
+	char name[32];
+
+	snprintf(name, sizeof(name), "opp-%lu", hz);
+	np = pxa_test_node(test, ctx->opps, name);
+	KUNIT_ASSERT_EQ(test, of_changeset_add_prop_u32_array(&ctx->changes, np,
+							  "opp-hz", rate, 2), 0);
+	if (uv)
+		KUNIT_ASSERT_EQ(test, of_changeset_add_prop_u32(&ctx->changes, np,
+							    "opp-microvolt", uv), 0);
+	if (status)
+		KUNIT_ASSERT_EQ(test, of_changeset_add_prop_string(&ctx->changes, np,
+							       "status", status), 0);
+}
+
+static void pxa_test_apply(struct kunit *test, bool opps, bool clocks, bool supply)
+{
+	struct pxa_test *ctx = test->priv;
+	const char *names[] = { "core", "memory" };
+	u32 clock_ids[] = { ctx->phandle + 1, 0, ctx->phandle + 1, 1 };
+
+	if (opps)
+		KUNIT_ASSERT_EQ(test, of_changeset_add_prop_u32(&ctx->changes, ctx->cpu,
+							    "operating-points-v2", ctx->phandle), 0);
+	if (clocks) {
+		KUNIT_ASSERT_EQ(test, of_changeset_add_prop_u32_array(&ctx->changes, ctx->cpu,
+								  "clocks", clock_ids, 4), 0);
+		KUNIT_ASSERT_EQ(test, of_changeset_add_prop_string_array(&ctx->changes, ctx->cpu,
+								     "clock-names", names, 2), 0);
+	}
+	if (supply)
+		KUNIT_ASSERT_EQ(test, of_changeset_add_prop_u32(&ctx->changes, ctx->cpu,
+							    "cpu-supply", ctx->phandle + 2), 0);
+	KUNIT_ASSERT_EQ(test, of_changeset_apply(&ctx->changes), 0);
+	ctx->applied = true;
+	/* Changesets attach empty nodes before adding their properties. */
+	for (unsigned int i = 0; i < ctx->nnodes; i++)
+		ctx->nodes[i]->name = ctx->nodes[i]->full_name;
+	ctx->opps->phandle = ctx->phandle;
+	ctx->provider->phandle = ctx->phandle + 1;
+	ctx->regulator->phandle = ctx->phandle + 2;
+}
+
+static void pxa_test_clocks(struct kunit *test, bool described)
+{
+	struct pxa_test *ctx = test->priv;
+	struct clk_init_data init = { .ops = &pxa_test_clk_ops, .flags = CLK_GET_RATE_NOCACHE };
+
+	init.name = "pxa-test-core";
+	ctx->core.hw.init = &init;
+	KUNIT_ASSERT_EQ(test, clk_hw_register(ctx->data.cpu_dev, &ctx->core.hw), 0);
+	ctx->core.registered = true;
+	init.name = "pxa-test-memory";
+	ctx->memory.hw.init = &init;
+	KUNIT_ASSERT_EQ(test, clk_hw_register(ctx->data.cpu_dev, &ctx->memory.hw), 0);
+	ctx->memory.registered = true;
+	if (described) {
+		ctx->clks = kunit_kzalloc(test, struct_size(ctx->clks, hws, 2), GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, ctx->clks);
+		ctx->clks->num = 2;
+		ctx->clks->hws[0] = &ctx->core.hw;
+		ctx->clks->hws[1] = &ctx->memory.hw;
+		KUNIT_ASSERT_EQ(test, of_clk_add_hw_provider(ctx->provider,
+							  of_clk_hw_onecell_get, ctx->clks), 0);
+		ctx->provider_added = true;
+	} else {
+		ctx->lookup[0] = clkdev_hw_create(&ctx->core.hw, "core", NULL);
+		ctx->lookup[1] = clkdev_hw_create(&ctx->memory.hw,
+						pxa_memory_clock_name(ctx->data.pxa25x), NULL);
+		KUNIT_ASSERT_NOT_NULL(test, ctx->lookup[0]);
+		KUNIT_ASSERT_NOT_NULL(test, ctx->lookup[1]);
+	}
+	KUNIT_ASSERT_EQ(test, pxa_cpufreq_get_clocks(&ctx->data), 0);
+	ctx->clocks_acquired = true;
+}
+
+static void pxa_test_supply(struct kunit *test)
+{
+	struct pxa_test *ctx = test->priv;
+	static const struct regulator_desc desc = {
+		.name = "pxa-test-cpu", .type = REGULATOR_VOLTAGE,
+		.owner = THIS_MODULE, .ops = &pxa_test_regulator_ops,
+	};
+	struct regulator_init_data init = {
+		.constraints = { .min_uV = 900000, .max_uV = 1705000,
+				.valid_ops_mask = REGULATOR_CHANGE_VOLTAGE },
+	};
+	struct regulator_config config = {
+		.dev = ctx->data.cpu_dev, .driver_data = ctx, .init_data = &init,
+		.of_node = ctx->regulator,
+	};
+
+	ctx->rdev = regulator_register(ctx->data.cpu_dev, &desc, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctx->rdev);
+	KUNIT_ASSERT_EQ(test, pxa_cpufreq_get_supply(&ctx->data), 0);
+	ctx->nevents = 0;
+	memset(ctx->events, 0, sizeof(ctx->events));
+}
+
+static void pxa_test_notifier(struct kunit *test)
+{
+	struct pxa_test *ctx = test->priv;
+
+	ctx->notifier.notifier_call = pxa_test_notify;
+	KUNIT_ASSERT_EQ(test, pxa_cpufreq_register_transition_notifier(&ctx->notifier), 0);
+	ctx->notifier_added = true;
+}
+
+static void pxa_legacy_table_test(struct kunit *test)
+{
+	struct pxa_test *ctx = test->priv;
