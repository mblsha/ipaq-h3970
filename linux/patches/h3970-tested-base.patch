+static void uda1380_software_reset_clock_order(struct kunit *test)
+{
+	struct uda1380_test *ctx = test->priv;
+
+	/* This board has no controllable GPIOs. */
+	gpiod_remove_lookup_table(ctx->lookup);
+	ctx->lookup_registered = false;
+	KUNIT_ASSERT_EQ(test, uda1380_get_resources(ctx->component.dev, &ctx->priv), 0);
+	KUNIT_ASSERT_EQ(test, uda1380_probe(&ctx->component), 0);
+	ctx->probed = true;
+	KUNIT_EXPECT_EQ(test, ctx->events[0], (unsigned int)UDA_TEST_CLK_ON);
+	KUNIT_EXPECT_EQ(test, ctx->events[1], (unsigned int)UDA_TEST_WRITE(UDA1380_RESET));
+	KUNIT_EXPECT_EQ(test, ctx->unclocked_io, 0U);
+	KUNIT_EXPECT_EQ(test, ctx->transfers, 1U);
+}
