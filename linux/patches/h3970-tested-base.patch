  *
  * Note: drivers must ensure that all regulator_enable calls made on this
  * regulator source are balanced by regulator_disable calls prior to calling
- * this function.
+ * this function. Deferred disables count as balanced requests; this function
+ * waits for them to finish, without shortening their delay, before releasing
+ * the consumer handle. No further operations may race with this release.
  */
 void regulator_put(struct regulator *regulator)
 {
+	if (!IS_ERR_OR_NULL(regulator))
+		wait_for_completion(&regulator->deferred_disables_done);
