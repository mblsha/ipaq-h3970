+static void uda_test_asoc_card(struct kunit *test, enum uda_test_card_teardown teardown)
+{
+	struct uda1380_test *ctx = test->priv;
+	struct snd_soc_dai_link_component *cpu, *codec;
+	struct snd_soc_component *component;
+	struct snd_soc_codec_conf *conf;
+	struct snd_soc_dai_link *link;
+	struct snd_soc_aux_dev *aux;
+	struct snd_soc_card *card;
+	struct snd_soc_pcm_runtime *rtd;
+	struct snd_pcm_hw_params *params;
+	struct snd_pcm_substream *substream;
+	struct snd_soc_dapm_widget *w, *left = NULL, *right = NULL;
+	struct snd_kcontrol *input;
+	struct snd_ctl_elem_value value = {};
+	struct snd_soc_dapm_path *path;
+	struct gpiod_lookup_table *lookup;
+	struct platform_device *amp;
+	struct device *dev;
+	int ret, route, selection;
+
+	uda_test_amp_supply(test);
+	lookup = kunit_kzalloc(test, struct_size(lookup, table, 2), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, lookup);
+	lookup->dev_id = "simple-amplifier.0";
+	lookup->table[0] = (struct gpiod_lookup)
+		GPIO_LOOKUP("uda1380-kunit-gpio", 2, "enable", GPIO_ACTIVE_HIGH);
+	gpiod_add_lookup_table(lookup);
+	ret = kunit_add_action_or_reset(test, uda_test_remove_table, lookup);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	amp = platform_device_register_simple("simple-amplifier", 0, NULL, 0);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, amp);
+	ret = kunit_add_action_or_reset(test, uda_test_platform_unregister, amp);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_NOT_NULL(test, snd_soc_lookup_component(&amp->dev, NULL));
+
+	KUNIT_ASSERT_EQ(test, uda1380_i2c_probe(ctx->priv.i2c), 0);
+	component = snd_soc_lookup_component(&ctx->priv.i2c->dev, NULL);
+	KUNIT_ASSERT_NOT_NULL(test, component);
+	codec = kunit_kzalloc(test, sizeof(*codec), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, codec);
+	codec->name = component->name;
+	codec->dai_name = "uda1380-hifi-playback";
+
+	dev = kunit_device_register(test, "uda1380-test-cpu");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	ret = devm_snd_soc_register_component(dev, &uda_test_cpu_component,
+					      &uda_test_cpu_dai, 1);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	cpu = kunit_kzalloc(test, sizeof(*cpu), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, cpu);
+	cpu->name = snd_soc_lookup_component(dev, NULL)->name;
+	cpu->dai_name = uda_test_cpu_dai.name;
+
+	card = kunit_kzalloc(test, sizeof(*card), GFP_KERNEL);
+	link = kunit_kzalloc(test, sizeof(*link), GFP_KERNEL);
+	aux = kunit_kzalloc(test, sizeof(*aux), GFP_KERNEL);
+	conf = kunit_kzalloc(test, sizeof(*conf), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, card);
+	KUNIT_ASSERT_NOT_NULL(test, link);
+	KUNIT_ASSERT_NOT_NULL(test, aux);
+	KUNIT_ASSERT_NOT_NULL(test, conf);
+	aux->dlc.name = snd_soc_lookup_component(&amp->dev, NULL)->name;
+	conf->dlc.name = aux->dlc.name;
+	conf->name_prefix = "Amp";
+	link->name = "UDA1380";
+	link->stream_name = "UDA1380 Playback";
+	link->cpus = cpu;
+	link->num_cpus = 1;
+	link->codecs = codec;
+	link->num_codecs = 1;
+	link->dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_CBC_CFC;
+	card->name = "H3970-test";
+	card->owner = THIS_MODULE;
+	card->dev = kunit_device_register(test, "uda1380-test-card");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, card->dev);
+	card->dai_link = link;
+	card->num_links = 1;
+	card->aux_dev = aux;
+	card->num_aux_devs = 1;
+	card->codec_conf = conf;
+	card->num_configs = 1;
+	card->dapm_widgets = uda_test_board_widgets;
+	card->num_dapm_widgets = ARRAY_SIZE(uda_test_board_widgets);
+	card->dapm_routes = uda_test_board_routes;
+	card->num_dapm_routes = ARRAY_SIZE(uda_test_board_routes);
+	KUNIT_ASSERT_EQ(test, devm_snd_soc_register_card(card->dev, card), 0);
+	KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 0);
+	KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+	input = snd_soc_card_get_kcontrol(card, "Input Mux");
+	KUNIT_ASSERT_NOT_NULL(test, input);
+	for_each_card_widgets(card, w) {
+		if (!strcmp(w->name, "Amp VCC")) {
+			KUNIT_EXPECT_EQ(test, w->shift, 20);
+			if (teardown != UDA_TEST_NORMAL)
+				w->shift = 200; /* Deterministic pending-work fixture. */
+		}
+		if (!strcmp(w->name, "Input Mux"))
+			left = w;
+		if (!strcmp(w->name, "Right Input Mux"))
+			right = w;
+	}
+	KUNIT_ASSERT_NOT_NULL(test, left);
+	KUNIT_ASSERT_NOT_NULL(test, right);
+	KUNIT_EXPECT_PTR_EQ(test, left->kcontrols[0], right->kcontrols[0]);
+	KUNIT_EXPECT_PTR_EQ(test, left->kcontrols[0], input);
+	for (selection = 0; selection < 4; selection++) {
+		bool connected = false;
+
+		value.value.enumerated.item[0] = selection;
+		KUNIT_ASSERT_GE(test, input->put(input, &value), 0);
+		snd_soc_dapm_widget_for_each_source_path(right, path)
+			connected |= path->connect;
+		KUNIT_EXPECT_EQ(test, connected, selection < 2);
+	}
+	rtd = snd_soc_get_pcm_runtime(card, link);
+	KUNIT_ASSERT_NOT_NULL(test, rtd);
+	KUNIT_EXPECT_TRUE(test, snd_soc_runtime_ignore_pmdown_time(rtd));
+	params = kunit_kzalloc(test, sizeof(*params), GFP_KERNEL);
+	substream = kunit_kzalloc(test, sizeof(*substream), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, params);
+	KUNIT_ASSERT_NOT_NULL(test, substream);
+	hw_param_interval(params, SNDRV_PCM_HW_PARAM_RATE)->min = 16000;
+	hw_param_interval(params, SNDRV_PCM_HW_PARAM_RATE)->max = 16000;
+	substream->stream = SNDRV_PCM_STREAM_PLAYBACK;
+	for (route = 0; route < 2; route++) {
+		ret = snd_soc_dapm_disable_pin(&card->dapm, route ? "Speaker" : "Headphones");
+		KUNIT_ASSERT_EQ(test, ret, 0);
+		ret = snd_soc_dapm_enable_pin(&card->dapm, route ? "Headphones" : "Speaker");
+		KUNIT_ASSERT_EQ(test, ret, 0);
+		KUNIT_ASSERT_EQ(test, snd_soc_dapm_sync(&card->dapm), 0);
+		/* ASoC runs hw_params before the DAPM stream power-up. */
+		ret = uda1380_pcm_hw_params(substream, params, snd_soc_rtd_to_codec(rtd, 0));
+		KUNIT_ASSERT_EQ(test, ret, 0);
+		snd_soc_dapm_stream_event(rtd, SNDRV_PCM_STREAM_PLAYBACK,
+					  SND_SOC_DAPM_STREAM_START);
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[2], !route);
+		if (!route)
+			KUNIT_EXPECT_TRUE(test, ctx->amp_supply_on);
+		KUNIT_EXPECT_EQ(test, ctx->registers[UDA1380_CLK], (u16)0x0311);
+		KUNIT_EXPECT_EQ(test, ctx->registers[UDA1380_PM], (u16)(route ? 0xa500 : 0x8500));
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 1);
+		KUNIT_EXPECT_TRUE(test, ctx->clock_on);
+		/* Diagnostic cleanup disconnects both endpoints while PCM is open. */
+		KUNIT_ASSERT_EQ(test, snd_soc_dapm_disable_pin(&card->dapm, "Speaker"), 0);
+		KUNIT_ASSERT_EQ(test, snd_soc_dapm_disable_pin(&card->dapm, "Headphones"), 0);
+		KUNIT_ASSERT_EQ(test, snd_soc_dapm_sync(&card->dapm), 0);
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[2], 0);
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 0);
+		KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+		snd_soc_dapm_stream_stop(rtd, SNDRV_PCM_STREAM_PLAYBACK);
+		uda1380_pcm_shutdown(substream, snd_soc_rtd_to_codec(rtd, 0));
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[2], 0);
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 0);
+		KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+	}
+	KUNIT_EXPECT_EQ(test, ctx->unclocked_io, 0U);
+	if (teardown == UDA_TEST_DETACH_ACTIVE) {
+		KUNIT_ASSERT_EQ(test, snd_soc_dapm_enable_pin(&card->dapm, "Speaker"), 0);
+		KUNIT_ASSERT_EQ(test, snd_soc_dapm_sync(&card->dapm), 0);
+		KUNIT_ASSERT_EQ(test, uda1380_pcm_hw_params(substream, params,
+							 snd_soc_rtd_to_codec(rtd, 0)), 0);
+		snd_soc_dapm_stream_event(rtd, SNDRV_PCM_STREAM_PLAYBACK,
+					  SND_SOC_DAPM_STREAM_START);
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[2], 1);
+		KUNIT_EXPECT_TRUE(test, ctx->amp_supply_on);
+	}
+	if (teardown == UDA_TEST_DETACH_PENDING || teardown == UDA_TEST_DETACH_ACTIVE) {
+		/* Driver devres must shut the card down before releasing its supply. */
+		device_release_driver(&amp->dev);
+		KUNIT_EXPECT_NULL(test, snd_soc_lookup_component(&amp->dev, NULL));
+		KUNIT_EXPECT_FALSE(test, ctx->amp_supply_on);
+		KUNIT_EXPECT_EQ(test, ctx->amp_rdev->use_count, 0U);
+		KUNIT_EXPECT_EQ(test, ctx->amp_rdev->open_count, 0U);
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[2], 0);
+		KUNIT_EXPECT_EQ(test, ctx->gpio_values[1], 0);
+		KUNIT_EXPECT_FALSE(test, ctx->clock_on);
+	} else if (teardown == UDA_TEST_CARD_REBIND) {
+		for (int i = 0; i < 2; i++) {
+			snd_soc_unregister_card(card);
+			KUNIT_EXPECT_FALSE(test, ctx->amp_supply_on);
+			KUNIT_EXPECT_EQ(test, ctx->amp_rdev->open_count, 0U);
+			KUNIT_ASSERT_EQ(test, snd_soc_register_card(card), 0);
+			KUNIT_EXPECT_EQ(test, ctx->amp_rdev->open_count, 1U);
+		}
+	}
+}
