-static irqreturn_t pxa25x_udc_vbus_irq(int irq, void *data)
-{
-	struct pxa25x_udc *udc = data;
-	int ret;
-
+static void pxa25x_udc_check_vbus(struct pxa25x_udc *udc)
+{
+	int ret, vbus;
+
+	vbus = gpiod_get_value_cansleep(udc->vbus_gpio);
+	if (vbus < 0 || udc->vbus == vbus)
+		return;
 	disable_irq(udc->usb_irq);
-	udc->vbus = gpiod_get_value_cansleep(udc->vbus_gpio);
+	udc->vbus = vbus;
 	ret = pullup(udc, true);
 	enable_irq(udc->usb_irq);
 
 	if (ret)
 		dev_err_ratelimited(udc->dev,
 				    "failed to apply VBUS state: %d\n", ret);
+}
+
+static irqreturn_t pxa25x_udc_vbus_irq(int irq, void *data)
+{
+	pxa25x_udc_check_vbus(data);
 	return IRQ_HANDLED;
+}
+
+static void pxa25x_udc_vbus_poll(struct work_struct *work)
+{
+	struct pxa25x_udc *udc = container_of(to_delayed_work(work),
+					    struct pxa25x_udc, vbus_work);
+
+	pxa25x_udc_check_vbus(udc);
+	queue_delayed_work(system_freezable_wq, &udc->vbus_work,
+			   msecs_to_jiffies(125));
 }
 
